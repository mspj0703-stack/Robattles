--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local Cooldown = Env.server("CooldownService")

T.describe("CooldownService", function()
	T.it("쿨타임 중 재사용 거부, 끝나면 허용", function()
		local c = Cooldown.new()
		T.expect((c:tryUse("p1", "primary", 0.5, 10)))
		local ok, reason = c:tryUse("p1", "primary", 0.5, 10.4)
		T.expect(not ok and reason == "on_cooldown")
		T.expect((c:tryUse("p1", "primary", 0.5, 10.5)))
	end)
	T.it("남은 시간 계산", function()
		local c = Cooldown.new()
		c:start("p1", "k", 6, 0)
		T.expectEqual(c:remaining("p1", "k", 2), 4)
		T.expectEqual(c:remaining("p1", "k", 7), 0)
	end)
	T.it("키·엔티티별 독립", function()
		local c = Cooldown.new()
		c:start("p1", "a", 5, 0)
		T.expect(c:isReady("p1", "b", 1))
		T.expect(c:isReady("p2", "a", 1))
		T.expect(not c:isReady("p1", "a", 1))
	end)
	T.it("잘못된 duration(NaN/음수) 거부", function()
		local c = Cooldown.new()
		T.expect(not (c:tryUse("p1", "k", 0 / 0, 0)))
		T.expect(not (c:tryUse("p1", "k", -1, 0)))
	end)
	T.it("clearEntity로 초기화", function()
		local c = Cooldown.new()
		c:start("p1", "a", 5, 0)
		c:clearEntity("p1")
		T.expect(c:isReady("p1", "a", 1))
	end)
	T.it("요청 빈도 제한: 초당 30회 초과 시 거부, 1초 뒤 회복", function()
		local c = Cooldown.new()
		for i = 1, 30 do
			T.expect(c:allowRequest("p1", "Attack", 100 + i * 0.01), "허용되어야 함 " .. i)
		end
		T.expect(not c:allowRequest("p1", "Attack", 100.5))
		T.expect(c:allowRequest("p1", "Attack", 101.5))
		T.expect(c:allowRequest("p2", "Attack", 100.5)) -- 다른 플레이어는 영향 없음
	end)
end)
return true
