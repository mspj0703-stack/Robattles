--!nonstrict
local T=require(script.Parent.TestRunner)
local Env=require(script.Parent.Env)
local Flow=Env.server("MatchFlow")
local Scope=Env.server("MatchScope")
local Scoreboard=Env.server("ScoreboardService")
local Config=Env.shared("Config")
local function setup(n)
	local f=Flow.new()
	for i=1,n or 0 do f:register(i,"P"..i);f:select(i,"SWORD",0);f:spawned(i,0) end
	return f
end
local function active()
	local f=setup(2);f:update(0);f:update(5);return f
end
T.describe("MatchFlow confirmed rules",function()
	T.it("12 players, 2 minimum, 420/5/4/2/12/20 seconds",function()
		T.expectEqual(Config.Match.MaxPlayers,12);T.expectEqual(Config.Match.MinPlayers,2)
		T.expectEqual(Config.Match.DurationSeconds,420);T.expectEqual(Config.Match.CountdownSeconds,5)
		T.expectEqual(Config.Match.RespawnSeconds,4);T.expectEqual(Config.Match.RespawnProtectionSeconds,2)
		T.expectEqual(Config.Match.ResultsSeconds,12);T.expectEqual(Config.Match.LowPopulationGraceSeconds,20)
	end)
	T.it("MENU is individual and not a server phase",function()
		local f=setup();f:register(1,"A");f:update(100);T.expectEqual(f.phase,"WAITING");T.expectEqual(f:snapshot(1,100).player.state,"Menu")
	end)
	T.it("one selected ready player waits indefinitely",function() local f=setup(1);f:update(1000);T.expectEqual(f.phase,"WAITING") end)
	T.it("selection without a loaded avatar cannot start countdown",function()
		local f=setup(1);f:register(2,"B");f:select(2,"SWORD",0);f:update(10);T.expectEqual(f.phase,"WAITING")
	end)
	T.it("five-second authoritative countdown",function()
		local f=setup(2);f:update(10);T.expectEqual(f.phase,"COUNTDOWN");T.expectEqual(f:snapshot(1,12).countdown,3)
		f:update(14.99);T.expectEqual(f.phase,"COUNTDOWN");f:update(15);T.expectEqual(f.phase,"ACTIVE");T.expectEqual(f.endsAt,435)
	end)
	T.it("countdown cancels on departure",function()
		local f=setup(2);f:update(0);f:remove(2,2);f:update(2);T.expectEqual(f.phase,"WAITING");T.expectEqual(f.reason,"countdown_cancelled")
	end)
	T.it("countdown cancels when player falls; full countdown restarts",function()
		local f=setup(2);f:update(0);f:death(2,3);f:update(3);T.expectEqual(f.phase,"WAITING")
		f:spawned(2,7);f:update(7);T.expectEqual(f.countdownEndsAt,12)
	end)
	T.it("12 selected cap includes loading slots",function()
		local f=setup();for i=1,13 do f:register(i,"P") end
		for i=1,12 do T.expect(f:select(i,"SWORD",0)) end
		T.expectEqual(select(2,f:select(13,"SWORD",0)),"match_full");T.expect(f:select(1,"PAINTBALL",1))
		f:remove(1,2);T.expect(f:select(13,"SWORD",2))
	end)
	T.it("midmatch loaded selection participates immediately",function()
		local f=active();f:register(3,"C");f:select(3,"SWORD",10);T.expectEqual(f:participantCount(),2)
		f:spawned(3,10);T.expectEqual(f:participantCount(),3);T.expectEqual(f:snapshot(3,10).player.state,"Participating")
	end)
	T.it("dead participants still count toward minimum",function()
		local f=active();f:death(2,10);f:update(100);T.expectEqual(f.phase,"ACTIVE");T.expectEqual(f.lowPopulationEndsAt,nil)
		T.expectEqual(f:snapshot(2,12).player.respawnRemaining,2)
	end)
	T.it("one player starts 20-second grace then cancellation",function()
		local f=active();f:remove(2,10);T.expectEqual(f.lowPopulationEndsAt,30);f:update(29.99);T.expectEqual(f.phase,"ACTIVE")
		f:update(30);T.expectEqual(f.phase,"RESULTS");T.expect(f:snapshot(1,30).cancelled)
	end)
	T.it("zero players also completes grace",function()
		local f=active();f:remove(1,10);f:remove(2,11);f:update(30);T.expectEqual(f.reason,"insufficient_players")
	end)
	T.it("population recovery cancels grace; next shortage gets a new deadline",function()
		local f=active();f:remove(2,10);f:register(3,"C");f:select(3,"SWORD",15);f:spawned(3,15)
		T.expectEqual(f.lowPopulationEndsAt,nil);f:update(31);T.expectEqual(f.phase,"ACTIVE");f:remove(3,32);T.expectEqual(f.lowPopulationEndsAt,52)
	end)
	T.it("round ends exactly at seven minutes",function()
		local f=active();f:update(424.999);T.expectEqual(f.phase,"ACTIVE");f:update(425);T.expectEqual(f.reason,"time_limit");T.expectEqual(f.resultsEndsAt,437)
	end)
	T.it("earliest deadline wins after a delayed tick",function()
		local f=active();f:remove(2,400);f:update(500);T.expectEqual(f.reason,"insufficient_players")
		local g=active();g:remove(2,410);g:update(500);T.expectEqual(g.reason,"time_limit")
	end)
	T.it("damage is disabled at deadline before a Heartbeat transition",function()
		local f=active();T.expect(f:canDamage(1,2,424.99));T.expect(not f:canDamage(1,2,425))
		f:remove(2,10);T.expect(not f:canDamage(1,1,30))
	end)
	T.it("results last full 12 seconds then automatic countdown",function()
		local f=active();f:update(425);f:update(436.99);T.expectEqual(f.phase,"RESULTS")
		f:update(437);T.expectEqual(f.phase,"COUNTDOWN");T.expectEqual(f.countdownEndsAt,442);f:update(442);T.expectEqual(f.matchId,2)
	end)
	T.it("results return to waiting if insufficient players",function()
		local f=active();f:update(425);f:remove(2,430);f:update(437);T.expectEqual(f.phase,"WAITING")
	end)
	T.it("rank 1,1,3 for exact ties; deaths break KO ties",function()
		local b=Scoreboard.new();for i=1,4 do b:register(i,"P"..i) end
		b:onKill(1,4);b:onKill(2,4);b:onKill(3,4);b:onKill(3,3)
		local r=b:snapshot();T.expectEqual(r[1].rank,1);T.expectEqual(r[2].rank,1);T.expectEqual(r[3].rank,3);T.expectEqual(r[4].rank,4)
	end)
	T.it("results are frozen even if returned tables are modified or players leave",function()
		local f=active();f:recordKill({attackerId=1,targetId=2,now=8});f:update(425)
		local r=f:snapshot(1,425);r.results[1].kills=999;r.standings[1].rank=99;f:remove(1,426)
		local next=f:snapshot(2,426);T.expectEqual(next.results[1].kills,1);T.expectEqual(next.results[1].rank,1)
	end)
	T.it("new round resets scores and old result data",function()
		local f=active();f:recordKill({attackerId=1,targetId=2,now=8});f:update(425);f:update(437);f:update(442)
		T.expectEqual(f:standings()[1].kills,0);T.expectEqual(#f.results,0)
	end)
	T.it("rejoining player preserves round score, prevents death reset exploit",function()
		local f=active();f:recordKill({attackerId=1,targetId=2,now=8});f:remove(2,10);f:register(2,"Renamed");f:select(2,"SWORD",12);f:spawned(2,12)
		T.expectEqual(f:snapshot(2,12).player.deaths,1)
	end)
	T.it("practice and results never score; duplicate death is ignored",function()
		local f=setup(2);T.expect(not f:recordKill({attackerId=1,targetId=2,now=1}));f:update(1);f:update(6)
		T.expect(f:recordKill({attackerId=1,targetId=2,now=8}));T.expect(not f:recordKill({attackerId=1,targetId=2,now=8}))
		f:update(426);T.expect(not f:recordKill({attackerId=1,targetId=2,now=427}))
	end)
	T.it("practice actions allowed only after selection and spawn; results rejects all skills",function()
		local f=setup(1);f:register(2,"Menu")
		T.expect(f:canAct(1,"Attack",{}));T.expect(not f:canAct(2,"Skill",{}));T.expect(f:canAct(2,"SelectCharacter",{}))
		f:select(2,"SWORD",0);f:spawned(2,0);f:update(0);f:update(5);f:update(425)
		for _,a in {"Attack","Skill","Ultimate","Dodge","Reload"} do T.expect(not f:canAct(1,a,{})) end
		T.expect(f:canAct(1,"SelectCharacter",{}));T.expect(f:canAct(1,"SetRun",{enabled=false}))
	end)
end)
T.describe("MatchScope stale work",function()
	T.it("old round callback cannot execute after invalidation",function()
		local s=Scope.new();s:join(1);local n=0;local fn=s:guard(s:capture(1),function() n+=1 end);fn();s:invalidate();fn();T.expectEqual(n,1)
	end)
	T.it("reconnect cannot resurrect old connection token",function()
		local s=Scope.new();s:join(1);local token=s:capture(1);s:leave(1);s:join(1);T.expect(not s:valid(token));T.expect(s:valid(s:capture(1)))
	end)
	T.it("one failing cleanup cannot prevent other timers from cancelling",function()
		local s=Scope.new();local n=0;s:track(1,function() error("bad timer") end);s:track(2,function() n+=1 end);s:invalidate()
		T.expectEqual(n,1);T.expectEqual(#s.errors,1);s:invalidate();T.expectEqual(n,1)
	end)
	T.it("leaving cancels only owned work",function()
		local s=Scope.new();s:join(1);s:join(2);local n=0;s:track(1,function() n+=1 end);s:track(2,function() n+=10 end);s:leave(1);T.expectEqual(n,1);s:invalidate();T.expectEqual(n,11)
	end)
end)
return true
