--!nonstrict
-- Phase 2: SLINGSHOT(HP 100) 전체 스킬(서버 로직) 회귀. LMB 충전 샷, RMB Aim Mode(클라이언트 전용), 스킬 1~3, 궁극기 Bullseye, 패시브 Bullseye Mark,
-- 보안·상태 정리. 확정/임시 수치 구분은 Data/Characters.SLINGSHOT 주석과 docs/ASSUMPTIONS.md A79~A80.
-- Roblox 실제 동작(충돌 실측·애니메이션·이동 적용·이펙트 렌더)은 Studio 미검증.
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local H = require(script.Parent.Helpers)
local Core = Env.server("CombatCore")
local ProjectileService = Env.server("ProjectileService")
local Controller = Env.server("CharacterController")
local Movement = Env.server("MovementValidator")
local Characters = Env.shared("Data/Characters")
local Config = Env.shared("Config")
local RemoteSpec = Env.shared("RemoteSpec")
local Vec = Env.shared("Vec")

local v = H.v
local fwd = v(0, 0, 1)
local S = Characters.SLINGSHOT
local floor = { point = v(0, 0, 0), normal = v(0, 1, 0) }

local function setup(ids, opts)
	opts = opts or {}
	local cfg = opts.config or Config
	local core = Core.new(cfg)
	local pos, face = {}, {}
	local world = H.fakeWorld(opts.planes or { floor })
	local function targets()
		local list = {}
		for id in ids do
			table.insert(list, { id = id, pos = pos[id], radius = cfg.Combat.HitRadius, alive = core.damage:isAlive(id) })
		end
		return list
	end
	local ps = ProjectileService.new({ damage = core.damage, targets = targets, world = world, config = cfg })
	local movement
	if opts.movement then
		movement = Movement.new({ config = cfg, world = H.fakeWorld({ floor }) })
	end
	local c = Controller.new({
		config = cfg, core = core, projectiles = ps, targets = targets, world = world, movement = movement,
		getPose = function(id) return { pos = pos[id], forward = face[id], airborne = opts.airborne == true } end,
	})
	local events = {}
	c:onFeedback(function(e) table.insert(events, e) end)
	for id, ch in ids do
		c:addPlayer(id, ch)
		pos[id] = v(0, 1.5, 0)
		face[id] = fwd
		if movement then movement:register(id, v(0, 3.2, 0), 0) end
	end
	return c, core, pos, events, movement
end

local function run(c, from, to, dt)
	local t = from
	dt = dt or 0.05
	while t < to - 1e-9 do
		t = math.min(t + dt, to)
		c:update(t, dt)
	end
end

local function lost(core, id) return core.damage:getMaxHealth(id) - core.damage:getHealth(id) end
local function near(a, b, eps) return math.abs(a - b) < (eps or 1e-6) end
local function prim(dir, phase) return { action = "Primary", aimDirection = dir or fwd, phase = phase } end
local function sec(dir) return { action = "Secondary", aimDirection = dir or fwd } end
local function skill(slot, dir) return { slot = slot, aimDirection = dir or fwd } end
local function fill(core, id) for _ = 1, 5 do core.ultimate:addKill(id) end end
local function ofCue(events, cue)
	local out = {}
	for _, e in events do if e.cue == cue then table.insert(out, e) end end
	return out
end
-- 충전 샷: t 에 Press, t+hold 에 Release. 반환: Release 결과
local function charged(c, id, t, hold, dir)
	c:handleAttack(id, prim(dir, "Press"), t)
	return c:handleAttack(id, prim(dir, "Release"), t + hold)
end

T.describe("SLINGSHOT 구조·확정 수치", function()
	T.it("HP 100, 모듈 연결, 확정 수치", function()
		T.expectEqual(S.maxHealth, 100)
		T.expectEqual(S.module, "Slingshot")
		T.expectEqual(S.primary.minDamage, 12); T.expectEqual(S.primary.maxDamage, 26)
		T.expectEqual(S.primary.chargeSeconds, 1.0); T.expectEqual(S.primary.chargeMoveMult, 0.8)
		T.expectEqual(S.skills[1].damage, 14); T.expectEqual(S.skills[1].shots, 3); T.expectEqual(S.skills[1].cooldown, 8)
		T.expectEqual(S.skills[2].damage, 18); T.expectEqual(S.skills[2].slowSeconds, 1.0); T.expectEqual(S.skills[2].cooldown, 11)
		T.expectEqual(S.skills[3].damage, 16); T.expectEqual(S.skills[3].cooldown, 9)
		T.expectEqual(S.ultimate.damage, 55); T.expectEqual(S.ultimate.preciseDamage, 75); T.expectEqual(S.ultimate.windup, 0.7)
		T.expectEqual(S.passive.hitsToMark, 2); T.expectEqual(S.passive.markSeconds, 5); T.expectEqual(S.passive.bonusDamage, 8)
	end)
	T.it("SelectCharacter 에 SLINGSHOT 포함(GUNNER 는 없음), Attack phase 는 Press/Release 만", function()
		T.expect(RemoteSpec.validate("SelectCharacter", { characterId = "SLINGSHOT" }))
		T.expect(not RemoteSpec.validate("SelectCharacter", { characterId = "GUNNER" }))
		T.expect(RemoteSpec.validate("Attack", { action = "Primary", aimDirection = fwd, aimOrigin = v(0, 0, 0), clientTime = 0, phase = "Release" }))
		T.expect(not RemoteSpec.validate("Attack", { action = "Primary", aimDirection = fwd, aimOrigin = v(0, 0, 0), clientTime = 0, phase = "Hold" }))
	end)
end)

T.describe("SLINGSHOT LMB 충전 샷", function()
	T.it("충전 0 → 12, 0.5s → 19, 1.0s 이상 → 26 (선형), 서버가 충전량을 결정", function()
		for _, case in { { 0, 12 }, { 0.5, 19 }, { 1.0, 26 }, { 3.0, 26 } } do
			local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
			pos.b = v(0, 1.5, 10)
			T.expect((charged(c, "a", 0, case[1])))
			run(c, case[1], case[1] + 1)
			T.expect(near(lost(core, "b"), case[2]), "hold " .. case[1] .. " lost " .. lost(core, "b"))
		end
	end)
	T.it("충전할수록 속도가 빨라진다(60→150)", function()
		local c = setup({ a = "SLINGSHOT" })
		local _, i0 = charged(c, "a", 0, 0)
		local _, i1 = charged(c, "a", 5, 1.0)
		T.expect(near(i0.speed, 60) and near(i1.speed, 150))
	end)
	T.it("충전 중 이동속도 80%, 발사 후 복구, 공중(점프)에서도 충전·발사 가능", function()
		local c = setup({ a = "SLINGSHOT" }, { airborne = true })
		local base = c:getMoveSpeed("a", 0)
		T.expect((c:handleAttack("a", prim(nil, "Press"), 0)))
		T.expect(near(c:getMoveSpeed("a", 0.5), base * 0.8))
		T.expect((c:handleAttack("a", prim(nil, "Release"), 1.0)))
		T.expect(near(c:getMoveSpeed("a", 1.1), base))
	end)
	T.it("Release 없이 Press 만: 발사·피해 없음, 중복 Press 거부, Press 없는 Release 거부", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		T.expect(not (c:handleAttack("a", prim(nil, "Release"), 0)))
		T.expect((c:handleAttack("a", prim(nil, "Press"), 0.1)))
		local ok, why = c:handleAttack("a", prim(nil, "Press"), 0.2)
		T.expect(not ok and why == "already_charging")
		run(c, 0.2, 3)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("늦은 Release(5초 초과)는 거부, 쿨타임 소모 없음, 충전 해제", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		c:handleAttack("a", prim(nil, "Press"), 0)
		local ok, why = c:handleAttack("a", prim(nil, "Release"), 6)
		T.expect(not ok and why == "charge_expired")
		T.expect(core.cooldown:isReady("a", "primary", 6))
		T.expect(near(c:getMoveSpeed("a", 6.1), c:getMoveSpeed("a", 100)))
		T.expect(not (c:handleAttack("a", prim(nil, "Release"), 6.2))) -- 중복 Release
	end)
	T.it("발사 간격 0.5s: 연사 거부", function()
		local c = setup({ a = "SLINGSHOT" })
		T.expect((c:handleAttack("a", prim(), 0)))
		for i = 1, 4 do T.expect(not (c:handleAttack("a", prim(), 0.1 * i))) end
		T.expect((c:handleAttack("a", prim(), 0.5)))
	end)
	T.it("중복 Release: 한 번의 충전은 한 발만", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		c:handleAttack("a", prim(nil, "Press"), 0)
		T.expect((c:handleAttack("a", prim(nil, "Release"), 1)))
		for i = 1, 5 do T.expect(not (c:handleAttack("a", prim(nil, "Release"), 1 + 0.01 * i))) end
		run(c, 1, 2)
		T.expect(near(lost(core, "b"), 26))
	end)
	T.it("벽 충돌: 벽 뒤 적은 맞지 않는다", function()
		local wall = { point = v(0, 0, 5), normal = v(0, 0, -1) }
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" }, { planes = { floor, wall } })
		pos.b = v(0, 1.5, 10)
		charged(c, "a", 0, 1)
		run(c, 1, 3)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("사망 중 충전: 충전·감속 정리, 부활 후 Release 거부", function()
		local c = setup({ a = "SLINGSHOT" })
		c:handleAttack("a", prim(nil, "Press"), 0)
		c:handleDeath("a", 0.5)
		c:respawn("a", 4.5)
		T.expect(not (c:handleAttack("a", prim(nil, "Release"), 5)))
		T.expect(near(c:getMoveSpeed("a", 5), c:getMoveSpeed("a", 100)))
	end)
	T.it("부활 보호: Press/거부는 유지, 발사 성공 시 해제", function()
		local c = setup({ a = "SLINGSHOT" })
		c:respawn("a", 0)
		c:handleAttack("a", prim(nil, "Press"), 0.1)
		T.expect(c:isProtected("a", 0.2))
		c:handleAttack("a", prim(nil, "Press"), 0.3) -- 중복 거부
		T.expect(c:isProtected("a", 0.4))
		c:handleAttack("a", prim(nil, "Release"), 0.5)
		T.expect(not c:isProtected("a", 0.6))
	end)
	T.it("자기 자신은 맞지 않는다", function()
		local c, core = setup({ a = "SLINGSHOT" })
		charged(c, "a", 0, 1, v(0, 1, 0))
		run(c, 1, 5)
		T.expectEqual(lost(core, "a"), 0)
	end)
end)

T.describe("SLINGSHOT RMB Aim Mode", function()
	T.it("서버는 상태·쿨타임·보호를 건드리지 않는다(클라이언트 표시 전용, 에임 보조 없음)", function()
		local c, core = setup({ a = "SLINGSHOT" })
		c:respawn("a", 0)
		T.expect(not (c:handleAttack("a", sec(), 0.1)))
		T.expect(c:isProtected("a", 0.2))
		T.expect(core.cooldown:isReady("a", "primary", 0.2))
		T.expectEqual(S.secondary.noAimAssist, true)
		T.expectEqual(S.secondary.clientOnly, true)
	end)
end)

T.describe("SLINGSHOT 스킬 1 Triple Shot", function()
	T.it("한 대상에 3발 × 14 = 42, 쿨타임 8s", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		T.expect((c:handleSkill("a", skill(1), 0)))
		run(c, 0, 1.5)
		T.expect(near(lost(core, "b"), 42))
		T.expect(not (c:handleSkill("a", skill(1), 5)))
		T.expect((c:handleSkill("a", skill(1), 8)))
	end)
	T.it("발사체가 독립적으로 3개 생성된다", function()
		local c, _, _, events = setup({ a = "SLINGSHOT" })
		c:handleSkill("a", skill(1), 0)
		local ev = ofCue(events, "sling.triple")
		T.expectEqual(#ev, 1)
		T.expectEqual(#ev[1].projectileIds, 3)
	end)
	T.it("거부된 요청은 쿨타임을 다시 소모하지 않는다 / 성공 시 보호 해제", function()
		local c, core = setup({ a = "SLINGSHOT" })
		c:respawn("a", 0)
		c:handleSkill("a", skill(1), 0.1)
		T.expect(not c:isProtected("a", 0.2))
		c:handleSkill("a", skill(1), 0.3)
		T.expect(near(core.cooldown:remaining("a", "skill1", 0.3), 7.8))
	end)
end)

T.describe("SLINGSHOT 스킬 2 Snare Shot", function()
	T.it("피해 18 + 1초 감속(0.5), 이후 해제, 위치 표시 이벤트", function()
		local c, core, pos, events = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		T.expect((c:handleSkill("a", skill(2), 0)))
		run(c, 0, 0.5)
		T.expect(near(lost(core, "b"), 18))
		T.expect(near(core.status:getSpeedMultiplier("b", 0.5), 0.5))
		T.expect(near(core.status:getSpeedMultiplier("b", 1.7), 1))
		local m = ofCue(events, "sling.snare.mark")
		T.expectEqual(#m, 1)
		T.expectEqual(m[1].targetId, "b")
		T.expect(m[1].pos ~= nil)
	end)
	T.it("빗나가면 감속·표시 없음, 쿨타임 11s", function()
		local c, core, pos, events = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(30, 1.5, 10)
		c:handleSkill("a", skill(2), 0)
		run(c, 0, 2)
		T.expectEqual(lost(core, "b"), 0)
		T.expectEqual(#ofCue(events, "sling.snare.mark"), 0)
		T.expect(not (c:handleSkill("a", skill(2), 10)))
		T.expect((c:handleSkill("a", skill(2), 11)))
	end)
end)

T.describe("SLINGSHOT 스킬 3 Backstep Shot", function()
	T.it("후방 이동(이동 허가) + 16 피해, 쿨타임 9s", function()
		local c, core, pos, events = setup({ a = "SLINGSHOT", b = "SWORD" }, { movement = true })
		pos.b = v(0, 1.5, 10)
		T.expect((c:handleSkill("a", skill(3), 0)))
		local e = ofCue(events, "sling.backstep")[1]
		T.expect(e ~= nil and e.dash ~= nil and e.dash.permit == "Backstep")
		T.expect(near(e.direction.Z, -1) and e.distance > 9)
		run(c, 0, 1.5)
		T.expect(near(lost(core, "b"), 16))
		T.expect(not (c:handleSkill("a", skill(3), 5)))
	end)
	T.it("뒤가 벽이면 거부: 사격·쿨타임·보호 불변", function()
		local wall = { point = v(0, 0, -2), normal = v(0, 0, 1) }
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" }, { planes = { floor, wall }, movement = true })
		pos.b = v(0, 1.5, 10)
		c:respawn("a", 0)
		local ok, why = c:handleSkill("a", skill(3), 0.1)
		T.expect(not ok and why == "blocked")
		T.expect(core.cooldown:isReady("a", "skill3", 0.1))
		T.expect(c:isProtected("a", 0.2))
		run(c, 0.1, 2)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("이동 허가 거부(간격 위반)면 사격 없음·쿨타임 없음·보호 유지", function()
		local c, core, pos, _, movement = setup({ a = "SLINGSHOT", b = "SWORD" }, { movement = true })
		pos.b = v(0, 1.5, 10)
		c:respawn("a", 0)
		T.expect((movement:issue("a", "Backstep", 0.05, { speed = 20, duration = 0.25, dir = v(0, 0, -1) })))
		local ok, why = c:handleSkill("a", skill(3), 0.1)
		T.expect(not ok and string.find(why, "movement_denied", 1, true) ~= nil)
		T.expect(core.cooldown:isReady("a", "skill3", 0.1))
		T.expect(c:isProtected("a", 0.2))
		run(c, 0.1, 2)
		T.expectEqual(lost(core, "b"), 0)
	end)
end)

T.describe("SLINGSHOT 궁극기 Bullseye", function()
	local function ult(dir, planes, targetPos)
		local c, core, pos, events = setup({ a = "SLINGSHOT", b = "SWORD" }, { planes = planes })
		pos.b = targetPos or v(0, 1.5, 40)
		fill(core, "a")
		local ok = c:handleUltimate("a", { aimDirection = dir or fwd }, 0)
		return c, core, pos, events, ok
	end
	T.it("조준 0.7s 후 발사: 그 전엔 피해 없음", function()
		local c, core, _, events, ok = ult()
		T.expect(ok)
		run(c, 0, 0.65)
		T.expectEqual(lost(core, "b"), 0)
		T.expectEqual(#ofCue(events, "sling.ult.fire"), 0)
		run(c, 0.65, 1.2)
		T.expectEqual(#ofCue(events, "sling.ult.fire"), 1)
		T.expect(lost(core, "b") > 0)
	end)
	T.it("일반 명중 55 / 정밀 명중 75(표준 몸통 중심의 작은 판정)", function()
		local c, core = ult(fwd)
		run(c, 0, 1.2)
		T.expect(near(lost(core, "b"), 55)) -- 눈높이 직선: 몸통 중심에서 1.5 떨어짐 → 일반
		local c2, core2 = ult(Vec.normalize(v(0, 1.5 - 3, 40)))
		run(c2, 0, 1.2)
		T.expect(near(lost(core2, "b"), 75))
	end)
	T.it("정밀 판정 반경은 설정값(preciseRadius)으로 조정된다", function()
		local u = Characters.SLINGSHOT.ultimate
		local old = u.preciseRadius
		u.preciseRadius = 2.0
		local c, core = ult(fwd)
		run(c, 0, 1.2)
		u.preciseRadius = old
		T.expect(near(lost(core, "b"), 75))
	end)
	T.it("조준 방향 갱신(Aim)이 반영된다 / 에임 보조 없음", function()
		local c, core = ult(v(1, 0, 0))
		run(c, 0, 0.3)
		c:handleAim("a", { aimDirection = fwd }, 0.3)
		run(c, 0.3, 1.2)
		T.expect(lost(core, "b") > 0)
		local c2, core2 = ult(Vec.normalize(v(0.2, 0, 1))) -- 40 studs 에서 8 벗어남: 보정 없이 빗나감
		run(c2, 0, 1.2)
		T.expectEqual(lost(core2, "b"), 0)
	end)
	T.it("고속탄은 터널링하지 않는다: 먼 거리 명중 & 벽 뒤 차단", function()
		local c, core = ult(fwd, nil, v(0, 1.5, 250))
		run(c, 0, 2)
		T.expect(lost(core, "b") > 0)
		local wall = { point = v(0, 0, 20), normal = v(0, 0, -1) }
		local c2, core2 = ult(fwd, { floor, wall })
		run(c2, 0, 2)
		T.expectEqual(lost(core2, "b"), 0)
	end)
	T.it("조준 중 LMB·스킬 거부 (쿨타임 불변)", function()
		local c, core = ult()
		T.expect(not (c:handleAttack("a", prim(), 0.3)))
		T.expect(not (c:handleSkill("a", skill(1), 0.3)))
		T.expect(core.cooldown:isReady("a", "skill1", 0.3))
	end)
	T.it("조준 중 사망하면 발사되지 않는다", function()
		local c, core = ult()
		run(c, 0, 0.3)
		c:handleDeath("a", 0.3)
		run(c, 0.3, 2)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("게이지 없이는 거부, 사용 중 재사용 거부", function()
		local c, core = setup({ a = "SLINGSHOT" })
		T.expect(not (c:handleUltimate("a", { aimDirection = fwd }, 0)))
		fill(core, "a")
		T.expect((c:handleUltimate("a", { aimDirection = fwd }, 0)))
		T.expect(not (c:handleUltimate("a", { aimDirection = fwd }, 0.1)))
	end)
end)

T.describe("SLINGSHOT 패시브 Bullseye Mark", function()
	local function hit(c, t, dir) c:handleAttack("a", prim(dir), t) end
	T.it("LMB 2회 명중 → 표식, 다음 샷에 +8, 표식 소모", function()
		local c, core, pos, events = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		hit(c, 0); run(c, 0, 1)
		hit(c, 1); run(c, 1, 2)
		T.expectEqual(#ofCue(events, "sling.mark"), 1)
		local before = lost(core, "b")
		hit(c, 2); run(c, 2, 3)
		T.expect(near(lost(core, "b") - before, 20))
		T.expectEqual(#ofCue(events, "sling.mark.proc"), 1)
		local mid = lost(core, "b")
		hit(c, 3); run(c, 3, 4)
		T.expect(near(lost(core, "b") - mid, 12)) -- 표식 소모 후 보너스 없음
	end)
	T.it("빗나가면 표식 유지, 5초 후 만료", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		hit(c, 0); run(c, 0, 1); hit(c, 1); run(c, 1, 2)
		pos.b = v(40, 1.5, 10)
		hit(c, 2); run(c, 2, 3) -- 빗나감
		pos.b = v(0, 1.5, 10)
		local before = lost(core, "b")
		hit(c, 3); run(c, 3, 4)
		T.expect(near(lost(core, "b") - before, 20))
		local c2, core2, pos2 = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos2.b = v(0, 1.5, 10)
		hit(c2, 0); run(c2, 0, 1); hit(c2, 1); run(c2, 1, 7.5)
		local b2 = lost(core2, "b")
		hit(c2, 7.5); run(c2, 7.5, 8.5)
		T.expect(near(lost(core2, "b") - b2, 12))
	end)
	T.it("다른 대상을 맞혀도 기존 표식은 소모되지 않는다", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD", d = "SWORD" })
		pos.b = v(0, 1.5, 10); pos.d = v(10, 1.5, 0)
		hit(c, 0); run(c, 0, 1); hit(c, 1); run(c, 1, 2) -- b 표식
		hit(c, 2, v(1, 0, 0)); run(c, 2, 3) -- d 를 한 번 맞힘
		T.expect(near(lost(core, "d"), 12))
		local before = lost(core, "b")
		hit(c, 3); run(c, 3, 4)
		T.expect(near(lost(core, "b") - before, 20)) -- b 의 표식은 그대로
	end)
	T.it("스킬 샷은 LMB 카운트에 포함되지 않는다", function()
		local c, _, pos, events = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		c:handleSkill("a", skill(1), 0); run(c, 0, 1.5)
		T.expectEqual(#ofCue(events, "sling.mark"), 0)
	end)
	T.it("소유자 사망/부활 시 표식과 카운트 정리", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		hit(c, 0); run(c, 0, 1); hit(c, 1); run(c, 1, 2)
		c:handleDeath("a", 2); c:respawn("a", 6)
		local before = lost(core, "b")
		hit(c, 7); run(c, 7, 8)
		T.expect(near(lost(core, "b") - before, 12))
	end)
	T.it("대상이 나가면(removePlayer) 표식 정리", function()
		local c, _, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		hit(c, 0); run(c, 0, 1); hit(c, 1); run(c, 1, 2)
		T.expect(c._impl.SLINGSHOT._marks.a.b ~= nil)
		c:removePlayer("b", 2)
		T.expect(c._impl.SLINGSHOT._marks.a.b == nil)
	end)
	T.it("대상이 죽으면 표식 정리", function()
		local c, core, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		hit(c, 0); run(c, 0, 1); hit(c, 1); run(c, 1, 2)
		core.damage:applyDamage({ attackerId = "a", targetId = "b", attackId = "kill", amount = 9999, kind = "Projectile" }, 2.1)
		T.expect(c._impl.SLINGSHOT._marks.a.b == nil)
	end)
	T.it("캐릭터를 바꿔 부활하면 표식이 남지 않는다", function()
		local c, _, pos = setup({ a = "SLINGSHOT", b = "SWORD" })
		pos.b = v(0, 1.5, 10)
		hit(c, 0); run(c, 0, 1); hit(c, 1); run(c, 1, 2)
		c:selectCharacter("a", "SWORD")
		c:handleDeath("a", 2); c:respawn("a", 6)
		T.expect(c._impl.SLINGSHOT._marks.a == nil)
	end)
end)

T.describe("SLINGSHOT 클라이언트 로직(입력·궤적·큐)", function()
	local InputState = Env.client("Logic/InputState")
	local AimModel = Env.client("Logic/AimModel")
	local EffectsModel = Env.client("Logic/EffectsModel")
	local Crosshairs = Env.client("Logic/Crosshairs")
	T.it("RMB 는 서버로 보내지 않고 로컬 Aim Mode 만 켜고 끈다(달리기 유지)", function()
		local input = InputState.new()
		input:setCharacter("SLINGSHOT", false, false, true, true)
		input.running = true
		local cmds = input:press("MouseButton2", 0)
		T.expectEqual(#cmds, 1)
		T.expectEqual(cmds[1].localEffect, "AimMode"); T.expectEqual(cmds[1].active, true)
		T.expect(input.running)
		local rel = input:release("MouseButton2")
		T.expectEqual(rel[1].localEffect, "AimMode"); T.expectEqual(rel[1].active, false)
	end)
	T.it("LMB 는 Press/Release 로 전송, 창 포커스 상실 시 Release + Aim 해제", function()
		local input = InputState.new()
		input:setCharacter("SLINGSHOT", false, false, true, true)
		local p = input:press("MouseButton1", 0)
		T.expectEqual(p[1].phase, "Press")
		input:press("MouseButton2", 0.1)
		local all = input:releaseAll()
		local sawRelease, sawAimOff = false, false
		for _, c in all do
			if c.remote == "Attack" and c.phase == "Release" then sawRelease = true end
			if c.localEffect == "AimMode" and c.active == false then sawAimOff = true end
		end
		T.expect(sawRelease and sawAimOff)
	end)
	T.it("다른 캐릭터로 바뀌면 Aim 상태 해제, 다른 캐릭터의 RMB 는 서버로 간다", function()
		local input = InputState.new()
		input:setCharacter("SLINGSHOT", false, false, true, true)
		input:press("MouseButton2", 0)
		input:setCharacter("SWORD", false, false, false, false)
		T.expect(not input.aimHeld)
		local cmds = input:press("MouseButton2", 1)
		T.expectEqual(cmds[1].remote, "Attack"); T.expectEqual(cmds[1].action, "Secondary")
	end)
	T.it("궤적: 서버와 같은 포물선(등속+중력), 충전할수록 멀리", function()
		local p0 = AimModel.shotParams(S.primary, 0)
		local p1 = AimModel.shotParams(S.primary, 1)
		T.expect(near(p0.speed, 60) and near(p1.speed, 150) and near(p1.lifetime, 1.8))
		local tr = AimModel.trajectory(v(0, 3, 0), fwd, 60, 22, 0.9, 9)
		T.expectEqual(#tr.points, 10)
		local last = tr.points[10]
		T.expect(near(last.Z, 54) and near(last.Y, 3 - 0.5 * 22 * 0.81, 1e-6))
		T.expect(AimModel.trajectory(v(0, 3, 0), v(0, 0, 0), 60, 22, 1, 5).hit == nil)
	end)
	T.it("궤적은 벽에서 끊긴다", function()
		local world = H.fakeWorld({ { point = v(0, 0, 10), normal = v(0, 0, -1) } })
		local tr = AimModel.trajectory(v(0, 3, 0), fwd, 100, 0, 1, 20, world, 0)
		T.expect(tr.hit ~= nil and near(tr.hit.Z, 10, 1e-6))
	end)
	T.it("서버 탄 정의 id → SLINGSHOT 연출 큐, CharSkill 큐 변환, 조준선 등록", function()
		local cues = EffectsModel.translate({
			type = "Spawned", projectileType = "Arc", defId = "sling_Lmb", pos = v(0, 3, 0), dir = fwd, projectileId = "pj1", ownerId = "a", speed = 60,
		}, "a")
		T.expectEqual(cues[1].cue, "sling.fire"); T.expectEqual(cues[2].cue, "sling.projectile")
		local m = EffectsModel.translate({ type = "CharSkill", cue = "sling.mark", playerId = "a", targetId = "b" }, "a")
		T.expectEqual(m[1].cue, "sling.mark")
		T.expectEqual(Crosshairs.get("SLINGSHOT").style, "Dot")
	end)
end)

T.describe("SLINGSHOT 다인·노출", function()
	T.it("두 SLINGSHOT 의 충전은 독립", function()
		local c = setup({ a = "SLINGSHOT", b = "SLINGSHOT" })
		c:handleAttack("a", prim(nil, "Press"), 0)
		T.expect(not (c:handleAttack("b", prim(nil, "Release"), 0.5)))
		T.expect((c:handleAttack("a", prim(nil, "Release"), 1)))
	end)
	T.it("HUD 스냅샷: 충전 중 chargeFrac 제공", function()
		local c = setup({ a = "SLINGSHOT" })
		c:handleAttack("a", prim(nil, "Press"), 0)
		local hud = c:getHudSnapshot("a", 0.5)
		T.expect(hud ~= nil)
	end)
	T.it("12명 동시 충전·발사에서도 오류 없이 처리된다", function()
		local ids = {}
		for i = 1, 12 do ids["p" .. i] = "SLINGSHOT" end
		local c, _, pos = setup(ids)
		local n = 0
		for id in ids do
			n += 1
			pos[id] = v(n * 6, 1.5, 0)
			c:handleAttack(id, prim(nil, "Press"), 0)
		end
		for id in ids do c:handleAttack(id, prim(nil, "Release"), 1) end
		for id in ids do c:handleSkill(id, skill(1), 1.1) end
		run(c, 1.1, 4)
		T.expect(true)
	end)
end)

return true
