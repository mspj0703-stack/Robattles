end)

-- ── 보안·보호·상태 정리·동시 사용 ─────────────────────────────
T.describe("PAINTBALL 보안·상태 정리", function()
	local function router(c, core, pos)
		local gate = Gate.new({
			cooldown = core.cooldown,
			getState = function(id) return { alive = core.damage:isAlive(id), pos = pos[id], serverTime = 0, character = Characters.PAINTBALL } end,
		})
		return Router.new({ gate = gate, controller = c })
	end
	T.it("RemoteSpec: Aim 리모트는 단위 방향·원점·시각만, 피해/대상 필드는 허용되지 않는다", function()
		local base = { aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 1), clientTime = 0 }
		T.expect(RemoteSpec.validate("Aim", base))
		T.expect(not RemoteSpec.validate("Aim", { aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 5), clientTime = 0 }))
		T.expect(not RemoteSpec.validate("Aim", { aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 1) }))
		base.damage = 5
		T.expect(not RemoteSpec.validate("Aim", base))
	end)
	T.it("SelectCharacter 로 PAINTBALL 선택 가능(스키마 통과)", function()
		T.expect(RemoteSpec.validate("SelectCharacter", { characterId = "PAINTBALL" }))
		T.expect(not RemoteSpec.validate("SelectCharacter", { characterId = "NOBODY" }))
	end)
	T.it("라우터 경유: 스킬 1 정상 처리, 같은 요청 반복은 쿨타임 거부, 위조 시각은 게이트 거부", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" })
		pos.b = v(0, 0, 10)
		local r = router(c, core, pos)
		local payload = { slot = 1, aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 1), clientTime = 0 }
		T.expect((r:dispatch("a", "Skill", payload, 0)))
		local ok, why = r:dispatch("a", "Skill", payload, 0.2)
		T.expect(not ok and why == "on_cooldown")
		local ok2, why2 = r:dispatch("a", "Skill", { slot = 2, aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 1), clientTime = 99 }, 0)
		T.expect(not ok2 and why2 == "time_skew")
		T.expect(core.cooldown:isReady("a", "skill2", 0))
	end)
	T.it("라우터 경유: Aim 은 시전 중이 아니면 no_aim_use/거부, 죽은 뒤에는 게이트가 거부", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" })
		local r = router(c, core, pos)
		local aim = { aimOrigin = v(0, 0, 0), aimDirection = v(1, 0, 0), clientTime = 0 }
		local ok = r:dispatch("a", "Aim", aim, 0)
		T.expect(not ok)
		core.damage:applyDamage({ attackerId = "b", targetId = "a", attackId = "k", amount = 300 }, 0.1)
		local ok2, why2 = r:dispatch("a", "Aim", aim, 0.2)
		T.expect(not ok2 and why2 == "dead")
	end)
	T.it("PAINTBALL 스킬에는 충전/해제가 없다: 위조 Release 는 거부되고 아무 상태도 바꾸지 않는다", function()
		local c, core = setup({ a = "PAINTBALL" })
		for slot = 1, 3 do
			local ok, why = c:handleSkill("a", { slot = slot, aimDirection = fwd, phase = "Release" }, 0)
			T.expect(not ok and why == "not_charging")
			T.expect(core.cooldown:isReady("a", "skill" .. slot, 0))
		end
	end)
	T.it("사망 상태·기절 상태에서는 모든 행동 거부, 쿨타임·탄약 불변", function()
		local c, core = setup({ a = "PAINTBALL", b = "SWORD" })
		core.status:apply("a", { type = "Stun", duration = 1 }, 0, { strong = true })
		T.expect(not (c:handleAttack("a", prim(), 0.1)))
		T.expect(not (c:handleAttack("a", sec(), 0.1)))
		for s = 1, 3 do T.expect(not (c:handleSkill("a", skill(s), 0.1))) end
		T.expectEqual(ammo(c, "a"), 16)
		T.expect(core.cooldown:isReady("a", "skill1", 0.1))
		core.damage:applyDamage({ attackerId = "b", targetId = "a", attackId = "k", amount = 300 }, 2)
		T.expect(select(2, c:handleSkill("a", skill(1), 2.1)) == "dead")
		T.expect(select(2, c:handleUltimate("a", {}, 2.1)) == "dead")
	end)
	T.it("캐릭터 변경·부활 시 슬라이드/궁극기/패시브 잠금/탄약이 초기화된다", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD", k = "SWORD" })
		pos.b, pos.k = v(0, 0, 12), v(500, 0, 0)
		c:handleAttack("a", sec(), 0)
		run(c, 0, 0.5)
		T.expect(c._impl.PAINTBALL._lock.a ~= nil)
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 1)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 300 }, 1.2)
		c:respawn("a", 5)
		T.expect(c._impl.PAINTBALL._lock.a == nil and c._impl.PAINTBALL._ult.a == nil)
		T.expectEqual(ammo(c, "a"), 16)
		T.expect(core.cooldown:isReady("a", "secondary", 5))
	end)
	T.it("퇴장 시 모듈 상태 정리(빔 중 퇴장해도 남는 틱 없음)", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" })
		pos.b = v(0, 0, 20)
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0)
		c:removePlayer("a", 0.5)
		T.expect(c._impl.PAINTBALL._ult.a == nil)
		run(c, 0.5, 4)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("12명이 동시에 Burst·Bomb·Slide: 오류 없이 처리, 투사체 총량은 상한 이내, 결과는 결정적(두 번 실행해 동일)", function()
		local function runOnce()
			local ids = {}
			for i = 1, 12 do ids["p" .. i] = "PAINTBALL" end
			local c, core, pos, _, _, ps = setup(ids, { movement = true })
			for i = 1, 12 do
				local a = (i / 12) * math.pi * 2
				pos["p" .. i] = v(math.cos(a) * 15, 0, math.sin(a) * 15)
			end
			for i = 1, 12 do
				local id = "p" .. i
				local l = math.sqrt(pos[id].X ^ 2 + pos[id].Z ^ 2)
				local d = v(-pos[id].X / l, 0, -pos[id].Z / l)
				T.expect((c:handleAttack(id, { action = "Secondary", aimDirection = d }, 0)))
				T.expect((c:handleSkill(id, { slot = 1, aimDirection = d }, 0)))
				c:handleSkill(id, { slot = 3, aimDirection = d }, 0)
			end
			T.expect(ps:getActiveCount() <= Config.Projectile.MaxActiveTotal)
			run(c, 0, 3)
			T.expectEqual(ps:getActiveCount(), 0)
			local out = {}
			for i = 1, 12 do
				local id = "p" .. i
				T.expect(lost(core, id) > 0, id .. " 피해 없음") -- 맞은편 플레이어의 사격이 닿는다
				table.insert(out, string.format("%.1f", core.damage:getHealth(id)))
			end
			return table.concat(out, ",")
		end
		T.expectEqual(runOnce(), runOnce())
	end)
	T.it("HUD 스냅샷: 스킬 3칸·궁극기·패시브·탄약·보조 쿨타임이 구현됨으로 표시", function()
		local c, core = setup({ a = "PAINTBALL" })
		c:handleSkill("a", skill(1), 0)
		c:handleAttack("a", sec(), 0)
		local s = c:getHudSnapshot("a", 0.5)
		for i = 1, 3 do T.expect(s.skills[i].implemented == true and type(s.skills[i].name) == "string") end
		T.expect(s.skills[1].readyAt > 0.5 and s.skills[1].total == 9)
		T.expect(s.skills[2].total == 12 and s.skills[3].total == 7)
		T.expect(s.ultimate.implemented == true and s.ultimate.name == "Color Break")
		T.expect(s.passive.id == "ColorReload")
		T.expectEqual(s.ammo.mag, 16)
		T.expectEqual(s.ammo.cur, 13)
		T.expectEqual(s.cooldowns.secondary.total, 1)
		T.expectEqual(s.health.max, 95)
	end)
end)

-- ── 클라이언트 순수 로직(입력·이동·연출·HUD) — 실제 렌더/입력은 Studio 미검증 ─────────────
T.describe("PAINTBALL 클라이언트 순수 로직", function()
	T.it("자동 연사: LMB 를 누르고 있는 동안 간격마다 Attack 요청, 떼면 중단, 비자동 캐릭터는 없음", function()
		local i = InputState.new()
		i:setCharacter("PAINTBALL", true, true)
		T.expect(i:autoFire(0, 1 / 3) == nil) -- 누르지 않음
		local first = i:press("MouseButton1", 0)[1]
		T.expect(first.remote == "Attack" and first.action == "Primary")
		T.expect(i:autoFire(0.1, 1 / 3) == nil) -- 간격 전
		local nextCmd = i:autoFire(0.34, 1 / 3)
		T.expect(nextCmd ~= nil and nextCmd.remote == "Attack" and nextCmd.action == "Primary")
		T.expect(i:autoFire(0.5, 1 / 3) == nil)
		i:release("MouseButton1")
		T.expect(i:autoFire(1, 1 / 3) == nil)
		local j = InputState.new()
		j:setCharacter("SWORD", false, false)
		j:press("MouseButton1", 0)
		T.expect(j:autoFire(5, 0.1) == nil)
	end)
	T.it("자동 연사는 설정창이 열려 있으면 멈춘다", function()
		local i = InputState.new()
		i:setCharacter("PAINTBALL", true, true)
		i:press("MouseButton1", 0)
		i:setUiBlocking(true)
		T.expect(i:autoFire(1, 0.1) == nil)
	end)
	T.it("Aim 전송 시점: 시전 중에만 주기마다, 끝나면 타이머 초기화", function()
		local i = InputState.new()
		T.expect(not i:aimDue(0, false, 1 / 15))
		T.expect(i:aimDue(1, true, 1 / 15))
		T.expect(not i:aimDue(1.03, true, 1 / 15))
		T.expect(i:aimDue(1.08, true, 1 / 15))
		T.expect(not i:aimDue(1.2, false, 1 / 15))
		T.expect(i:aimDue(1.21, true, 1 / 15))
	end)
	T.it("Aim 페이로드는 서버 스키마를 통과한다", function()
		T.expect(RemoteSpec.validate("Aim", { aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 1), clientTime = 1 }))
	end)
	T.it("Paint Slide 이벤트(CharSkill + dash)는 이동으로 수용, 남의 이벤트·오래된 이벤트·중복은 거부", function()
		local ev = { type = "CharSkill", cue = "paint.slide", playerId = 5, direction = v(0, 0, 1), dash = { speed = 30, duration = 0.4 }, time = 10 }
		T.expect(MovementModel.acceptDashEvent(ev, 5, 10.2, nil, 1))
		T.expect(not MovementModel.acceptDashEvent(ev, 6, 10.2, nil, 1))
		T.expect(not MovementModel.acceptDashEvent(ev, 5, 12, nil, 1))
		T.expect(not MovementModel.acceptDashEvent(ev, 5, 10.2, 10, 1))
		local vel = MovementModel.dashVelocity(10, ev.direction, ev.dash.speed, ev.dash.duration, 10.1)
		T.expect(vel ~= nil and math.abs(vel.Z - 30) < 1e-9)
		T.expect(MovementModel.dashVelocity(10, ev.direction, 30, 0.4, 10.5) == nil)
		-- 허가 상한(PaintSlide 45)을 넘는 속도는 상한으로 제한
		local capped = MovementModel.dashVelocity(10, ev.direction, 500, 0.4, 10.1, nil, "PaintSlide")
		T.expect(math.abs(capped.Z - Config.MoveCheck.Permits.PaintSlide.maxSpeed) < 1e-9)
		T.expect(P.skills[3].permit == "PaintSlide")
	end)
	T.it("서버 CharSkill 이벤트 → 카탈로그에 있는 큐만 재생, 모르는 큐는 무시", function()
		local r = EffectsModel.translate({ type = "CharSkill", cue = "paint.ult.beam", playerId = 1, origin = v(0, 1, 0), tip = v(0, 1, 50) }, 1)
		T.expectEqual(#r, 1)
		T.expect(r[1].cue == "paint.ult.beam" and r[1].tip.Z == 50 and r[1].mine == true)
		T.expectEqual(#EffectsModel.translate({ type = "CharSkill", cue = "no.such.cue", playerId = 1 }, 1), 0)
		T.expectEqual(#EffectsModel.translate({ type = "CharSkill", cue = 5 }, 1), 0)
	end)
	T.it("Color Bomb(Arc)·Piercing(Pierce) 투사체와 폭발 이벤트 → 전용 큐, 포물선 위치는 서버와 같은 중력식", function()
		local arc = { type = "Spawned", projectileType = "Arc", defId = "color_bomb", ownerId = 1, projectileId = "pj9", pos = v(0, 10, 0), dir = v(0, 0, 1), speed = 80, gravity = 40, radius = 0.5, lifetime = 3, time = 100 }
		local r = EffectsModel.translate(arc, 1)
		local proj
		for _, c in r do if c.cue == "paint.bomb.projectile" then proj = c end end
		T.expect(proj ~= nil and proj.gravity == 40)
		local p = EffectsModel.projectilePosition(proj, 100.5)
		T.expect(math.abs(p.Z - 40) < 1e-9 and math.abs(p.Y - (10 - 0.5 * 40 * 0.25)) < 1e-9)
		local pierce = EffectsModel.translate({ type = "Spawned", projectileType = "Pierce", defId = "piercing_shot", ownerId = 1, projectileId = "pj10", pos = v(0, 0, 0), dir = v(0, 0, 1), speed = 260, radius = 0.4, lifetime = 1.2, time = 1 }, 1)
		local found = false
		for _, c in pierce do if c.cue == "paint.pierce.projectile" then found = true end end
		T.expect(found)
		local ex = EffectsModel.translate({ type = "Explosion", ownerId = 1, pos = v(3, 0, 4), radius = 8 }, 1)
		T.expect(ex[1].cue == "paint.explosion" and ex[1].radius == 8)
		for _, name in { "paint.burst", "paint.bomb.throw", "paint.bomb.projectile", "paint.explosion", "paint.pierce.fire", "paint.pierce.projectile", "paint.slide", "paint.ult.windup", "paint.ult.beam", "paint.ult.end", "paint.reload.proc" } do
			T.expect(Catalog.Cues[name] ~= nil, name)
		end
	end)
	T.it("서버가 보내는 모든 PAINTBALL 큐 이름이 카탈로그에 있다(실제 이벤트 수집)", function()
		local c, core, pos, events = setup({ a = "PAINTBALL", b = "SWORD" }, { movement = true })
		pos.b = v(0, 0, 12)
		c._p.a.ammo = 6
		c:handleAttack("a", sec(), 0)
		c:handleSkill("a", skill(1), 0)
		c:handleSkill("a", skill(2), 0)
		c:handleSkill("a", skill(3), 0)
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0.1)
		run(c, 0.1, 4)
		local n = 0
		for _, e in events do
			if e.type == "CharSkill" then
				n += 1
				T.expect(Catalog.Cues[e.cue] ~= nil, "카탈로그에 없는 큐: " .. tostring(e.cue))
			end
		end
		T.expect(n >= 6)
	end)
	T.it("Color Reload 발동 알림(내 것만 토스트), 탄약 부족 거부 안내", function()
		local mine = FeedbackModel.translate({ type = "CharSkill", cue = "paint.reload.proc", playerId = 1, restored = 3 }, 1)
		T.expect(mine[1] and mine[1].kind == "Toast")
		T.expectEqual(#FeedbackModel.translate({ type = "CharSkill", cue = "paint.reload.proc", playerId = 2, restored = 3 }, 1), 0)
		local rej = FeedbackModel.translate({ type = "Rejected", remote = "Attack", reason = "no_ammo" }, 1)
		T.expect(rej[1] and rej[1].kind == "Toast")
	end)
	T.it("HUD: 스킬 3칸·슬라이드·궁극기 전조/발동·Color Reload 잠금 표시", function()
		local c, core = setup({ a = "PAINTBALL" }, { movement = true })
		c:handleSkill("a", skill(3), 0)
		local m = HudModel.build(c:getHudSnapshot("a", 0.1), 0.1)
		T.expect(m.skills[3].implemented and m.skills[3].state == "sliding" and not m.skills[3].ready)
		T.expect(m.skills[1].implemented and m.skills[1].ready and m.skills[1].name == "Color Bomb")
		T.expect(m.ultimate.implemented and not m.ultimate.ready)
		T.expectEqual(m.healthText, "95 / 95")
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 1)
		local m2 = HudModel.build(c:getHudSnapshot("a", 1.2), 1.2)
		T.expect(m2.ultimate.active and m2.ultimate.windup and string.find(m2.ultimate.label, "전조", 1, true) ~= nil)
		local m3 = HudModel.build(c:getHudSnapshot("a", 2.0), 2.0)
		T.expect(m3.ultimate.active and not m3.ultimate.windup)
		T.expect(m3.passive.id == "ColorReload" and m3.passive.ready)
	end)
end)

return true
