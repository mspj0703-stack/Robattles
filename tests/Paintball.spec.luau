T.describe("PAINTBALL Skill 3 — Paint Slide (12 스터드, 쿨 7, 이동 허가)", function()
	T.it("이동 허가(PaintSlide) 발급 + 이벤트에 거리 12·dash 정보, 쿨타임 7초", function()
