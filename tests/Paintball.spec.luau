--!nonstrict
-- Phase 2: PAINTBALL(HP 95) 전체 스킬(서버 로직) 회귀. LMB Paint Shot, RMB Paint Burst, 스킬 1~3, 궁극기 Color Break, 패시브 Color Reload,
-- 캐릭터별 최대 체력, Aim 리모트, 보안(위조·중복·사망·지연). 확정/임시 수치 구분은 Data/Characters.PAINTBALL 주석과 docs/ASSUMPTIONS.md A68~A71.
-- Roblox 실제 동작(충돌 실측·애니메이션·이동 적용·이펙트 렌더)은 Studio 미검증.
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local H = require(script.Parent.Helpers)
local Core = Env.server("CombatCore")
local ProjectileService = Env.server("ProjectileService")
local Controller = Env.server("CharacterController")
local Movement = Env.server("MovementValidator")
local Characters = Env.shared("Data/Characters")
local Config = Env.shared("Config")
local RemoteSpec = Env.shared("RemoteSpec")
local Gate = Env.server("RemoteGate")
local Router = Env.server("ServerRouter")
local InputState = Env.client("Logic/InputState")
local MovementModel = Env.client("Logic/MovementModel")
local EffectsModel = Env.client("Logic/EffectsModel")
local FeedbackModel = Env.client("Logic/FeedbackModel")
local HudModel = Env.client("Logic/HudModel")
local Catalog = Env.shared("Data/EffectCatalog")

local v = H.v
local fwd = v(0, 0, 1)
local P = Characters.PAINTBALL

-- ids: { id = characterId }. opts: { planes, movement = bool, config }
local function setup(ids, opts)
	opts = opts or {}
	local cfg = opts.config or Config
	local core = Core.new(cfg)
	local pos, face = {}, {}
	local world = H.fakeWorld(opts.planes or {})
	local function targets()
		local list = {}
		for id in ids do
			table.insert(list, { id = id, pos = pos[id], radius = cfg.Combat.HitRadius, alive = core.damage:isAlive(id) })
		end
		return list
	end
	local ps = ProjectileService.new({ damage = core.damage, targets = targets, world = world, config = cfg })
	local movement
	if opts.movement then
		movement = Movement.new({ config = cfg, world = H.fakeWorld({ { point = v(0, 0, 0), normal = v(0, 1, 0) } }) })
	end
	local c = Controller.new({
		config = cfg, core = core, projectiles = ps, targets = targets, world = world, movement = movement,
		getPose = function(id) return { pos = pos[id], forward = face[id], airborne = false } end,
	})
	local events = {}
	c:onFeedback(function(e) table.insert(events, e) end)
	for id, ch in ids do
		c:addPlayer(id, ch)
		pos[id] = v(0, 0, 0)
		face[id] = fwd
		if movement then movement:register(id, v(0, 3.2, 0), 0) end
	end
	return c, core, pos, events, movement, ps
end

local function run(c, from, to, dt)
	local t = from
	dt = dt or 0.05
	while t < to - 1e-9 do
		t = math.min(t + dt, to)
		c:update(t, dt)
	end
end

local function lost(core, id) return core.damage:getMaxHealth(id) - core.damage:getHealth(id) end
local function count(events, kind, cue)
	local n = 0
	for _, e in events do
		if e.type == kind and (cue == nil or e.cue == cue) then n += 1 end
	end
	return n
end
local function prim(dir) return { action = "Primary", aimDirection = dir or fwd } end
local function sec(dir) return { action = "Secondary", aimDirection = dir or fwd } end
local function skill(slot, dir) return { slot = slot, aimDirection = dir or fwd } end
local function fill(core, id) for _ = 1, 5 do core.ultimate:addKill(id) end end
local function ammo(c, id) return c:getAmmo(id) end

-- ── 캐릭터별 최대 체력(공통 구조) ─────────────────────────────
T.describe("캐릭터별 최대 체력", function()
	T.it("확정 수치: SWORD 110 / PAINTBALL 95, 데이터에 있고 DamageService 에 반영", function()
		T.expectEqual(Characters.SWORD.maxHealth, 110)
		T.expectEqual(Characters.PAINTBALL.maxHealth, 95)
		local c, core = setup({ a = "SWORD", b = "PAINTBALL" })
		T.expectEqual(core.damage:getMaxHealth("a"), 110)
		T.expectEqual(core.damage:getHealth("a"), 110)
		T.expectEqual(core.damage:getMaxHealth("b"), 95)
		T.expectEqual(c:getMaxHealth("b"), 95)
	end)
	T.it("HUD 스냅샷의 최대 체력은 캐릭터별 값", function()
		local c = setup({ a = "SWORD", b = "PAINTBALL" })
		T.expectEqual(c:getHudSnapshot("a", 0).health.max, 110)
		T.expectEqual(c:getHudSnapshot("b", 0).health.max, 95)
	end)
	T.it("PAINTBALL 은 95 피해에 사망, 94에는 생존(체력 1)", function()
		local c, core = setup({ a = "PAINTBALL", b = "SWORD" })
		core.damage:applyDamage({ attackerId = "b", targetId = "a", attackId = "x", amount = 94 }, 0)
		T.expect(core.damage:isAlive("a") and core.damage:getHealth("a") == 1)
		local r = core.damage:applyDamage({ attackerId = "b", targetId = "a", attackId = "y", amount = 1 }, 0)
		T.expect(r.killed)
	end)
	T.it("캐릭터 변경은 다음 리스폰에서 새 최대 체력으로 가득 채워진다(SWORD → PAINTBALL → SWORD)", function()
		local c, core = setup({ a = "SWORD", b = "SWORD" })
		c:selectCharacter("a", "PAINTBALL")
		T.expectEqual(core.damage:getMaxHealth("a"), 110) -- 아직 적용 전
		core.damage:applyDamage({ attackerId = "b", targetId = "a", attackId = "k", amount = 200 }, 1)
		c:respawn("a", 5)
		T.expectEqual(c:getCharacterId("a"), "PAINTBALL")
		T.expectEqual(core.damage:getMaxHealth("a"), 95)
		T.expectEqual(core.damage:getHealth("a"), 95)
		c:selectCharacter("a", "SWORD")
		core.damage:applyDamage({ attackerId = "b", targetId = "a", attackId = "k2", amount = 200 }, 6)
		c:respawn("a", 10)
		T.expectEqual(core.damage:getMaxHealth("a"), 110)
		T.expectEqual(core.damage:getHealth("a"), 110)
	end)
	T.it("setMaxHealth 는 비정상 값을 거부하고, 체력은 최대치를 넘지 않는다", function()
		local _, core = setup({ a = "SWORD" })
		T.expect(not core.damage:setMaxHealth("a", 0))
		T.expect(not core.damage:setMaxHealth("a", -5))
		T.expect(not core.damage:setMaxHealth("a", 0 / 0))
		T.expect(not core.damage:setMaxHealth("nobody", 100))
		T.expectEqual(core.damage:getMaxHealth("a"), 110)
		T.expect(core.damage:setMaxHealth("a", 50, false))
		T.expectEqual(core.damage:getHealth("a"), 50)
	end)
end)

-- ── LMB Paint Shot ──────────────────────────────────────────
T.describe("PAINTBALL LMB — Paint Shot (7, 초당 3발, 탄창 16, 재장전 1.2초)", function()
	T.it("확정 수치", function()
		T.expectEqual(P.primary.damage, 7)
		T.expect(math.abs(1 / P.primary.fireInterval - 3) < 1e-9)
		T.expectEqual(P.ammo.magazine, 16)
		T.expectEqual(P.ammo.reloadSeconds, 1.2)
		T.expectEqual(P.primary.projectile.damage, 7)
	end)
	T.it("서버 투사체가 날아가 명중하면 피해 7", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" })
		pos.b = v(0, 0, 40)
		T.expect((c:handleAttack("a", prim(), 0)))
		T.expectEqual(lost(core, "b"), 0) -- 발사 직후에는 아직 도달 전
		run(c, 0, 0.5)
		T.expectEqual(lost(core, "b"), 7)
	end)
	T.it("초당 3발: 간격 미만은 on_cooldown, 탄약 소모는 성공한 발사만", function()
		local c = setup({ a = "PAINTBALL" })
		T.expect((c:handleAttack("a", prim(), 0)))
		local ok, why = c:handleAttack("a", prim(), 0.2)
		T.expect(not ok and why == "on_cooldown")
		T.expectEqual(ammo(c, "a"), 15)
		T.expect((c:handleAttack("a", prim(), 1 / 3)))
		T.expect((c:handleAttack("a", prim(), 2 / 3)))
		T.expectEqual(ammo(c, "a"), 13)
	end)
	T.it("같은 순간 100번 요청해도 1발만 나간다(연타·중복 요청)", function()
		local c, _, _, _, _, ps = setup({ a = "PAINTBALL" })
		local okCount = 0
		for _ = 1, 100 do
			if c:handleAttack("a", prim(), 5) then okCount += 1 end
		end
		T.expectEqual(okCount, 1)
		T.expectEqual(ammo(c, "a"), 15)
		T.expectEqual(ps:getActiveCount("a"), 1)
	end)
	T.it("탄창 16발: 마지막 발 후 자동 재장전 1.2초, 장전 중 발사 불가, 완료 후 가득", function()
		local c = setup({ a = "PAINTBALL" })
		for i = 0, 15 do
			T.expect((c:handleAttack("a", prim(), i / 3)), "shot " .. i)
		end
		T.expectEqual(ammo(c, "a"), 0)
		local tEnd = 15 / 3
		T.expect(c:isReloading("a", tEnd + 0.1))
		local ok, why = c:handleAttack("a", prim(), tEnd + 0.4)
		T.expect(not ok and why == "reloading")
		run(c, tEnd, tEnd + 1.15)
		T.expect(c:isReloading("a", tEnd + 1.15))
		run(c, tEnd + 1.15, tEnd + 1.25)
		T.expectEqual(ammo(c, "a"), 16)
		T.expect((c:handleAttack("a", prim(), tEnd + 1.4)))
	end)
	T.it("탄약 0에서 발사 시도는 no_ammo(투사체·쿨타임 소모 없음) + 재장전 시작", function()
		local c, core, _, _, _, ps = setup({ a = "PAINTBALL" })
		c._p.a.ammo = 0
		local ok, why = c:handleAttack("a", prim(), 0)
		T.expect(not ok and why == "no_ammo")
		T.expectEqual(ps:getActiveCount("a"), 0)
		T.expect(core.cooldown:isReady("a", "primary", 0))
		T.expect(c:isReloading("a", 0.1))
	end)
	T.it("원거리 자동 조준 보정 없음: 15도 빗나가면 명중하지 않는다", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" })
		pos.b = v(0, 0, 40)
		local a = math.rad(15)
		c:handleAttack("a", prim(v(math.sin(a), 0, math.cos(a))), 0)
		run(c, 0, 1)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("재장전 R: 가득이면 거부, 사용 후 허용, 이미 장전 중 거부", function()
		local c = setup({ a = "PAINTBALL" })
		T.expect(select(2, c:handleReload("a", 0)) == "full")
		c:handleAttack("a", prim(), 0)
		T.expect((c:handleReload("a", 1)))
		T.expect(select(2, c:handleReload("a", 1.1)) == "already_reloading")
		run(c, 1, 2.3)
		T.expectEqual(ammo(c, "a"), 16)
	end)
	T.it("사망 후 발사 불가, 이미 발사한 투사체는 유지되어 명중", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD", k = "SWORD" })
		pos.b = v(0, 0, 60)
		pos.k = v(500, 0, 0)
		c:handleAttack("a", prim(), 0)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 200 }, 0.05)
		local ok, why = c:handleAttack("a", prim(), 0.5)
		T.expect(not ok and why == "dead")
		run(c, 0.05, 1)
		T.expectEqual(lost(core, "b"), 7)
	end)
	T.it("부활 보호: 거부된 발사(재장전·쿨타임)는 해제하지 않고, 성공한 발사만 해제", function()
		local c = setup({ a = "PAINTBALL" })
		c:respawn("a", 0)
		c._p.a.ammo = 0
		c:handleAttack("a", prim(), 0.1)
		T.expect(c:isProtected("a", 0.2)) -- no_ammo 거부
		c._p.a.reloadingUntil = 0
		c._p.a.ammo = 16
		T.expect((c:handleAttack("a", prim(), 0.3)))
		T.expect(not c:isProtected("a", 0.35))
	end)
end)

-- ── RMB Paint Burst ─────────────────────────────────────────
T.describe("PAINTBALL RMB — Paint Burst (5발×5, 최대 25, 탄 3, 후딜 1초)", function()
	T.it("독립 투사체 5개가 같은 대상에 모두 적중하면 25(다중 적중 허용, 최대 25)", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" })
		pos.b = v(0, 0, 12)
		T.expect((c:handleAttack("a", sec(), 0)))
		run(c, 0, 0.5)
		T.expectEqual(lost(core, "b"), 25)
	end)
	T.it("탄약 3 소모, 탄약 2 이하면 거부(탄약·쿨타임·보호 불변)", function()
		local c, core = setup({ a = "PAINTBALL" })
		c:respawn("a", 0)
		T.expect((c:handleAttack("a", sec(), 0.1)) and ammo(c, "a") == 13)
		c._p.a.ammo = 2
		c:respawn("a", 10)
		c._p.a.ammo = 2
		local ok, why = c:handleAttack("a", sec(), 10.1)
		T.expect(not ok and why == "no_ammo")
		T.expectEqual(ammo(c, "a"), 2)
		T.expect(core.cooldown:isReady("a", "secondary", 10.1))
		T.expect(c:isProtected("a", 10.2))
	end)
	T.it("후딜(쿨타임) 1초: 0.9초에 거부, 1.0초에 허용", function()
		local c = setup({ a = "PAINTBALL" })
		T.expect((c:handleAttack("a", sec(), 0)))
		T.expect(select(2, c:handleAttack("a", sec(), 0.9)) == "on_cooldown")
		T.expect((c:handleAttack("a", sec(), 1.0)))
		T.expectEqual(ammo(c, "a"), 10)
	end)
	T.it("산탄: 중거리에서는 일부만 맞는다(결정적 패턴, 25 초과 불가)", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" })
		pos.b = v(0, 0, 45)
		c:handleAttack("a", sec(), 0)
		run(c, 0, 0.8)
		local dealt = lost(core, "b")
		T.expect(dealt > 0 and dealt < 25 and dealt % 5 == 0, "dealt=" .. dealt)
	end)
	T.it("탄이 3 남았을 때 발사하면 0이 되어 자동 재장전, 장전 중 거부", function()
		local c = setup({ a = "PAINTBALL" })
		c._p.a.ammo = 3
		T.expect((c:handleAttack("a", sec(), 0)))
		T.expectEqual(ammo(c, "a"), 0)
		T.expect(c:isReloading("a", 0.1))
		T.expect(select(2, c:handleAttack("a", sec(), 1.1)) == "reloading")
	end)
	T.it("재장전 중에는 Burst 불가", function()
		local c = setup({ a = "PAINTBALL" })
		c._p.a.ammo = 8
		c:handleReload("a", 0)
		T.expect(select(2, c:handleAttack("a", sec(), 0.5)) == "reloading")
		T.expectEqual(ammo(c, "a"), 8)
	end)
	T.it("투사체 상한이면 일부만 나가지 않고 통째로 거부(탄약·쿨타임 불변)", function()
		local cfg = H.clone(Config)
		cfg.Projectile.MaxActivePerOwner = 4
		local c, core = setup({ a = "PAINTBALL" }, { config = cfg })
		local ok, why = c:handleAttack("a", sec(), 0)
		T.expect(not ok and why == "too_many_projectiles")
		T.expectEqual(ammo(c, "a"), 16)
		T.expect(core.cooldown:isReady("a", "secondary", 0))
	end)
end)

-- ── 스킬 1: Color Bomb ──────────────────────────────────────
T.describe("PAINTBALL Skill 1 — Color Bomb (광역 24, 쿨 9)", function()
	T.it("대상에게 맞아 폭발: 반경 안 모든 적 24, 밖은 0, 시전자는 피해 없음", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD", d = "SWORD", e = "SWORD" })
		pos.b = v(0, 0, 10)
		pos.d = v(0, 0, 14)
		pos.e = v(0, 0, 40)
		T.expect((c:handleSkill("a", skill(1), 0)))
		run(c, 0, 1)
		T.expectEqual(lost(core, "b"), 24)
		T.expectEqual(lost(core, "d"), 24)
		T.expectEqual(lost(core, "e"), 0)
		T.expectEqual(lost(core, "a"), 0)
	end)
	T.it("직접 피해 없음: 같은 대상에 중복 피해가 없다(폭발 1회만)", function()
		local c, core, pos, events = setup({ a = "PAINTBALL", b = "SWORD" })
		pos.b = v(0, 0, 10)
		c:handleSkill("a", skill(1), 0)
		run(c, 0, 1)
		T.expectEqual(lost(core, "b"), 24)
	end)
	T.it("바닥/벽에 맞아도 그 지점에서 폭발한다(지면 평면 사용)", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD" }, { planes = { { point = v(0, 0, 0), normal = v(0, 1, 0) } } })
		pos.b = v(6, 3, 18) -- 조준선 옆(직격 불가), 지면 접촉 지점 근처. 캐릭터 기준점(HRP)은 지면 위 3
		c:handleSkill("a", skill(1), 0)
		run(c, 0, 1.5)
		T.expectEqual(lost(core, "b"), 24)
	end)
	T.it("벽이 폭발을 가린다: 벽 너머 대상은 반경 안이어도 피해 없음", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD", d = "SWORD" }, { planes = { { point = v(0, 0, 12), normal = v(0, 0, -1) } } })
		pos.b = v(0, 0, 10)
		pos.d = v(0, 0, 15)
		c:handleSkill("a", skill(1), 0)
		run(c, 0, 1)
		T.expectEqual(lost(core, "b"), 24)
		T.expectEqual(lost(core, "d"), 0)
	end)
	T.it("쿨타임 9초: 8.9초 거부, 9초 허용, 거부 시 상태 불변", function()
		local c, core = setup({ a = "PAINTBALL" })
		T.expect((c:handleSkill("a", skill(1), 0)))
		local ok, why = c:handleSkill("a", skill(1), 8.9)
		T.expect(not ok and why == "on_cooldown")
		T.expect((c:handleSkill("a", skill(1), 9)))
	end)
	T.it("탄약·재장전과 무관: 탄이 0이거나 재장전 중에도 사용 가능(탄약 불변)", function()
		local c = setup({ a = "PAINTBALL" })
		c._p.a.ammo = 0
		c:handleReload("a", 0)
		T.expect((c:handleSkill("a", skill(1), 0.1)))
		T.expectEqual(ammo(c, "a"), 0)
	end)
	T.it("시전자 사망 후에도 날아간 폭탄은 폭발한다(이미 발사한 투사체 규칙)", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD", k = "SWORD" })
		pos.b = v(0, 0, 30)
		pos.k = v(500, 0, 0)
		c:handleSkill("a", skill(1), 0)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 200 }, 0.02)
		run(c, 0.02, 1.5)
		T.expectEqual(lost(core, "b"), 24)
	end)
end)

-- ── 스킬 2: Piercing Shot ───────────────────────────────────
T.describe("PAINTBALL Skill 2 — Piercing Shot (대상당 30, 최대 3명, 쿨 12)", function()
	T.it("한 줄로 선 적 3명을 관통해 각각 30, 4번째는 맞지 않는다", function()
		local c, core, pos = setup({ a = "PAINTBALL", b = "SWORD", d = "SWORD", e = "SWORD", f = "SWORD" })
		pos.b, pos.d, pos.e, pos.f = v(0, 0, 10), v(0, 0, 20), v(0, 0, 30), v(0, 0, 40)
		T.expect((c:handleSkill("a", skill(2), 0)))
		run(c, 0, 1)
		T.expectEqual(lost(core, "b"), 30)
		T.expectEqual(lost(core, "d"), 30)
		T.expectEqual(lost(core, "e"), 30)
