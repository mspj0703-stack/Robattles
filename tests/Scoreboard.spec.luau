--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local Core = Env.server("CombatCore")
local Scoreboard = Env.server("ScoreboardService")

T.describe("ScoreboardService", function()
	T.it("킬/데스 집계와 정렬(킬↓, 데스↑, 이름)", function()
		local sb = Scoreboard.new()
		for _, n in { "a", "b", "c" } do sb:register(n, n) end
		sb:onKill("a", "b")
		sb:onKill("a", "c")
		sb:onKill("b", "c")
		local s = sb:snapshot()
		T.expectEqual(s[1].id, "a")
		T.expectEqual(s[1].kills, 2)
		T.expectEqual(s[2].id, "b")
		T.expectEqual(s[3].deaths, 2)
	end)
	T.it("환경 사망·자살은 킬이 오르지 않고 데스만 증가", function()
		local sb = Scoreboard.new()
		sb:register("a", "a")
		sb:onKill("a", "a")
		T.expectEqual(sb:snapshot()[1].kills, 0)
		T.expectEqual(sb:snapshot()[1].deaths, 1)
	end)
	T.it("CombatCore 처치 이벤트와 연결", function()
		local core = Core.new()
		local sb = Scoreboard.new()
		core:addPlayer("a")
		core:addPlayer("b")
		sb:register("a", "a")
		sb:register("b", "b")
		core.damage:onKilled(function(e) sb:onKill(e.attackerId, e.targetId) end)
		core.damage:applyDamage({ attackerId = "a", targetId = "b", attackId = "k", amount = 999 }, 0)
		core.damage:forceKill("a", 1)
		local s = sb:snapshot()
		T.expectEqual(s[1].id, "a")
		T.expectEqual(s[1].kills, 1)
		T.expectEqual(s[1].deaths, 1)
	end)
	T.it("퇴장한 플레이어는 목록에서 제거", function()
		local sb = Scoreboard.new()
		sb:register("a", "a")
		sb:remove("a")
		T.expectEqual(#sb:snapshot(), 0)
	end)
end)
return true
