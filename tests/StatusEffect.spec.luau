--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local H = require(script.Parent.Helpers)
local Status = Env.server("StatusEffectService")

T.describe("StatusEffectService", function()
	T.it("둔화: 가장 강한 하나만, 만료 후 복구", function()
		local s = Status.new()
		s:apply("p", { type = "Slow", multiplier = 0.7, duration = 3 }, 0)
		s:apply("p", { type = "Slow", multiplier = 0.5, duration = 1 }, 0)
		T.expectEqual(s:getSpeedMultiplier("p", 0.5), 0.5)
		T.expectEqual(s:getSpeedMultiplier("p", 2), 0.7)
		T.expectEqual(s:getSpeedMultiplier("p", 3.1), 1)
	end)
	T.it("위치 노출(Reveal)", function()
		local s = Status.new()
		s:apply("p", { type = "Reveal", duration = 2 }, 0)
		T.expect(s:isRevealed("p", 1.9))
		T.expect(not s:isRevealed("p", 2))
	end)
	T.it("기본 공격은 경직 불가, 강한 공격만 경직", function()
		local s = Status.new()
		local ok, reason = s:apply("p", { type = "Stagger", duration = 0.3 }, 0, { strong = false })
		T.expect(not ok and reason == "basic_no_stagger")
		T.expect(s:canAct("p", 0.1))
		T.expect((s:apply("p", { type = "Stagger", duration = 0.3 }, 0, { strong = true })))
		T.expect(not s:canAct("p", 0.1))
		T.expect(s:canAct("p", 0.3))
	end)
	T.it("연속 경직 저항: 지속시간 절반씩 감소, 창 밖이면 초기화", function()
		local s = Status.new()
		local _, a = s:apply("p", { type = "Stagger", duration = 0.4 }, 0, { strong = true })
		local _, b = s:apply("p", { type = "Stagger", duration = 0.4 }, 1, { strong = true })
		local _, c = s:apply("p", { type = "Stagger", duration = 0.4 }, 2, { strong = true })
		T.expectEqual(a.duration, 0.4)
		T.expectEqual(b.duration, 0.2)
		T.expectEqual(c.duration, 0.1)
		local ok, reason = s:apply("p", { type = "Stagger", duration = 0.4 }, 2.5, { strong = true })
		T.expect(ok == true or reason == "stagger_resisted") -- 0.05 경계
		local _, d = s:apply("p", { type = "Stagger", duration = 0.4 }, 20, { strong = true })
		T.expectEqual(d.duration, 0.4)
	end)
	T.it("기절: 상한 1.5초, 종료 후 면역", function()
		local s = Status.new()
		local _, info = s:apply("p", { type = "Stun", duration = 10 }, 0)
		T.expectEqual(info.duration, 1.5)
		T.expect(not s:canAct("p", 1))
		local ok, reason = s:apply("p", { type = "Stun", duration = 1 }, 2)
		T.expect(not ok and reason == "cc_immune")
		T.expect((s:apply("p", { type = "Airborne", duration = 1 }, 5)))
	end)
	T.it("넉백 속도 계산 / 잘못된 방향 거부", function()
		local s = Status.new()
		local ok, info = s:apply("p", { type = "Knockback", direction = H.v(0, 0, 2), power = 30, upward = 5 }, 0)
		T.expect(ok)
		T.expectEqual(info.velocity.Z, 30)
		T.expectEqual(info.velocity.Y, 5)
		T.expect(not (s:apply("p", { type = "Knockback", direction = H.v(0, 0, 0), power = 30 }, 0)))
		T.expect(not (s:apply("p", { type = "Knockback", direction = H.v(0, 0, 1), power = 9999 }, 0)))
	end)
	T.it("잘못된 효과·NaN 지속시간·잘못된 배율 거부", function()
		local s = Status.new()
		T.expect(not (s:apply("p", { type = "Instakill", duration = 1 }, 0)))
		T.expect(not (s:apply("p", { type = "Slow", multiplier = 0.5, duration = 0 / 0 }, 0)))
		T.expect(not (s:apply("p", { type = "Slow", multiplier = 0, duration = 1 }, 0)))
		T.expect(not (s:apply("p", "Slow", 0)))
	end)
	T.it("clear로 모든 상태 해제", function()
		local s = Status.new()
		s:apply("p", { type = "Slow", multiplier = 0.5, duration = 5 }, 0)
		s:clear("p")
		T.expectEqual(s:getSpeedMultiplier("p", 1), 1)
	end)
end)

T.describe("StatusEffectService 둔화 규칙 회귀 (확정 기획)", function()
	T.it("동시 둔화는 가장 강한 하나만: 합산·곱셈 없음", function()
		local s = Status.new()
		s:apply("p", { type = "Slow", multiplier = 0.8, duration = 5 }, 0)
		s:apply("p", { type = "Slow", multiplier = 0.6, duration = 5 }, 0)
		s:apply("p", { type = "Slow", multiplier = 0.7, duration = 5 }, 0)
		T.expectEqual(s:getSpeedMultiplier("p", 1), 0.6) -- 0.8*0.6*0.7 아님, 1-(0.2+0.4+0.3) 아님
	end)
	T.it("가장 강한 둔화 종료 후 남은 둔화가 승계", function()
		local s = Status.new()
		s:apply("p", { type = "Slow", multiplier = 0.4, duration = 2 }, 0)
		s:apply("p", { type = "Slow", multiplier = 0.7, duration = 6 }, 0)
		s:apply("p", { type = "Slow", multiplier = 0.9, duration = 9 }, 0)
		T.expectEqual(s:getSpeedMultiplier("p", 1), 0.4)
		T.expectEqual(s:getSpeedMultiplier("p", 3), 0.7)
		T.expectEqual(s:getSpeedMultiplier("p", 7), 0.9)
		T.expectEqual(s:getSpeedMultiplier("p", 10), 1)
	end)
	T.it("강한 둔화가 있어도 슬롯이 가득 차면 가장 먼저 끝나는 약한 둔화부터 제거", function()
		local s = Status.new()
		s:apply("p", { type = "Slow", multiplier = 0.2, duration = 50 }, 0)
		for i = 1, 12 do
			s:apply("p", { type = "Slow", multiplier = 0.9, duration = 1 + i }, 0)
		end
		T.expectEqual(s:getSpeedMultiplier("p", 1), 0.2)
	end)
	T.it("둔화 중에도 기본 공격 경직 없음, 행동 가능, 속도는 0이 되지 않음", function()
		local s = Status.new()
		s:apply("p", { type = "Slow", multiplier = 0.05, duration = 5 }, 0)
		local ok, reason = s:apply("p", { type = "Stagger", duration = 0.3 }, 1, { strong = false })
		T.expect(not ok and reason == "basic_no_stagger")
		T.expect(s:canAct("p", 1))
		T.expect(s:getSpeedMultiplier("p", 1) > 0)
		T.expect(not (s:apply("p", { type = "Slow", multiplier = 0, duration = 1 }, 1)))
	end)
	T.it("둔화 적용 자체는 경직을 만들지 않음", function()
		local s = Status.new()
		s:apply("p", { type = "Slow", multiplier = 0.5, duration = 5 }, 0)
		T.expect(s:canAct("p", 0))
	end)
end)

return true
