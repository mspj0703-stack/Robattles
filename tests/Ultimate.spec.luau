--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local Ultimate = Env.server("UltimateService")

local function fresh()
	local u = Ultimate.new()
	u:register("p1")
	return u
end
local function fill(u, id)
	u:addKill(id)
	for _ = 1, 4 do
		u:addKill(id)
	end
end

T.describe("UltimateService", function()
	T.it("피해·처치·시간으로 충전, 100에서 고정", function()
		local u = fresh()
		u:addDamage("p1", 50) -- 0.2/pt → 10
		T.expectEqual(u:getGauge("p1"), 10)
		u:addKill("p1") -- +20
		T.expectEqual(u:getGauge("p1"), 30)
		u:tick(10) -- +10
		T.expectEqual(u:getGauge("p1"), 40)
		fill(u, "p1")
		T.expectEqual(u:getGauge("p1"), 100)
	end)
	T.it("게이지 100 미만이면 발동 불가", function()
		local u = fresh()
		local ok, reason = u:activate("p1", 0, { duration = 3 })
		T.expect(not ok and reason == "not_ready")
	end)
	T.it("발동 시 게이지 소모, 중복 발동 거부, 발동 중 충전 없음", function()
		local u = fresh()
		fill(u, "p1")
		T.expect((u:activate("p1", 0, { duration = 3 })))
		T.expectEqual(u:getGauge("p1"), 0)
		u:addKill("p1")
		T.expectEqual(u:getGauge("p1"), 0)
		local ok, reason = u:activate("p1", 1, { duration = 3 })
		T.expect(not ok and reason == "already_active")
	end)
	T.it("자발적 취소 불가", function()
		local u = fresh()
		fill(u, "p1")
		u:activate("p1", 0, { duration = 3 })
		local ok, reason = u:requestCancel("p1")
		T.expect(not ok and reason == "not_cancelable")
		T.expect(u:isActive("p1"))
	end)
	T.it("행동 불가 상태에서는 발동 불가", function()
		local u = fresh()
		fill(u, "p1")
		local ok, reason = u:activate("p1", 0, { duration = 3 }, { canAct = false })
		T.expect(not ok and reason == "cannot_act")
	end)
	T.it("사망 시 연결된 지속 공격만 종료, 비연결 오브젝트는 유지", function()
		local u = fresh()
		fill(u, "p1")
		local beamStopped, ended = false, nil
		local placedBombAlive = true -- 설치물/투사체는 서비스가 추적하지 않음
		u:activate("p1", 0, { duration = 5, onEnd = function(r) ended = r end })
		u:attach("p1", function() beamStopped = true end)
		u:handleDeath("p1")
		T.expect(beamStopped)
		T.expectEqual(ended, "Death")
		T.expect(placedBombAlive)
		T.expect(not u:isActive("p1"))
		T.expectEqual(u:getGauge("p1"), 0)
		u:addKill("p1")
		T.expectEqual(u:getGauge("p1"), 0) -- 사망 중 충전 없음
	end)
	T.it("외부 강제 중단 / 정상 종료", function()
		local u = fresh()
		fill(u, "p1")
		local reason
		u:activate("p1", 0, { duration = 5, onEnd = function(r) reason = r end })
		u:forceEnd("p1", "External")
		T.expectEqual(reason, "External")
		fill(u, "p1")
		u:activate("p1", 10, { duration = 2, onEnd = function(r) reason = r end })
		u:update(11)
		T.expect(u:isActive("p1"))
		u:update(12)
		T.expectEqual(reason, "Completed")
	end)
	T.it("respawn 후 다시 충전 가능", function()
		local u = fresh()
		u:handleDeath("p1")
		u:respawn("p1")
		u:addKill("p1")
		T.expectEqual(u:getGauge("p1"), 20)
	end)
end)

T.describe("UltimateService 게이지 규칙 회귀 (확정 기획)", function()
	local function withChar(id, ch)
		local u = Ultimate.new()
		u:register(id, ch)
		return u
	end
	T.it("사망해도 게이지 유지", function()
		local u = withChar("p1", "SWORD")
		u:addKill("p1")
		u:addKill("p1")
		T.expectEqual(u:getGauge("p1"), 40)
		u:handleDeath("p1")
		T.expectEqual(u:getGauge("p1"), 40)
	end)
	T.it("같은 캐릭터로 부활하면 기존 게이지 그대로", function()
		local u = withChar("p1", "SWORD")
		for _ = 1, 4 do u:addKill("p1") end
		u:handleDeath("p1")
		u:setCharacter("p1", "SWORD")
		u:respawn("p1")
		T.expectEqual(u:getGauge("p1"), 80)
		T.expect(u:getCharacter("p1") == "SWORD")
	end)
	T.it("캐릭터 변경: 리스폰 전에는 적용 안 됨, 리스폰 시 min(게이지,40) 이월", function()
		local u = withChar("p1", "SWORD")
		for _ = 1, 4 do u:addKill("p1") end
		T.expectEqual(u:setCharacter("p1", "PAINTBALL"), "pending")
		T.expectEqual(u:getCharacter("p1"), "SWORD")
		T.expectEqual(u:getGauge("p1"), 80)
		u:handleDeath("p1")
		T.expectEqual(u:getGauge("p1"), 80)
		u:respawn("p1")
		T.expectEqual(u:getCharacter("p1"), "PAINTBALL")
		T.expectEqual(u:getGauge("p1"), 40)
	end)
	T.it("게이지가 40 미만이면 변경해도 그대로 이월", function()
		local u = withChar("p1", "SWORD")
		u:addKill("p1")
		u:setCharacter("p1", "PAINTBALL")
		u:respawn("p1")
		T.expectEqual(u:getGauge("p1"), 20)
	end)
	T.it("변경 후 원래 캐릭터로 되돌리면 대기 취소: 이월 제한 없음", function()
		local u = withChar("p1", "SWORD")
		for _ = 1, 4 do u:addKill("p1") end
		u:setCharacter("p1", "PAINTBALL")
		T.expectEqual(u:setCharacter("p1", "SWORD"), "unchanged")
		u:respawn("p1")
		T.expectEqual(u:getGauge("p1"), 80)
	end)
	T.it("정상 사용 시 게이지 100% 소모", function()
		local u = withChar("p1", "SWORD")
		for _ = 1, 5 do u:addKill("p1") end
		T.expect((u:activate("p1", 0, { duration = 3 })))
		T.expectEqual(u:getGauge("p1"), 0)
	end)
	T.it("새 경기 시작 시 게이지 초기화, 대기 캐릭터는 이월 없이 적용", function()
		local u = withChar("p1", "SWORD")
		for _ = 1, 4 do u:addKill("p1") end
		u:setCharacter("p1", "PAINTBALL")
		u:resetMatch()
		T.expectEqual(u:getGauge("p1"), 0)
		T.expectEqual(u:getCharacter("p1"), "PAINTBALL")
	end)
	T.it("사망 중에는 충전하지 않고 게이지는 유지", function()
		local u = withChar("p1", "SWORD")
		u:addKill("p1")
		u:handleDeath("p1")
		u:addKill("p1")
		u:tick(100)
		T.expectEqual(u:getGauge("p1"), 20)
	end)
end)

return true
