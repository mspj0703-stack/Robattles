-- Phase 2: SUPERBALL(HP 100) 전체 스킬(서버 로직) 회귀. LMB Super Throw(충전), RMB Bounce Dash, 스킬 1~3, 궁극기 Ball Cyclone, 패시브 Trick Master,
-- 볼 총량 12·교체 규칙·단계별 중복 피해·귀환 경로 판정·보안. 확정/임시 수치 구분은 Data/Characters.SUPERBALL 주석과 docs/ASSUMPTIONS.md A72~A75.
-- Roblox 실제 동작(충돌 실측·애니메이션·이동 적용·이펙트 렌더)은 Studio 미검증.
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local H = require(script.Parent.Helpers)
local Core = Env.server("CombatCore")
local ProjectileService = Env.server("ProjectileService")
local Controller = Env.server("CharacterController")
local Movement = Env.server("MovementValidator")
local BallService = Env.server("BallService")
local Characters = Env.shared("Data/Characters")
local Config = Env.shared("Config")
local RemoteSpec = Env.shared("RemoteSpec")
local Gate = Env.server("RemoteGate")
local Router = Env.server("ServerRouter")
local InputState = Env.client("Logic/InputState")
local EffectsModel = Env.client("Logic/EffectsModel")
local HudModel = Env.client("Logic/HudModel")
local Catalog = Env.shared("Data/EffectCatalog")

local v = H.v
local fwd = v(0, 0, 1)
local S = Characters.SUPERBALL

-- 중력 0 캐릭터 데이터(직선 비행으로 기하를 단순화). 나머지 수치는 그대로.
local function flatChars()
	local c = H.clone(Characters)
	c.SUPERBALL.primary.normal.gravity = 0
	c.SUPERBALL.primary.charged.gravity = 0
	c.SUPERBALL.skills[1].ball.gravity = 0
	c.SUPERBALL.skills[2].ball.gravity = 0
	c.SUPERBALL.ultimate.shot.gravity = 0
	return c
end

-- ids: { id = characterId }. opts: { planes, movement, config, chars }
local function setup(ids, opts)
	opts = opts or {}
	local cfg = opts.config or Config
	local core = Core.new(cfg)
	local pos, face = {}, {}
	local world = H.fakeWorld(opts.planes or {})
	local function targets()
		local list = {}
		for id in ids do
			table.insert(list, { id = id, pos = pos[id], radius = cfg.Combat.HitRadius, alive = core.damage:isAlive(id) })
		end
		return list
	end
	local ps = ProjectileService.new({ damage = core.damage, targets = targets, world = world, config = cfg })
	local movement
	if opts.movement then
		movement = Movement.new({ config = cfg, world = H.fakeWorld({ { point = v(0, 0, 0), normal = v(0, 1, 0) } }) })
	end
	local c = Controller.new({
		config = cfg, core = core, projectiles = ps, targets = targets, world = world, movement = movement, characters = opts.chars or flatChars(),
		getPose = function(id) return { pos = pos[id], forward = face[id], airborne = opts.airborne == true } end,
	})
	local events = {}
	c:onFeedback(function(e) table.insert(events, e) end)
	local dmg = {}
	core.damage:onDamaged(function(e) table.insert(dmg, e) end)
	for id, ch in ids do
		c:addPlayer(id, ch)
		pos[id] = v(0, 0, 0)
		face[id] = fwd
		if movement then movement:register(id, v(0, 3.2, 0), 0) end
	end
	return c, core, pos, events, movement, dmg, face
end

local function run(c, from, to, dt)
	local t = from
	dt = dt or 0.05
	while t < to - 1e-9 do
		t = math.min(t + dt, to)
		c:update(t, dt)
	end
end

local function lost(core, id) return core.damage:getMaxHealth(id) - core.damage:getHealth(id) end
local function count(events, kind, pred)
	local n = 0
	for _, e in events do
		if e.type == kind and (pred == nil or pred(e)) then n += 1 end
	end
	return n
end
local function prim(dir, phase) return { action = "Primary", aimDirection = dir or fwd, phase = phase } end
local function sec(dir) return { action = "Secondary", aimDirection = dir or fwd } end
local function skill(slot, dir) return { slot = slot, aimDirection = dir or fwd } end
local function fill(core, id) for _ = 1, 5 do core.ultimate:addKill(id) end end
local function impl(c) return c._impl.SUPERBALL end
local function balls(c, id, filter) return impl(c).balls:list(id, filter) end
local function nBalls(c, id) return impl(c).balls:count(id) end
local function isUlt(b) return b.ultimate end
local function isNorm(b) return not b.ultimate end
local wallZ = function(z, n) return { point = v(0, 0, z), normal = v(0, 0, n) } end

-- ── 구조·확정 수치 ───────────────────────────────────────────
