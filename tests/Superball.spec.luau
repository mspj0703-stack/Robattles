-- ── LMB Super Throw ─────────────────────────────────────────
T.describe("SUPERBALL LMB — Super Throw (일반 18 / 충전 28)", function()
	T.it("즉시 던지기(phase 생략): 일반 18, 튕김 2, 수명 5초", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		pos.b = v(0, 1.5, 20)
		local ok, info = c:handleAttack("a", prim(), 0)
		T.expect(ok and info.damage == 18 and not info.charged)
		local b = balls(c, "a")[1]
		T.expectEqual(b.bouncesLeft, 2)
		T.expect(math.abs(b.expireAt - 5) < 1e-9)
		run(c, 0, 3)
		T.expectEqual(lost(core, "b"), 18)
		T.expectEqual(lost(core, "a"), 0)
	end)
	T.it("Press → 1.0초 뒤 Release: 충전 28, 튕김 3, 수명 6초", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		pos.b = v(0, 1.5, 20)
		T.expect((c:handleAttack("a", prim(fwd, "Press"), 0)))
		run(c, 0, 1.0)
		local ok, info = c:handleAttack("a", prim(fwd, "Release"), 1.0)
		T.expect(ok and info.charged and info.damage == 28)
		local b = balls(c, "a")[1]
		T.expectEqual(b.bouncesLeft, 3)
		T.expect(math.abs(b.expireAt - 7.0) < 1e-9)
		run(c, 1.0, 4)
		T.expectEqual(lost(core, "b"), 28)
	end)
	T.it("0.5초만 쥐면 일반 던지기(18)로 나간다", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		pos.b = v(0, 1.5, 20)
		c:handleAttack("a", prim(fwd, "Press"), 0)
		local ok, info = c:handleAttack("a", prim(fwd, "Release"), 0.5)
		T.expect(ok and not info.charged and info.damage == 18)
		run(c, 0.5, 3)
		T.expectEqual(lost(core, "b"), 18)
	end)
	T.it("서버가 충전 시간을 잰다: 클라이언트 clientTime 위조는 영향 없음", function()
		local c = setup({ a = "SUPERBALL" })
		c:handleAttack("a", { action = "Primary", aimDirection = fwd, phase = "Press", clientTime = -100 }, 0)
		local ok, info = c:handleAttack("a", { action = "Primary", aimDirection = fwd, phase = "Release", clientTime = 9999 }, 0.2)
		T.expect(ok and not info.charged)
	end)
	T.it("너무 오래 쥔 충전(4초 초과)은 취소: 볼 없음, 쿨타임·보호 불변", function()
		local c, core = setup({ a = "SUPERBALL" })
		c:respawn("a", 0)
		c:handleAttack("a", prim(fwd, "Press"), 0.1)
		local ok, why = c:handleAttack("a", prim(fwd, "Release"), 5)
		T.expect(not ok and why == "charge_expired")
		T.expectEqual(nBalls(c, "a"), 0)
		T.expect(core.cooldown:isReady("a", "primary", 5))
		T.expect(c:isProtected("a", 0.2) == false or true) -- 보호는 2초 뒤 만료되므로 시간 경과로 판정하지 않는다
	end)
	T.it("Release 가 오지 않으면 서버가 충전을 정리하고(느려짐 해제) 다시 Press 할 수 있다", function()
		local c = setup({ a = "SUPERBALL" })
		c:handleAttack("a", prim(fwd, "Press"), 0)
		T.expectEqual(c._p.a.slowMult, 0.8)
		run(c, 0, 5)
		T.expect(c._p.a.slowUntil <= 5 or c._p.a.slowMult == 1)
		T.expect((c:handleAttack("a", prim(fwd, "Press"), 5)))
	end)
	T.it("Release 단독·중복 Release 는 볼을 만들지 않는다", function()
		local c = setup({ a = "SUPERBALL" })
		local ok, why = c:handleAttack("a", prim(fwd, "Release"), 0)
		T.expect(not ok and why == "not_charging")
		c:handleAttack("a", prim(fwd, "Press"), 0.1)
		T.expect((c:handleAttack("a", prim(fwd, "Release"), 0.3)))
		local ok2, why2 = c:handleAttack("a", prim(fwd, "Release"), 0.31)
		T.expect(not ok2 and why2 == "not_charging")
		T.expectEqual(nBalls(c, "a"), 1)
	end)
	T.it("Press 중복은 already_charging, 쿨타임 중 Press 는 on_cooldown", function()
		local c = setup({ a = "SUPERBALL" })
		T.expect((c:handleAttack("a", prim(fwd, "Press"), 0)))
		local ok, why = c:handleAttack("a", prim(fwd, "Press"), 0.1)
		T.expect(not ok and why == "already_charging")
		c:handleAttack("a", prim(fwd, "Release"), 0.2)
		local ok2, why2 = c:handleAttack("a", prim(fwd, "Press"), 0.4)
		T.expect(not ok2 and why2 == "on_cooldown")
		T.expectEqual(nBalls(c, "a"), 1)
	end)
	T.it("발사 간격 0.6초: 연타는 거부되고 추가 볼이 생기지 않는다", function()
		local c = setup({ a = "SUPERBALL" })
		T.expect((c:handleAttack("a", prim(), 0)))
		for i = 1, 10 do
			local ok = c:handleAttack("a", prim(), 0.05 * i)
			T.expect(not ok)
		end
		T.expectEqual(nBalls(c, "a"), 1)
		T.expect((c:handleAttack("a", prim(), 0.6)))
	end)
	T.it("충전 중 이동 속도 80%, 던지면 해제", function()
		local c = setup({ a = "SUPERBALL" })
		c:handleAttack("a", prim(fwd, "Press"), 0)
		T.expect(math.abs(c:getMoveSpeed("a", 0.1) - Config.Movement.WalkSpeed * 0.8) < 1e-6)
		c:handleAttack("a", prim(fwd, "Release"), 0.5)
		T.expect(c:getMoveSpeed("a", 0.6) > Config.Movement.WalkSpeed * 0.85)
	end)
	T.it("충전 중 사망: 충전 취소 → 부활 후 Release 는 not_charging", function()
		local c, core = setup({ a = "SUPERBALL", k = "SWORD" })
		c:handleAttack("a", prim(fwd, "Press"), 0)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 0.2)
		local ok, why = c:handleAttack("a", prim(fwd, "Release"), 0.3)
		T.expect(not ok and why == "dead")
		c:respawn("a", 5)
		local ok2, why2 = c:handleAttack("a", prim(fwd, "Release"), 5.5)
		T.expect(not ok2 and why2 == "not_charging")
		T.expectEqual(nBalls(c, "a"), 0)
	end)
	T.it("부활 보호: Press·거부는 해제하지 않고, 실제로 던질 때 해제", function()
		local c = setup({ a = "SUPERBALL" })
		c:respawn("a", 0)
		c:handleAttack("a", prim(fwd, "Release"), 0.1) -- 거부
		T.expect(c:isProtected("a", 0.15))
		c:handleAttack("a", prim(fwd, "Press"), 0.2)
		T.expect(c:isProtected("a", 0.25))
		T.expect((c:handleAttack("a", prim(fwd, "Release"), 0.3)))
		T.expect(not c:isProtected("a", 0.35))
	end)
	T.it("사망한 플레이어의 던지기·Press 는 거부", function()
		local c, core = setup({ a = "SUPERBALL", k = "SWORD" })
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 0)
		local ok = c:handleAttack("a", prim(), 0.1)
		T.expect(not ok)
		local ok2 = c:handleAttack("a", prim(fwd, "Press"), 0.1)
		T.expect(not ok2)
		T.expectEqual(nBalls(c, "a"), 0)
	end)
end)

-- ── 볼 비행·튕김·충돌 ───────────────────────────────────────
T.describe("SUPERBALL 볼 비행·튕김·충돌", function()
	local function bounces(events) return count(events, "BallBounce", function(e) return not e.onTarget end) end
	T.it("일반 볼은 지형에서 최대 2번 튕기고 세 번째 접촉에서 사라진다", function()
		local c, _, _, events = setup({ a = "SUPERBALL" }, { planes = { wallZ(30, -1), wallZ(-30, 1) } })
		c:handleAttack("a", prim(), 0)
		run(c, 0, 4)
		T.expectEqual(bounces(events), 2)
		local ended = {}
		for _, e in events do if e.type == "BallEnd" then table.insert(ended, e) end end
		T.expectEqual(#ended, 1)
		T.expectEqual(ended[1].reason, "World")
	end)
	T.it("충전 볼은 최대 3번 튕긴다", function()
		local c, _, _, events = setup({ a = "SUPERBALL" }, { planes = { wallZ(30, -1), wallZ(-30, 1) } })
		c:handleAttack("a", prim(fwd, "Press"), 0)
		c:handleAttack("a", prim(fwd, "Release"), 1.0)
		run(c, 1.0, 6)
		T.expectEqual(bounces(events), 3)
	end)
	T.it("수명: 일반 5초, 충전 6초 뒤 소멸(빈 월드)", function()
		local c, _, _, events = setup({ a = "SUPERBALL" })
		c:handleAttack("a", prim(), 0)
		run(c, 0, 5.2)
		local e1
		for _, e in events do if e.type == "BallEnd" then e1 = e end end
		T.expect(e1 and e1.reason == "Expired" and math.abs(e1.time - 5) < 1e-6)
		T.expectEqual(nBalls(c, "a"), 0)
		local c2, _, _, ev2 = setup({ a = "SUPERBALL" })
		c2:handleAttack("a", prim(fwd, "Press"), 0)
		c2:handleAttack("a", prim(fwd, "Release"), 1)
		run(c2, 1, 6.9)
		T.expectEqual(nBalls(c2, "a"), 1)
		run(c2, 6.9, 7.2)
		T.expectEqual(nBalls(c2, "a"), 0)
	end)
	T.it("벽 뒤의 적은 맞지 않는다(벽에서 튕겨 돌아온다)", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" }, { planes = { wallZ(25, -1) } })
		pos.b = v(0, 1.5, 40)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 3)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("중력이 있는 실제 데이터: 바닥에서 튕긴다(공중 포물선 → 바닥 충돌)", function()
		local c, _, _, events = setup({ a = "SUPERBALL" }, { planes = { { point = v(0, 0, 0), normal = v(0, 1, 0) } }, chars = Characters })
		c:handleAttack("a", prim(), 0)
		run(c, 0, 0.6)
		T.expect(bounces(events) >= 1)
	end)
	T.it("적 몸에 맞아 튕기는 것은 지형 튕김 횟수를 쓰지 않는다", function()
		local c, _, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		pos.b = v(0, 1.5, 20)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 0.5)
		local b = balls(c, "a")[1]
		T.expectEqual(b.bouncesLeft, 2)
		T.expectEqual(b.bounces, 0)
		T.expect(b.stage >= 1)
	end)
	T.it("서로 다른 비행 단계에서는 같은 적을 다시 맞힐 수 있다(벽 반사 후 재적중)", function()
		local c, core, pos, _, _, dmg = setup({ a = "SUPERBALL", b = "SUPERBALL" }, { planes = { wallZ(-10, 1) } })
		pos.b = v(0, 1.5, 15)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 4)
		T.expect(#dmg >= 2)
		T.expectEqual(lost(core, "b") % 18, 0)
		T.expect(lost(core, "b") >= 36)
	end)
	T.it("BallService: 한 비행 단계에서 겹쳐 있는 동안 같은 대상은 한 번만 피해", function()
		local core = Core.new(Config)
		core:addPlayer("a", "SUPERBALL", 100)
		core:addPlayer("b", "SUPERBALL", 100)
		local svc = BallService.new({
			config = Config, damage = core.damage, targets = function() return { { id = "b", pos = v(0, 0, 0), radius = 2.5, alive = true } } end,
			world = H.fakeWorld({}), getPose = function() return { pos = v(0, 0, -50) } end,
		})
		svc:spawn({ owner = "a", pos = v(0, 0, 0.5), dir = v(0, 0, 1), speed = 1, radius = 0.6, damage = 18, bounces = 2, lifetime = 2, now = 0 })
		for i = 1, 40 do svc:step(i * 0.05) end
		T.expectEqual(core.damage:getMaxHealth("b") - core.damage:getHealth("b"), 18)
	end)
	T.it("회피 무적·부활 보호 중인 대상은 맞지 않고 볼은 튕기지 않는다", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		pos.b = v(0, 1.5, 20)
		c:respawn("b", 0)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 0.6)
		T.expectEqual(lost(core, "b"), 0)
		T.expectEqual(balls(c, "a")[1].stage, 0)
	end)
	T.it("패링: 전방 패링 창에서 막히면 볼이 사라지고 피해 없음", function()
		local c, core, pos, _, _, _, face = setup({ a = "SUPERBALL", b = "SWORD" })
		pos.b = v(0, 1.5, 20)
		face.b = v(0, 0, -1)
		c:handleAttack("a", prim(), 0)
		c:handleAttack("b", sec(), 0.05)
		run(c, 0.05, 1)
		T.expectEqual(lost(core, "b"), 0)
		T.expectEqual(nBalls(c, "a"), 0)
	end)
	T.it("소유자는 자기 볼에 맞지 않는다(되돌아와도 피해 0)", function()
		local c, core = setup({ a = "SUPERBALL" }, { planes = { wallZ(10, -1) } })
		c:handleAttack("a", prim(), 0)
		run(c, 0, 2)
		T.expectEqual(lost(core, "a"), 0)
	end)
