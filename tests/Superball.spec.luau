-- ── 패시브 Trick Master ─────────────────────────────────────
T.describe("SUPERBALL Passive — Trick Master (튕김 뒤 적중 시 쿨타임 0.5초, 재발동 1초)", function()
	local function ball(c, extra)
		local b = { owner = "a", life = impl(c)._life.a or 0, bounces = 1 }
		for k, val in extra or {} do b[k] = val end
		return b
	end
	local function hit(c, b, t, tid) impl(c):_onBallHit(b, tid or "b", { applied = true }, t) end
	T.it("유효 적중: 남은 쿨타임이 가장 긴 스킬 1개만 0.5초 감소", function()
		local c, core = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		core.cooldown:start("a", "skill1", 9, 0)
		core.cooldown:start("a", "skill2", 12, 0)
		core.cooldown:start("a", "skill3", 8, 0)
		hit(c, ball(c), 1)
		T.expect(math.abs(core.cooldown:readyAt("a", "skill2") - 11.5) < 1e-9)
		T.expectEqual(core.cooldown:readyAt("a", "skill1"), 9)
		T.expectEqual(core.cooldown:readyAt("a", "skill3"), 8)
	end)
	T.it("1초 재발동 제한: 1초 안의 두 번째 유효 적중은 감소 없음, 1초 뒤에는 다시 발동", function()
		local c, core = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		core.cooldown:start("a", "skill2", 12, 0)
		hit(c, ball(c), 1)
		hit(c, ball(c), 1.99)
		T.expect(math.abs(core.cooldown:readyAt("a", "skill2") - 11.5) < 1e-9)
		hit(c, ball(c), 2.0)
		T.expect(math.abs(core.cooldown:readyAt("a", "skill2") - 11.0) < 1e-9)
	end)
	T.it("최대 감소량: 남은 쿨타임이 0.5초보다 적으면 그만큼만, 0 아래로 내려가지 않는다", function()
		local c, core = setup({ a = "SUPERBALL" })
		core.cooldown:start("a", "skill1", 9, 0)
		hit(c, ball(c), 8.8)
		T.expect(math.abs(core.cooldown:readyAt("a", "skill1") - 9) < 1e-9 or core.cooldown:readyAt("a", "skill1") >= 8.8)
		T.expect(core.cooldown:remaining("a", "skill1", 8.8) >= 0)
	end)
	T.it("줄일 스킬이 없으면 발동도 잠금도 일어나지 않는다", function()
		local c, core = setup({ a = "SUPERBALL" })
		hit(c, ball(c), 1)
		core.cooldown:start("a", "skill2", 12, 1.1)
		hit(c, ball(c), 1.2)
		T.expect(math.abs(core.cooldown:readyAt("a", "skill2") - 13.1 + 0.5) < 1e-9)
	end)
	T.it("무효 조건: 튕기지 않은 볼·피해 미적용·자기 자신·이전 생애·사망·캐릭터 변경", function()
		local c, core = setup({ a = "SUPERBALL", b = "SUPERBALL", k = "SWORD" })
		core.cooldown:start("a", "skill2", 12, 0)
		local before = core.cooldown:readyAt("a", "skill2")
		hit(c, ball(c, { bounces = 0 }), 1)
		impl(c):_onBallHit(ball(c), "b", { applied = false }, 1)
		hit(c, ball(c), 1, "a")
		hit(c, ball(c, { life = 99 }), 1)
		T.expectEqual(core.cooldown:readyAt("a", "skill2"), before)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 1)
		hit(c, ball(c), 1.1)
		T.expectEqual(core.cooldown:readyAt("a", "skill2"), before)
	end)
	T.it("통합: 벽에서 튕긴 볼이 적을 맞히면 실제로 쿨타임이 줄어든다", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" }, { planes = { wallZ(-10, 1) } })
		pos.b = v(0, 1.5, 15)
		core.cooldown:start("a", "skill2", 100, 0)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 4)
		local trick = 0
		for _, e in core.cooldown._ready.a and {} or {} do trick += 1 end
		T.expect(core.cooldown:readyAt("a", "skill2") < 100)
	end)
	T.it("튕기지 않고 맞힌 첫 적중은 쿨타임을 줄이지 않는다", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		pos.b = v(0, 1.5, 20)
		core.cooldown:start("a", "skill2", 100, 0)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 3)
		T.expectEqual(core.cooldown:readyAt("a", "skill2"), 100)
	end)
end)

