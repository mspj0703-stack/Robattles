		T.expect(lost(core, "b") >= 12)
	end)
	T.it("12초 뒤 종료: 모든 궁극기 볼(발사된 것 포함)이 사라지고 일반 볼은 유지", function()
		local c, core = setup({ a = "SUPERBALL" })
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0)
		c:handleAttack("a", prim(), 0.1)
		run(c, 0, 11.9)
		T.expect(nBalls(c, "a") >= 9)
		run(c, 11.9, 12.2)
		T.expectEqual(#balls(c, "a", isUlt), 0)
		T.expect(not c:getHudSnapshot("a", 12.2).ultimate.active)
	end)
	T.it("사망하면 즉시 종료·정리, 사망 중 LMB 거부", function()
		local c, core = setup({ a = "SUPERBALL", k = "SWORD" })
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 1)
		T.expectEqual(nBalls(c, "a"), 0)
		T.expect(not (c:handleAttack("a", prim(), 1.1)))
	end)
	T.it("궁극기 중복 발동 거부(게이지 추가 소모 없음)", function()
		local c, core = setup({ a = "SUPERBALL" })
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0)
		fill(core, "a")
		local g = core.ultimate:getGauge("a")
		local ok = c:handleUltimate("a", { aimDirection = fwd }, 1)
		T.expect(not ok)
		T.expectEqual(core.ultimate:getGauge("a"), g)
		T.expectEqual(#balls(c, "a", isUlt), 10)
	end)
	T.it("충전 중 궁극기: 충전은 취소되고 이후 Release 는 not_charging", function()
		local c, core = setup({ a = "SUPERBALL" })
		c:handleAttack("a", prim(fwd, "Press"), 0)
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0.2)
		local ok, why = c:handleAttack("a", prim(fwd, "Release"), 0.4)
		T.expect(not ok and why == "not_charging")
	end)
	T.it("어떤 시점에도 볼 총량은 12를 넘지 않는다(스팸 입력)", function()
		local c, core = setup({ a = "SUPERBALL" })
		fill(core, "a")
		local t = 0
		for i = 1, 200 do
			t += 0.05
			if i == 40 then c:handleUltimate("a", { aimDirection = fwd }, t) end
			c._core.cooldown:clearEntity("a")
			if i % 3 == 0 then c:handleSkill("a", skill(2), t) elseif i % 3 == 1 then c:handleSkill("a", skill(1), t) else c:handleAttack("a", prim(), t) end
			c:update(t, 0.05)
			T.expect(nBalls(c, "a") <= 12, "i=" .. i)
		end
	end)
end)

-- ── 보안·상태 정리·동시 사용 ─────────────────────────────────
T.describe("SUPERBALL 보안·상태 정리", function()
	local function router(c, core, pos)
		local gate = Gate.new({
			cooldown = core.cooldown,
			getState = function(id) return { alive = core.damage:isAlive(id), pos = pos[id], serverTime = 0, character = Characters.SUPERBALL } end,
		})
		return Router.new({ gate = gate, controller = c })
	end
	T.it("라우터 경유: Press/Release 정상, 위조 phase 는 스키마 거부", function()
		local c, core, pos = setup({ a = "SUPERBALL" })
		local r = router(c, core, pos)
		local p = { action = "Primary", phase = "Press", aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 1), clientTime = 0 }
		T.expect((r:dispatch("a", "Attack", p, 0)))
		p.phase = "Release"
		T.expect((r:dispatch("a", "Attack", p, 0.5)))
		p.phase = "Bogus"
		T.expect(not (r:dispatch("a", "Attack", p, 0.6)))
		T.expectEqual(nBalls(c, "a"), 1)
	end)
	T.it("캐릭터 변경 후 리스폰: 이전 볼·충전·궁극기 모두 정리", function()
		local c, core = setup({ a = "SUPERBALL", k = "SWORD" })
		c:handleAttack("a", prim(), 0)
		c:handleAttack("a", prim(fwd, "Press"), 0.7)
		c:selectCharacter("a", "SWORD")
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 1)
		c:respawn("a", 5)
		T.expectEqual(c:getCharacterId("a"), "SWORD")
		T.expectEqual(nBalls(c, "a"), 0)
	end)
	T.it("퇴장 시 모든 볼 정리", function()
		local c, _, _, events = setup({ a = "SUPERBALL" })
		c:handleSkill("a", skill(2), 0)
		c:removePlayer("a", 0.1)
		local spawned, ended = 0, 0
		for _, e in events do
			if e.type == "BallSpawn" then spawned += 1 elseif e.type == "BallEnd" then ended += 1 end
		end
		T.expectEqual(spawned, ended)
	end)
	T.it("사망해도 이미 던진 볼은 남지 않는다(사망 시 정리, 서버·클라이언트 일치)", function()
		local c, core, _, events = setup({ a = "SUPERBALL", k = "SWORD" })
		c:handleSkill("a", skill(1), 0)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 0.5)
		T.expectEqual(nBalls(c, "a"), 0)
		T.expectEqual(count(events, "BallSpawn"), count(events, "BallEnd"))
	end)
	T.it("동시 사용: 두 SUPERBALL 의 볼은 소유자별로 독립(각자 총량 12, 피해 귀속 정확)", function()
		local c, core, pos = setup({ a = "SUPERBALL", b = "SUPERBALL" })
		pos.a = v(0, 0, 0)
		pos.b = v(0, 1.5, 12)
		c:handleSkill("a", skill(2), 0)
		c:handleSkill("b", skill(2), 0)
		T.expectEqual(nBalls(c, "a"), 5)
		T.expectEqual(nBalls(c, "b"), 5)
		for _, b in balls(c, "b") do T.expectEqual(b.owner, "b") end
	end)
	T.it("기존 캐릭터 회귀: SWORD·PAINTBALL 의 최대 체력과 동작은 그대로", function()
		local c, core = setup({ s = "SWORD", p = "PAINTBALL" })
		T.expectEqual(core.damage:getMaxHealth("s"), 110)
		T.expectEqual(core.damage:getMaxHealth("p"), 95)
		T.expect((c:handleAttack("p", prim(), 0)))
		T.expect((c:handleAttack("s", prim(), 0)))
	end)
	T.it("서버 전체가 보내는 모든 SUPERBALL 큐 이름이 카탈로그에 있다(실제 이벤트 수집)", function()
		local c, core, pos, events = setup({ a = "SUPERBALL", b = "SUPERBALL" }, { movement = true, planes = { wallZ(30, -1) } })
		pos.b = v(0, 1.5, 12)
		c:handleAttack("a", prim(fwd, "Press"), 0)
		c:handleAttack("a", prim(fwd, "Release"), 1)
		c:handleAttack("a", sec(), 1.1)
		c:handleSkill("a", skill(1), 1.2)
		c:handleSkill("a", skill(2), 1.3)
		run(c, 1.3, 2.5)
		c:handleSkill("a", skill(3), 2.5)
		fill(core, "a")
		core.cooldown:clearEntity("a")
		c:handleUltimate("a", { aimDirection = fwd }, 3)
		c:handleAttack("a", prim(), 3.1)
		run(c, 3.1, 16)
		local n = 0
		for _, e in events do
			if e.type == "CharSkill" then
				n += 1
				T.expect(Catalog.Cues[e.cue] ~= nil, "카탈로그에 없는 큐: " .. tostring(e.cue))
			end
		end
		T.expect(n >= 8)
	end)
end)

-- ── 클라이언트 순수 로직 ────────────────────────────────────
T.describe("SUPERBALL 클라이언트 순수 로직", function()
	T.it("InputState: 충전 주무기는 LMB 누름=Press, 뗌=Release, 포커스 상실 시에도 Release", function()
		local input = InputState.new()
		input:setCharacter("SUPERBALL", false, false, true)
		local down = input:press("MouseButton1", 0)
		T.expect(down[1].remote == "Attack" and down[1].phase == "Press" and down[1].action == "Primary")
		local up = input:release("MouseButton1")
		T.expect(up[1].remote == "Attack" and up[1].phase == "Release")
		input:press("MouseButton1", 1)
		local lostFocus = input:releaseAll()
		T.expect(lostFocus[1] and lostFocus[1].phase == "Release")
		input:setCharacter("SWORD", false, false, false)
		local d2 = input:press("MouseButton1", 2)
		T.expect(d2[1].phase == nil)
		T.expectEqual(#input:release("MouseButton1"), 0)
	end)
	T.it("EffectsModel: BallSpawn → 볼 큐(속도/방향), Bounce/Mode → 갱신 큐, End → 제거", function()
		local sp = EffectsModel.translate({ type = "BallSpawn", ballId = "bl1", ownerId = 1, pos = v(0, 1.5, 0), vel = v(0, 0, 75), gravity = 28, radius = 0.6, lifetime = 5, mode = "Fly", time = 10 }, 1)
		T.expect(sp[1].cue == "ball.projectile" and sp[1].speed == 75 and sp[1].dir.Z == 1 and sp[1].mine)
		local bn = EffectsModel.translate({ type = "BallBounce", ballId = "bl1", pos = v(0, 1, 30), vel = v(0, 5, -60), time = 10.4 }, 1)
		T.expect(bn[1].cue == "ball.update" and bn[2].cue == "ball.bounce")
		local en = EffectsModel.translate({ type = "BallEnd", ballId = "bl1", pos = v(0, 0, 0), reason = "Expired" }, 1)
		T.expect(en[1].cue == "projectile.end" and en[1].projectileId == "bl1")
	end)
	T.it("EffectsModel.ballPosition: 포물선·귀환·공전", function()
		local fly = EffectsModel.ballCue("ball.projectile", { ballId = "x", ownerId = 1, pos = v(0, 10, 0), vel = v(0, 0, 50), gravity = 20, lifetime = 5, time = 0 }, 1)
		local p = EffectsModel.ballPosition(fly, 1, nil)
		T.expect(math.abs(p.Z - 50) < 1e-9 and math.abs(p.Y - 0) < 1e-9)
		T.expect(EffectsModel.ballPosition(fly, 5.5, nil) == nil)
		local ret = EffectsModel.ballCue("ball.update", { ballId = "x", ownerId = 1, pos = v(30, 1.5, 0), vel = v(-1, 0, 0), speed = 10, mode = "Return", time = 0 }, 1)
		local q = EffectsModel.ballPosition(ret, 1, v(0, 0, 0))
		T.expect(q.X < 30 and q.X > 15)
		local orb = EffectsModel.ballCue("ball.projectile", { ballId = "o", ownerId = 1, pos = v(4, 1.5, 0), vel = v(0, 0, 0), mode = "Orbit", orbit = { phase = 0, omega = math.pi, startAt = 0, radius = 4, height = 1.5 }, time = 0 }, 1)
		local o = EffectsModel.ballPosition(orb, 1, v(10, 0, 0))
		T.expect(math.abs(o.X - 6) < 1e-6 and math.abs(o.Y - 1.5) < 1e-9)
	end)
	T.it("HUD: 스킬 3칸·보조(대시) 쿨·볼 수·충전 비율·최대 체력 100", function()
		local c = setup({ a = "SUPERBALL" })
		c:handleAttack("a", prim(fwd, "Press"), 0)
		local snap = c:getHudSnapshot("a", 0.5)
		T.expectEqual(snap.health.max, 100)
		T.expect(snap.extra.chargeFrac and math.abs(snap.extra.chargeFrac - 0.5) < 1e-9)
		T.expectEqual(snap.extra.ballCap, 12)
		local m = HudModel.build(snap, 0.5)
		T.expect(m.skills[1].implemented and m.skills[1].name == "Rapid Bounce")
		T.expect(m.skills[3].implemented and m.skills[3].name == "Recall")
		T.expectEqual(m.healthText, "100 / 100")
		T.expect(m.passive.id == "TrickMaster")
	end)
	T.it("무기·조준선 카탈로그 등록", function()
		T.expect(Catalog.Weapons.SUPERBALL ~= nil)
		local Crosshairs = Env.client("Logic/Crosshairs")
		T.expect(Crosshairs.get("SUPERBALL").style == "Ring")
	end)
end)

return true
