--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local S = Env.shared("Schema")

T.describe("Schema", function()
	T.it("number: NaN/inf/범위/정수 검사", function()
		local spec = S.number({ min = 0, max = 10 })
		T.expect((S.validate(spec, 5)))
		T.expectRejected(S.validate(spec, 0 / 0))
		T.expectRejected(S.validate(spec, math.huge))
		T.expectRejected(S.validate(spec, -1))
		T.expectRejected(S.validate(spec, 11))
		T.expectRejected(S.validate(spec, "5"))
		T.expectRejected(S.validate(S.integer(), 1.5))
	end)
	T.it("object: 알 수 없는 필드와 누락 필드 거부", function()
		local spec = S.object({ a = S.number() })
		T.expect((S.validate(spec, { a = 1 })))
		T.expectRejected(S.validate(spec, { a = 1, damage = 9999 }))
		T.expectRejected(S.validate(spec, {}))
		T.expectRejected(S.validate(spec, nil))
		T.expectRejected(S.validate(spec, 5))
	end)
	T.it("optional", function()
		local spec = S.object({ a = S.optional(S.number()) })
		T.expect((S.validate(spec, {})))
		T.expect((S.validate(spec, { a = 3 })))
		T.expectRejected(S.validate(spec, { a = "x" }))
	end)
	T.it("vector3: 단위 벡터·NaN 검사", function()
		local spec = S.vector3({ unit = true, tolerance = 0.1 })
		T.expect((S.validate(spec, { X = 0, Y = 0, Z = 1 })))
		T.expectRejected(S.validate(spec, { X = 0, Y = 0, Z = 5 }))
		T.expectRejected(S.validate(spec, { X = 0 / 0, Y = 0, Z = 1 }))
		T.expectRejected(S.validate(spec, { X = 0, Y = 0 }))
		T.expectRejected(S.validate(spec, "forward"))
	end)
	T.it("string 길이 제한 / oneOf", function()
		T.expectRejected(S.validate(S.string(3), "abcd"))
		T.expectRejected(S.validate(S.oneOf({ "A", "B" }), "C"))
		T.expect((S.validate(S.oneOf({ "A", "B" }), "A")))
	end)
	T.it("array: 길이 제한과 비배열 거부", function()
		local spec = S.array(S.number(), 2)
		T.expect((S.validate(spec, { 1, 2 })))
		T.expectRejected(S.validate(spec, { 1, 2, 3 }))
		T.expectRejected(S.validate(spec, { a = 1 }))
	end)
end)

return true
