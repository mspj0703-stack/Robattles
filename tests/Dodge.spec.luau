--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local H = require(script.Parent.Helpers)
local Dodge = Env.server("DodgeService")
local Config = Env.shared("Config")

local function fresh(cfg)
	local d = Dodge.new(cfg)
	d:register("p1")
	return d
end

T.describe("DodgeService", function()
	T.it("최대 2회, 3회째는 충전 없음", function()
		local d = fresh()
		T.expect((d:tryDodge("p1", 0)))
		T.expect((d:tryDodge("p1", 1))) -- 회피 지속시간(0.25) 이후
		local ok, reason = d:tryDodge("p1", 2)
		T.expect(not ok and reason == "no_charges")
	end)
	T.it("충전은 5초마다 1회씩 순차 회복", function()
		local d = fresh()
		d:tryDodge("p1", 0)
		d:tryDodge("p1", 1)
		T.expectEqual(d:getCharges("p1", 4.9), 0)
		T.expectEqual(d:getCharges("p1", 5), 1) -- 첫 사용 시점 기준 5초
		T.expectEqual(d:getCharges("p1", 9.9), 1)
		T.expectEqual(d:getCharges("p1", 10), 2)
		T.expectEqual(d:getCharges("p1", 100), 2) -- 최대치 초과 없음
	end)
	T.it("0.15초 무적: 시작 직후만", function()
		local d = fresh()
		d:tryDodge("p1", 10)
		T.expect(d:isInvulnerable("p1", 10))
		T.expect(d:isInvulnerable("p1", 10.149))
		T.expect(not d:isInvulnerable("p1", 10.15))
	end)
	T.it("회피 지속 중 중복 회피 거부", function()
		local d = fresh()
		d:tryDodge("p1", 0)
		local ok, reason = d:tryDodge("p1", 0.1)
		T.expect(not ok and reason == "already_dodging")
	end)
	T.it("공중 회피 허용(확정), 설정으로 끄면 거부", function()
		T.expect((fresh():tryDodge("p1", 0, { airborne = true })))
		local cfg = H.clone(Config)
		cfg.Dodge.AllowAirborne = false
		local ok, reason = fresh(cfg):tryDodge("p1", 0, { airborne = true })
		T.expect(not ok and reason == "airborne_disabled")
	end)
	T.it("행동 불가 상태에서는 회피 불가", function()
		local ok, reason = fresh():tryDodge("p1", 0, { canAct = false })
		T.expect(not ok and reason == "cannot_act")
	end)
	T.it("미등록 엔티티 거부 / reset은 충전 복구", function()
		T.expect(not (Dodge.new():tryDodge("ghost", 0)))
		local d = fresh()
		d:tryDodge("p1", 0)
		d:tryDodge("p1", 1)
		d:reset("p1")
		T.expectEqual(d:getCharges("p1", 1.1), 2)
	end)
end)
return true
