--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local K = Env.shared("Keybinds")

T.describe("Keybinds", function()
	T.it("기본 바인딩: 확정 키", function()
		local b = K.resolve(nil)
		T.expectEqual(b.CameraToggle, "V")
		T.expectEqual(b.Primary, "MouseButton1")
		T.expectEqual(b.Secondary, "MouseButton2")
		T.expectEqual(b.Reload, "R")
		T.expectEqual(b.Dodge, "LeftShift")
		T.expectEqual(b.RunToggle, "LeftControl")
		T.expectEqual(b.Ultimate, "F")
	end)
	T.it("카메라 전환키를 다른 키로 변경 가능", function()
		local b, err = K.resolve({ CameraToggle = "B" })
		T.expect(b ~= nil, err)
		T.expectEqual(b.CameraToggle, "B")
	end)
	T.it("중복 키 / 알 수 없는 액션 / 잘못된 키 이름 거부", function()
		T.expect(select(1, K.resolve({ CameraToggle = "F" })) == nil) -- Ultimate와 충돌
		T.expect(select(1, K.resolve({ Cheat = "X" })) == nil)
		T.expect(select(1, K.resolve({ CameraToggle = "../x" })) == nil)
		T.expect(select(1, K.resolve({ CameraToggle = 5 })) == nil)
		T.expect(select(1, K.resolve("bad")) == nil)
	end)
end)
return true
