--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local H = require(script.Parent.Helpers)
local Damage = Env.server("DamageService")
local Dodge = Env.server("DodgeService")
local Status = Env.server("StatusEffectService")

local function setup()
	local dodge, status = Dodge.new(), Status.new()
	local d = Damage.new({ dodge = dodge, status = status })
	for _, id in { "A", "B", "C" } do
		d:register(id)
		dodge:register(id)
	end
	return d, dodge, status
end

local function hit(attacker, target, attackId, amount, extra)
	local r = { attackerId = attacker, targetId = target, attackId = attackId, amount = amount }
	for k, v in extra or {} do
		r[k] = v
	end
	return r
end

T.describe("DamageService", function()
	T.it("기본 피해 적용과 체력 감소", function()
		local d = setup()
		local r = d:applyDamage(hit("A", "B", "a1", 14), 0)
		T.expect(r.applied)
		T.expectEqual(d:getHealth("B"), 86)
	end)
	T.it("일반 피격 무적 없음: 서로 다른 공격은 연속 적중", function()
		local d = setup()
		T.expect(d:applyDamage(hit("A", "B", "a1", 10), 0).applied)
		T.expect(d:applyDamage(hit("A", "B", "a2", 10), 0).applied)
		T.expect(d:applyDamage(hit("C", "B", "c1", 10), 0).applied)
		T.expectEqual(d:getHealth("B"), 70)
	end)
	T.it("동일 attackId 중복 피해 방지", function()
		local d = setup()
		T.expect(d:applyDamage(hit("A", "B", "a1", 10), 0).applied)
		local r = d:applyDamage(hit("A", "B", "a1", 10), 0.01)
		T.expect(not r.applied and r.reason == "duplicate_hit")
		T.expectEqual(d:getHealth("B"), 90)
		T.expect(d:applyDamage(hit("A", "C", "a1", 10), 0.01).applied) -- 다른 대상은 허용
	end)
	T.it("rehitInterval이 있으면 간격 후 재적중 허용", function()
		local d = setup()
		T.expect(d:applyDamage(hit("A", "B", "beam", 5, { rehitInterval = 0.25 }), 0).applied)
		T.expect(not d:applyDamage(hit("A", "B", "beam", 5, { rehitInterval = 0.25 }), 0.1).applied)
		T.expect(d:applyDamage(hit("A", "B", "beam", 5, { rehitInterval = 0.25 }), 0.25).applied)
	end)
	T.it("회피 무적 중 피해 무효, 무적 종료 후 적중 가능(기록 안 남음)", function()
		local d, dodge = setup()
		dodge:tryDodge("B", 10)
		local r = d:applyDamage(hit("A", "B", "a1", 10), 10.1)
		T.expect(not r.applied and r.reason == "invulnerable")
		T.expect(d:applyDamage(hit("A", "B", "a1", 10), 10.2).applied)
	end)
	T.it("사망한 대상 / 미등록 대상 / 자기 피해 거부", function()
		local d = setup()
		d:applyDamage(hit("A", "B", "a1", 999), 0)
		T.expectEqual(d:getHealth("B"), 0)
		T.expect(d:applyDamage(hit("A", "B", "a2", 5), 1).reason == "target_dead")
		T.expect(d:applyDamage(hit("A", "Z", "a3", 5), 1).reason == "unknown_target")
		T.expect(d:applyDamage(hit("A", "A", "a4", 5), 1).reason == "self_damage")
		T.expect(d:applyDamage(hit("A", "A", "a5", 5, { allowSelf = true }), 1).applied)
	end)
	T.it("비정상 피해량(NaN/음수/0/inf) 거부, 과도한 값은 상한으로 제한", function()
		local d = setup()
		for _, bad in { 0 / 0, -5, 0, math.huge, "10" } do
			T.expect(not d:applyDamage(hit("A", "B", "x" .. tostring(bad), bad), 0).applied)
		end
		d:register("tank", 1000)
		local r = d:applyDamage(hit("A", "tank", "big", 5000), 0)
		T.expectEqual(r.dealt, 200)
	end)
	T.it("잘못된 요청 구조 거부", function()
		local d = setup()
		T.expect(d:applyDamage(nil, 0).reason == "bad_request")
		T.expect(d:applyDamage({ targetId = "B", amount = 5 }, 0).reason == "bad_request")
	end)
	T.it("동일 공격자 연쇄 폭발 감쇠 (×0.5, 최소 ×0.25)", function()
		local d = setup()
		d:register("T", 1000)
		local dealt = {}
		for i = 1, 4 do
			local r = d:applyDamage(hit("A", "T", "boom" .. i, 40, { kind = "Explosion" }), i * 0.1)
			table.insert(dealt, r.dealt)
		end
		T.expectEqual(dealt[1], 40)
		T.expectEqual(dealt[2], 20)
		T.expectEqual(dealt[3], 10)
		T.expectEqual(dealt[4], 10) -- 최소 배율 0.25
	end)
	T.it("다른 공격자의 폭발은 감쇠 영향 없음, 윈도우 경과 시 초기화", function()
		local d = setup()
		d:register("T", 1000)
		d:applyDamage(hit("A", "T", "b1", 40, { kind = "Explosion" }), 0)
		T.expectEqual(d:applyDamage(hit("C", "T", "b2", 40, { kind = "Explosion" }), 0.1).dealt, 40)
		T.expectEqual(d:applyDamage(hit("A", "T", "b3", 40, { kind = "Explosion" }), 5).dealt, 40)
	end)
	T.it("처치 이벤트와 체력 0 고정", function()
		local d = setup()
		local kills = {}
		d:onKilled(function(e)
			table.insert(kills, e)
		end)
		local r = d:applyDamage(hit("A", "B", "a1", 150), 0)
		T.expect(r.killed and r.dealt == 100)
		T.expectEqual(#kills, 1)
		T.expectEqual(kills[1].attackerId, "A")
		T.expect(not d:isAlive("B"))
	end)
	T.it("피해 적용 시 상태이상 동시 적용 (강한 공격만 경직)", function()
		local d, _, status = setup()
		local r = d:applyDamage(hit("A", "B", "a1", 5, { effects = { { type = "Slow", multiplier = 0.6, duration = 2 }, { type = "Stagger", duration = 0.3 } } }), 0)
		T.expect(r.effects[1].ok)
		T.expect(not r.effects[2].ok) -- 기본 공격
		T.expectEqual(status:getSpeedMultiplier("B", 0.5), 0.6)
		local r2 = d:applyDamage(hit("A", "C", "a2", 5, { strong = true, effects = { { type = "Stagger", duration = 0.3 } } }), 0)
		T.expect(r2.effects[1].ok)
	end)
	T.it("prune: 오래된 중복 기록 정리 후 같은 attackId 재사용 가능", function()
		local d = setup()
		d:applyDamage(hit("A", "B", "a1", 1), 0)
		d:prune(100)
		T.expect(d:applyDamage(hit("A", "B", "a1", 1), 100).applied)
	end)
	T.it("respawn: 체력 복구 후 다시 피해 가능", function()
		local d = setup()
		d:applyDamage(hit("A", "B", "a1", 999), 0)
		d:respawn("B")
		T.expectEqual(d:getHealth("B"), 100)
		T.expect(d:applyDamage(hit("A", "B", "a2", 5), 1).applied)
	end)
end)
return true
