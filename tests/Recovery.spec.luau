--!nonstrict
local T=require(script.Parent.TestRunner)
local Env=require(script.Parent.Env)
local Damage=Env.server("DamageService")
local Recovery=Env.server("RecoveryService")
T.describe("RecoveryService",function()
  local function setup()
    local d=Damage.new()
    for _,id in {"A","B","C"} do d:register(id,100) end
    local r=Recovery.new(d)
    for _,id in {"A","B","C"} do r:spawn(id,0) end
    return d,r
  end
  T.it("KO awards 20 but cannot exceed max, multi KO within 1.5s once",function()
    local d,r=setup()
    d:applyDamage({attackerId="B",targetId="A",attackId="damage",amount=40},1)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="B",now=2}),20)
    T.expectEqual(d:getHealth("A"),80)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="C",now=2.2}),0)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="C",now=3.6}),20)
    T.expectEqual(d:getHealth("A"),100)
  end)
  T.it("dead attacker and suicide get no healing",function()
    local d,r=setup()
    d:forceKill("A",1)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="B",now=2}),0)
    T.expectEqual(r:confirmedKo({attackerId="B",targetId="B",now=2}),0)
  end)
  T.it("regen waits six seconds from last attack or damage and is frame-independent",function()
    local d,r=setup()
    d:applyDamage({attackerId="B",targetId="A",attackId="damage",amount=50},1)
    r:activity("A",2)
    r:tick(7,true);T.expectEqual(d:getHealth("A"),50)
    r:tick(8,true);T.expectEqual(d:getHealth("A"),50)
    r:tick(9,true);T.expectEqual(d:getHealth("A"),56)
    r:activity("A",9.1)
    r:tick(20,false);T.expectEqual(d:getHealth("A"),56)
  end)
  T.it("recent credited fall expires after five seconds",function()
    local d,r=setup()
    d:applyDamage({attackerId="B",targetId="A",attackId="damage",amount=10},1)
    r:damaged({attackerId="B",targetId="A",dealt=10,now=1})
    T.expectEqual(r:recentAttacker("A",6),"B")
    T.expectEqual(r:recentAttacker("A",6.1),nil)
    r:reset();T.expectEqual(r:recentAttacker("A",2),nil)
  end)
  T.it("KO throttle closes before 1.5s and opens at exactly 1.5s",function()
    local d,r=setup()
    d:applyDamage({attackerId="B",targetId="A",attackId="hit",amount=90},1)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="B",now=2}),20)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="C",now=3.499}),0)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="C",now=3.5}),20)
    T.expectEqual(d:getHealth("A"),50)
  end)
  T.it("actual hit delays regeneration for attacker and target; non-active never heals",function()
    local d,r=setup()
    d:applyDamage({attackerId="B",targetId="A",attackId="hit",amount=40},1)
    r:damaged({attackerId="B",targetId="A",dealt=40,now=1})
    r:tick(6.9,true);T.expectEqual(d:getHealth("A"),60)
    r:tick(8,true);T.expectEqual(d:getHealth("A"),66)
    r:activity("A",8.5) -- accepted miss or skill still cancels regeneration
    r:tick(14.5,true);T.expectEqual(d:getHealth("A"),66)
    r:tick(15.5,false);T.expectEqual(d:getHealth("A"),66)
    r:tick(15.6,true);T.expect(math.abs(d:getHealth("A")-66.6)<1e-6)
  end)
  T.it("death never regenerates; new spawn and reset drop old KO throttle and fall attribution",function()
    local d,r=setup()
    r:damaged({attackerId="B",targetId="A",dealt=10,now=1})
    d:forceKill("A",2)
    r:tick(100,true);T.expectEqual(d:getHealth("A"),0)
    d:respawn("A");r:spawn("A",100)
    T.expectEqual(r:recentAttacker("A",100),nil)
    T.expectEqual(d:getHealth("A"),100)
    d:heal("A",-20);T.expectEqual(d:getHealth("A"),100)
    r:confirmedKo({attackerId="A",targetId="B",now=101})
    r:reset();r:spawn("A",102)
    T.expectEqual(r:confirmedKo({attackerId="A",targetId="C",now=102}),0) -- full health
  end)
  T.it("last successful enemy hit owns 5-second fall credit and disconnect erases it",function()
    local d,r=setup()
    r:damaged({attackerId="B",targetId="A",dealt=10,now=1})
    r:damaged({attackerId="C",targetId="A",dealt=0,now=2})
    T.expectEqual(r:recentAttacker("A",5.999),"B")
    r:damaged({attackerId="C",targetId="A",dealt=5,now=5.5})
    T.expectEqual(r:recentAttacker("A",10.5),"C")
    r:remove("C")
    T.expectEqual(r:recentAttacker("A",10.5),nil)
  end)
end)

return true
