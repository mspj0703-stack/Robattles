--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local R = Env.shared("RemoteSpec")

local fwd = { X = 0, Y = 0, Z = 1 }
local origin = { X = 10, Y = 3, Z = -4 }

T.describe("RemoteSpec: 비정상 RemoteEvent 입력 거부", function()
	T.it("정상 Attack 페이로드 통과", function()
		local ok, err = R.validate("Attack", { action = "Primary", aimOrigin = origin, aimDirection = fwd, clientTime = 12.5 })
		T.expect(ok, err)
	end)
	T.it("피해량을 실어 보내면 거부 (알 수 없는 필드)", function()
		T.expectRejected(R.validate("Attack", { action = "Primary", aimOrigin = origin, aimDirection = fwd, clientTime = 1, damage = 9999 }))
	end)
	T.it("명중 대상을 실어 보내면 거부", function()
		T.expectRejected(R.validate("Attack", { action = "Primary", aimOrigin = origin, aimDirection = fwd, clientTime = 1, hitTargets = { "Player2" } }))
	end)
	T.it("알 수 없는 action 거부", function()
		T.expectRejected(R.validate("Attack", { action = "InstantKill", aimOrigin = origin, aimDirection = fwd, clientTime = 1 }))
	end)
	T.it("NaN / inf 방향·원점 거부", function()
		T.expectRejected(R.validate("Attack", { action = "Primary", aimOrigin = origin, aimDirection = { X = 0 / 0, Y = 0, Z = 1 }, clientTime = 1 }))
		T.expectRejected(R.validate("Attack", { action = "Primary", aimOrigin = { X = math.huge, Y = 0, Z = 0 }, aimDirection = fwd, clientTime = 1 }))
	end)
	T.it("단위 벡터가 아닌 방향 거부", function()
		T.expectRejected(R.validate("Dodge", { direction = { X = 0, Y = 0, Z = 50 } }))
	end)
	T.it("잘못된 타입 / nil / 알 수 없는 리모트 거부", function()
		T.expectRejected(R.validate("Attack", "hack"))
		T.expectRejected(R.validate("Attack", nil))
		T.expectRejected(R.validate("GiveAdmin", {}))
		T.expectRejected(R.validate(123, {}))
		T.expectRejected(R.validate("SetRun", { enabled = "yes" }))
	end)
	T.it("정상 Dodge / SetRun / Reload / Ultimate 통과", function()
		T.expect((R.validate("Dodge", { direction = fwd })))
		T.expect((R.validate("SetRun", { enabled = true })))
		T.expect((R.validate("Reload", {})))
		T.expect((R.validate("Ultimate", {})))
	end)
end)

return true
