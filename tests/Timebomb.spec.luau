		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" })
		fill(core, "a")
		T.expect((c:handleUltimate("a", { aimDirection = v(0, -0.3, 1) }, 0)))
		run(c, 0, 1)
		local land = landing(events)
		T.expect(land ~= nil)
		pos.b = v(land.pos.X, land.pos.Y + 1, land.pos.Z)
		run(c, 1, land.time + 2.9)
		T.expectEqual(lost(core, "b"), 0)
		run(c, land.time + 2.9, land.time + 3.1)
		T.expectEqual(lost(core, "b"), 70)
		local ex = ofKind(events, "BombExplode")[1]
		T.expect(ex and near(ex.time, land.time + 3, 1e-6) and ex.radius == 18 and ex.kind == "BigBang")
	end)
	T.it("가장자리 35, 반경 밖 0, 자기 피해 0", function()
		local function once(dist)
			local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" })
			fill(core, "a")
			c:handleUltimate("a", { aimDirection = v(0, -0.3, 1) }, 0)
			run(c, 0, 1)
			local land = landing(events)
			pos.a = v(land.pos.X, land.pos.Y, land.pos.Z)
			pos.b = v(land.pos.X + dist + Config.Combat.HitRadius, land.pos.Y, land.pos.Z) -- 표면 거리 = dist
			run(c, 1, land.time + 3.2)
			return lost(core, "b"), lost(core, "a")
		end
		local edge, selfLoss = once(17.99)
		T.expect(edge > 34.9 and edge < 35.6, "edge=" .. edge)
		T.expectEqual(selfLoss, 0)
		T.expectEqual((once(18.5)), 0)
		local mid = once(9)
		T.expect(near(mid, 52.5, 0.3), "mid=" .. mid)
	end)
