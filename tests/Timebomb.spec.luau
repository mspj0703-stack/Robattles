T.describe("TIMEBOMB RMB — Blast Guard (근처 적 10 + 넉백, 자기 반동 이동, 쿨 8)", function()
	T.it("근처 적 10, 먼 적 0, 자기 피해 0, 쿨 8초", function()
		local c, core, pos = setup({ a = "TIMEBOMB", b = "SWORD", d = "SWORD" })
		pos.b = v(0, 1.5, 4)
		pos.d = v(0, 1.5, 40)
		local ok = c:handleAttack("a", sec(), 0)
		T.expect(ok)
		T.expectEqual(lost(core, "b"), 10)
		T.expectEqual(lost(core, "d"), 0)
		T.expectEqual(lost(core, "a"), 0)
		T.expect(not core.cooldown:isReady("a", "secondary", 7.9))
		T.expect(core.cooldown:isReady("a", "secondary", 8))
		T.expect(not (c:handleAttack("a", sec(), 3)))
	end)
	T.it("자기 반동: 조준 반대 방향 6스터드, BlastGuard 허가와 dash 이벤트", function()
		local c, _, _, events, movement = setup({ a = "TIMEBOMB" }, { movement = true })
		c:handleAttack("a", sec(), 0)
		local ev = ofKind(events, "CharSkill", function(e) return e.cue == "bomb.guard" end)[1]
		T.expect(ev and ev.dash and ev.dash.permit == "BlastGuard")
		T.expect(near(ev.dash.speed * ev.dash.duration, 6, 1e-6))
		T.expect(ev.direction.Z < -0.99)
		T.expectEqual(movement:getPermitCount("a", 0.1), 1)
	end)
	T.it("넉백 효과가 피해 요청에 실린다(적용은 Config.Knockback.Enabled 가 켜졌을 때)", function()
		local c, core, pos = setup({ a = "TIMEBOMB", b = "SWORD" })
		pos.b = v(0, 1.5, 4)
		local seen
		core.damage:onEffect(function(e) seen = e end)
		c:handleAttack("a", sec(), 0)
		T.expect(seen ~= nil and seen.targetId == "b")
	end)
	T.it("뒤가 벽이면 반동만 생략하고 폭발(방어)은 그대로", function()
		local wall = { point = v(0, 0, -1.5), normal = v(0, 0, 1) }
		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" }, { planes = { floor, wall }, movement = true })
		pos.b = v(0, 1.5, 4)
		local ok, info = c:handleAttack("a", sec(), 0)
		T.expect(ok and info.recoil == nil)
		T.expectEqual(lost(core, "b"), 10)
	end)
	T.it("이동 허가가 거부되면 폭발·쿨타임 모두 없음", function()
		local cfg = H.clone(Config)
		cfg.MoveCheck.Permits.BlastGuard.maxSpeed = 1
		local c, core, pos = setup({ a = "TIMEBOMB", b = "SWORD" }, { movement = true, config = cfg })
		pos.b = v(0, 1.5, 4)
		c:respawn("a", 0)
		local ok, why = c:handleAttack("a", sec(), 0.1)
		T.expect(not ok and string.find(why, "movement_denied", 1, true) ~= nil)
		T.expectEqual(lost(core, "b"), 0)
		T.expect(core.cooldown:isReady("a", "secondary", 0.1))
		T.expect(c:isProtected("a", 0.2))
	end)
	T.it("벽 너머 적은 맞지 않는다", function()
		local wall = { point = v(0, 0, 2), normal = v(0, 0, -1) }
		local c, core, pos = setup({ a = "TIMEBOMB", b = "SWORD" }, { planes = { floor, wall } })
		pos.b = v(0, 1.5, 4)
		c:handleAttack("a", sec(), 0)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("Blast Guard 폭발도 7스터드 안의 자기 설치물을 연쇄 기폭한다(자기 폭탄만)", function()
		local c, _, pos, events = setup({ a = "TIMEBOMB", e = "TIMEBOMB" })
		pos.e = v(500, 1.5, 0)
		place(c, "a", 0)
		place(c, "e", 0.1)
		run(c, 0.3, 1)
		pos.a = v(0, 1.5, 10) -- 설치물 근처
		c:handleAttack("a", sec(), 1.2)
		local exploded = ofKind(events, "BombExplode")
		T.expect(#exploded == 1 and exploded[1].ownerId == "a" and exploded[1].stage == 2)
		T.expectEqual(#bombs(c, "e"), 1)
	end)
	T.it("부활 보호: 공격 행동이라 성공 시 해제, 거부 시 유지", function()
		local c = setup({ a = "TIMEBOMB" })
		c:respawn("a", 0)
		T.expect((c:handleAttack("a", sec(), 0.1)))
		T.expect(not c:isProtected("a", 0.2))
	end)
end)

-- ── 스킬 1 Cluster Bomb ─────────────────────────────────────
T.describe("TIMEBOMB Skill 1 — Cluster Bomb (18 + 자탄 4×8, 쿨 13)", function()
	T.it("본폭발 18 + 자탄 4개가 차례로 8씩 = 50, 쿨 13초", function()
		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" })
		pos.b = v(0, 1.5, 17.3) -- 본폭탄 착지 지점(1초 비행)
		T.expect((c:handleSkill("a", skill(1), 0)))
		run(c, 0, 4)
		T.expectEqual(#ofKind(events, "BombSpawn", function(e) return e.kind == "Mini" end), 4)
		local dbg = {}
		for _, e in ofKind(events, "BombExplode") do table.insert(dbg, string.format("%s t=%.2f (%.1f,%.1f,%.1f) n=%d", e.kind, e.time, e.pos.X, e.pos.Y, e.pos.Z, #e.results)) end
		T.expect(near(lost(core, "b"), 50, 1e-6), "lost=" .. lost(core, "b") .. " | " .. table.concat(dbg, " ; "))
		T.expect(not core.cooldown:isReady("a", "skill1", 12.9))
		T.expect(core.cooldown:isReady("a", "skill1", 13))
	end)
	T.it("자탄은 본폭발 이후에만 생기고 서로 0.3초보다 길게 떨어져 터진다", function()
		local c, _, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" })
		pos.b = v(0, 1.5, 12)
		c:handleSkill("a", skill(1), 0)
		run(c, 0, 4)
		local times = {}
