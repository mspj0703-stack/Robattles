		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" }, { movement = true })
		pos.b = v(0, 1.5, 11)
		place(c, "a", 0)
		run(c, 0.2, 1)
		pos.a = v(0, 1.5, 9) -- 설치물 가까이로 이동했다고 가정
		c:handleSkill("a", skill(3), 1.5)
		local ex = ofKind(events, "BombExplode")
