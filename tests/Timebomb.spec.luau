		run(c, 0, 1)
		local land = landing(events)
		local c2, core2, pos2, events2 = setup({ a = "TIMEBOMB", b = "SWORD" }, { planes = { floor, { point = v(land.pos.X, 0, land.pos.Z + 6), normal = v(0, 0, -1) } } })
		fill(core2, "a")
		c2:handleUltimate("a", { aimDirection = v(0, -0.3, 1) }, 0)
		run(c2, 0, 1)
		pos2.b = v(land.pos.X, 1.5, land.pos.Z + 9)
		run(c2, 1, 6)
		T.expectEqual(lost(core2, "b"), 0)
	end)
	T.it("지형 충돌: 벽에 부딪히면 그 자리에 떨어져 3초 뒤 폭발", function()
		local wall = { point = v(0, 0, 15), normal = v(0, 0, -1) }
		local c, core, _, events = setup({ a = "TIMEBOMB" }, { planes = { floor, wall } })
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0)
		run(c, 0, 1.5)
		local land = landing(events)
		T.expect(land.pos.Z < 15)
	end)
	T.it("Blast Jump 직후 공중에서 쓰면 더 멀리 던진다(공중이 아니거나 점프 없이면 보통)", function()
		local function throwFar(airborne, jump)
			local c, core, _, events = setup({ a = "TIMEBOMB" }, { airborne = airborne, movement = true })
			if jump then c:handleSkill("a", skill(3, v(0, 1, 0.01)), 0) end
			fill(core, "a")
			c:handleUltimate("a", { aimDirection = v(0, 0.35, 1) }, 0.5)
			run(c, 0.5, 4.5)
			return landing(events).pos.Z
		end
		local normal = throwFar(false, false)
		local far = throwFar(true, true)
		T.expect(far > normal * 1.25, "far=" .. far .. " normal=" .. normal)
		T.expect(near(throwFar(true, false), normal, 1e-6)) -- 점프 없이 공중: 보통
		T.expect(near(throwFar(false, true), normal, 1e-6)) -- 점프했지만 지금은 공중 아님: 보통
	end)
	T.it("착지하지 못해도(바닥 없음) 비행 한도 6초에 폭발", function()
		local c, core, _, events = setup({ a = "TIMEBOMB" }, { planes = {} })
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 0)
		run(c, 0, 6.2)
		local ex = ofKind(events, "BombExplode")[1]
		T.expect(ex and near(ex.time, 6, 1e-6))
	end)
	T.it("던진 뒤 죽어도 폭탄은 남아 폭발하고 피해는 소유자에게 귀속", function()
		local c, core, pos, events, _, dmg = setup({ a = "TIMEBOMB", b = "SWORD", k = "SWORD" })
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = v(0, -0.3, 1) }, 0)
		run(c, 0, 1)
		local land = landing(events)
		pos.b = v(land.pos.X, land.pos.Y + 1, land.pos.Z)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 1.1)
		run(c, 1.1, land.time + 3.2)
		T.expectEqual(lost(core, "b"), 70)
	end)
	T.it("연쇄로 조기 기폭되지 않는다(Big Bang 은 연쇄 대상이 아님)", function()
		local c, core, _, events = setup({ a = "TIMEBOMB" })
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = v(0, -0.3, 1) }, 0)
		run(c, 0, 1)
		local land = landing(events)
		local svc = impl(c).bombs
		svc:spawn({ owner = "a", kind = "Timed", pos = v(land.pos.X, 0.5, land.pos.Z + 2), now = 1, explodeAt = 1.5, explosion = { radius = 3, damage = 1 } })
		run(c, 1, 2)
		T.expectEqual(#ofKind(events, "BombExplode", function(e) return e.kind == "BigBang" end), 0)
	end)
end)

-- ── 패시브 Chain Reaction ───────────────────────────────────
T.describe("TIMEBOMB Passive — Chain Reaction (자기 폭탄 반경 7, 최초 포함 최대 3단계)", function()
	local function rig()
		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD", e = "TIMEBOMB" })
		pos.b = v(1000, 1.5, 1000)
		pos.e = v(2000, 1.5, 2000)
		return c, core, pos, events, impl(c).bombs
	end
	local function plant(svc, owner, x, explodeAt, kind)
		return svc:spawn({
			owner = owner, kind = kind or "Remote", pos = v(x, 0.4, 0), now = 0, explodeAt = explodeAt, placed = explodeAt == nil,
			explosion = { radius = 2, damage = 10, falloffMin = 1 },
		})
	end
	T.it("단계: 0 → 5 → 10 은 1·2·3단계로 터지고 15 는 4단계라 터지지 않는다", function()
		local c, _, _, events, svc = rig()
		local a0 = plant(svc, "a", 0, 1)
		local a5 = plant(svc, "a", 5)
		local a10 = plant(svc, "a", 10)
		local a15 = plant(svc, "a", 15)
		run(c, 0, 1.2)
		local ex = ofKind(events, "BombExplode")
		T.expectEqual(#ex, 3)
		T.expect(ex[1].bombId == a0.id and ex[1].stage == 1)
		T.expect(ex[2].bombId == a5.id and ex[2].stage == 2)
		T.expect(ex[3].bombId == a10.id and ex[3].stage == 3)
		T.expect(not a15.dead and svc:get(a15.id) ~= nil)
	end)
	T.it("반경 7 이내만: 7.0 은 전파, 7.1 은 전파하지 않는다", function()
		local c, _, _, events, svc = rig()
		plant(svc, "a", 0, 1)
		local near7 = plant(svc, "a", 7.0)
		local far = plant(svc, "a", -7.1)
		run(c, 0, 1.2)
		T.expect(near7.dead and not far.dead)
	end)
	T.it("다른 사람의 폭탄에는 전파되지 않는다(자기 폭탄에만)", function()
		local c, _, _, events, svc = rig()
		plant(svc, "a", 0, 1)
		local theirs = plant(svc, "e", 2)
		run(c, 0, 1.2)
		T.expect(not theirs.dead)
		T.expectEqual(#ofKind(events, "BombExplode"), 1)
	end)
	T.it("같은 폭탄은 두 번 기폭되지 않는다(서로 가까운 폭탄들)", function()
		local c, _, _, events, svc = rig()
		plant(svc, "a", 0, 1)
		plant(svc, "a", 2)
		plant(svc, "a", 4)
		plant(svc, "a", 6)
		run(c, 0, 1.2)
		local seen = {}
		for _, e in ofKind(events, "BombExplode") do
			T.expect(not seen[e.bombId], "중복 기폭: " .. e.bombId)
			seen[e.bombId] = true
		end
		T.expectEqual(#ofKind(events, "BombExplode"), 4)
	end)
	T.it("결정적 순서: 같은 입력이면 폭발 순서·단계가 항상 같다", function()
		local function trace()
			local c, _, _, events, svc = rig()
			plant(svc, "a", 0, 1); plant(svc, "a", 3); plant(svc, "a", -4); plant(svc, "a", 6); plant(svc, "a", 8)
			run(c, 0, 1.2)
			local out = {}
			for _, e in ofKind(events, "BombExplode") do table.insert(out, e.bombId .. ":" .. e.stage) end
			return table.concat(out, ",")
		end
		T.expectEqual(trace(), trace())
	end)
	T.it("원격 전체 기폭의 모든 폭탄은 1단계(서로 연쇄로 이중 처리되지 않음)", function()
		local c, _, _, events = setup({ a = "TIMEBOMB" })
		place(c, "a", 0)
		place(c, "a", 0.5, v(0.05, 0, 1))
		run(c, 0.7, 2)
		detonate(c, "a", 2)
		local ex = ofKind(events, "BombExplode")
		T.expectEqual(#ex, 2)
		T.expect(ex[1].stage == 1 and ex[2].stage == 1)
	end)
	T.it("연쇄로 같은 적을 반복해 맞히면 100% → 60% → 30% (같은 순간)", function()
		local c, core, pos, events, svc = rig()
		pos.b = v(0, 1.5, 0)
		for _, x in { 0, 3, 6 } do
			svc:spawn({
				owner = "a", kind = "Remote", pos = v(x, 0.4, 0), now = 0, explodeAt = x == 0 and 1 or nil, placed = x ~= 0,
				explosion = { radius = 20, damage = 40, falloffMin = 1 },
			})
		end
		run(c, 0, 1.2)
		T.expect(near(lost(core, "b"), 40 + 24 + 12, 1e-6), "lost=" .. lost(core, "b"))
	end)
	T.it("서로 다른 TIMEBOMB 의 폭발은 같은 적에게 각각 100%", function()
		local c, core, pos, _, _, svc = nil, nil, nil, nil, nil, nil
		local c2, core2, pos2, _, _, _ = setup({ a = "TIMEBOMB", e = "TIMEBOMB", b = "SWORD" })
		pos2.b = v(0, 1.5, 12)
		pos2.e = v(500, 1.5, 0)
		c2:handleAttack("a", prim(), 0)
		pos2.e = v(0, 1.5, -300)
		c2:handleAttack("e", prim(v(0, 0, -1)), 0)
		-- e 의 폭탄을 같은 지점에 터뜨리도록 직접 생성
		impl(c2).bombs:spawn({ owner = "e", kind = "Timed", pos = v(0, 0.4, 11), now = 0, explodeAt = 1.0, explosion = { radius = 6, damage = 20, falloffMin = 1 } })
		run(c2, 0, 1.5)
		T.expect(near(lost(core2, "b"), 40, 1e-6), "lost=" .. lost(core2, "b"))
	end)
	T.it("퇴장하면 던진 폭탄까지 모두 정리(폭발 없음)", function()
		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" })
		pos.b = v(0, 1.5, 12)
		c:handleAttack("a", prim(), 0)
		place(c, "a", 1.3)
		c:removePlayer("a", 1.5)
		run(c, 1.5, 4)
		T.expectEqual(lost(core, "b"), 0)
		T.expectEqual(#ofKind(events, "BombSpawn"), #ofKind(events, "BombEnd"))
	end)
end)

-- ── 보안·동시 사용·회귀 ─────────────────────────────────────
T.describe("TIMEBOMB 보안·동시 사용·회귀", function()
	local function router(c, core, pos)
		local gate = Gate.new({
			cooldown = core.cooldown,
			getState = function(id) return { alive = core.damage:isAlive(id), pos = pos[id], serverTime = 0, character = Characters.TIMEBOMB } end,
		})
		return Router.new({ gate = gate, controller = c })
	end
	T.it("라우터 경유: Press/Release 설치, 위조 phase 거부, 같은 Release 반복 거부", function()
		local c, core, pos = setup({ a = "TIMEBOMB" })
		local r = router(c, core, pos)
		local base = { slot = 2, aimOrigin = v(0, 0, 0), aimDirection = v(0, 0, 1), clientTime = 0 }
		base.phase = "Press"
		T.expect((r:dispatch("a", "Skill", base, 0)))
		base.phase = "Release"
		T.expect((r:dispatch("a", "Skill", base, 0.1)))
		T.expect(not (r:dispatch("a", "Skill", base, 0.15)))
		base.phase = "Bogus"
		T.expect(not (r:dispatch("a", "Skill", base, 0.2)))
		T.expectEqual(#bombs(c, "a"), 1)
	end)
	T.it("스팸 입력: 100번 Press/Release 해도 설치는 최대 2개, 폭탄 총량 상한 유지", function()
		local c, core = setup({ a = "TIMEBOMB" })
		for i = 1, 100 do
			local t = i * 0.01
			c:handleSkill("a", skill(2, fwd, "Press"), t)
			c:handleSkill("a", skill(2, fwd, "Release"), t + 0.001)
			c:handleAttack("a", prim(), t)
			T.expect(#bombs(c, "a") <= BombService.MaxPerOwner)
			T.expect(#bombs(c, "a", function(b) return b.placed end) <= 2)
		end
	end)
	T.it("동시 사용: 두 TIMEBOMB 의 충전·설치물은 서로 독립", function()
		local c = setup({ a = "TIMEBOMB", e = "TIMEBOMB" })
		place(c, "a", 0); place(c, "a", 1)
		T.expect((place(c, "e", 1.5)))
		T.expectEqual(c:getHudSnapshot("a", 2).extra.charges, 0)
		T.expectEqual(c:getHudSnapshot("e", 2).extra.charges, 1)
		T.expectEqual(#bombs(c, "a"), 2)
		T.expectEqual(#bombs(c, "e"), 1)
	end)
	T.it("기존 캐릭터 회귀: SWORD·PAINTBALL·SUPERBALL 최대 체력과 기본 동작", function()
		local c, core = setup({ s = "SWORD", p = "PAINTBALL", u = "SUPERBALL", t = "TIMEBOMB" })
		T.expectEqual(core.damage:getMaxHealth("s"), 110)
		T.expectEqual(core.damage:getMaxHealth("p"), 95)
		T.expectEqual(core.damage:getMaxHealth("u"), 100)
		T.expectEqual(core.damage:getMaxHealth("t"), 105)
		for _, id in { "s", "p", "u", "t" } do T.expect((c:handleAttack(id, prim(), 0)), id) end
	end)
	T.it("서버가 보내는 모든 TIMEBOMB 큐 이름이 카탈로그에 있다(실제 이벤트 수집)", function()
		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" }, { movement = true })
		pos.b = v(0, 1.5, 12)
		c:handleAttack("a", prim(), 0)
		c:handleAttack("a", sec(), 1.3)
		c:handleSkill("a", skill(1), 1.4)
		place(c, "a", 1.5)
		detonate(c, "a", 3)
		c:handleSkill("a", skill(3), 3.5)
		fill(core, "a")
		c:handleUltimate("a", { aimDirection = fwd }, 4)
		run(c, 4, 12)
		local n = 0
		for _, e in events do
			if e.type == "CharSkill" then
				n += 1
				T.expect(Catalog.Cues[e.cue] ~= nil, "카탈로그에 없는 큐: " .. tostring(e.cue))
			end
		end
		T.expect(n >= 6)
	end)
end)

-- ── 클라이언트 순수 로직 ────────────────────────────────────
T.describe("TIMEBOMB 클라이언트 순수 로직", function()
	T.it("InputState: 스킬 2 는 누름=Press, 뗌=Release 를 서버로 보낸다", function()
		local input = InputState.new()
		input:setCharacter("TIMEBOMB", false, false, false)
		local d = input:press("Two", 0)
		T.expect(d[1] and d[1].remote == "Skill" and d[1].slot == 2 and d[1].phase == "Press")
		local u = input:release("Two")
		T.expect(u[1] and u[1].phase == "Release")
	end)
	T.it("EffectsModel: BombSpawn → 폭탄 큐, BombLand → 고정, BombExplode → 폭발 + 제거", function()
		local sp = EffectsModel.translate({ type = "BombSpawn", bombId = "bm1", ownerId = 1, pos = v(0, 1.5, 0), vel = v(0, 0, 45), gravity = 35, time = 10 }, 1)
		T.expect(sp[1].cue == "bomb.projectile" and sp[1].speed == 45 and sp[1].gravity == 35 and sp[1].mine)
		local land = EffectsModel.translate({ type = "BombLand", bombId = "bm1", ownerId = 1, pos = v(0, 0.4, 11), time = 10.3 }, 1)
		T.expect(land[1].cue == "ball.update" and land[1].mode == "Landed")
		T.expect(EffectsModel.ballPosition(land[1], 12, nil).Z == 11)
		local ex = EffectsModel.translate({ type = "BombExplode", bombId = "bm1", ownerId = 2, pos = v(0, 0.4, 11), radius = 6, stage = 2, time = 11 }, 1)
		T.expect(ex[1].cue == "bomb.explosion" and ex[1].radius == 6 and not ex[1].mine and ex[2].cue == "projectile.end")
		local en = EffectsModel.translate({ type = "BombEnd", bombId = "bm1", reason = "Expired", pos = v(0, 0, 0) }, 1)
		T.expect(en[1].cue == "projectile.end")
	end)
	T.it("HUD: 최대 체력 105, Remote Bomb 충전·설치 표시, 충전 0 이면 복구 시간", function()
		local c = setup({ a = "TIMEBOMB" })
		place(c, "a", 0)
		local m = HudModel.build(c:getHudSnapshot("a", 0.5), 0.5)
		T.expectEqual(m.healthText, "105 / 105")
		T.expect(m.skills[2].implemented and m.skills[2].ready and string.find(m.skills[2].label, "1/2", 1, true) ~= nil)
		place(c, "a", 1)
		local m2 = HudModel.build(c:getHudSnapshot("a", 1.5), 1.5)
		T.expect(not m2.skills[2].ready and string.find(m2.skills[2].label, "0/2", 1, true) ~= nil)
		T.expect(m.skills[1].name == "Cluster Bomb" and m.skills[3].name == "Blast Jump")
		T.expect(m.passive.id == "ChainReaction")
	end)
	T.it("무기·조준선 카탈로그 등록", function()
		T.expect(Catalog.Weapons.TIMEBOMB ~= nil)
		T.expect(Env.client("Logic/Crosshairs").get("TIMEBOMB").style == "Cross")
	end)
end)

return true
