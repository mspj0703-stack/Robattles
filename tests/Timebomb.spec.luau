-- ── 폭발 감쇠 프로필(DamageService) ─────────────────────────
T.describe("폭발 감쇠 프로필 — TIMEBOMB 전용 100% → 60% → 30% (0.3초)", function()
	local function dsetup()
		local d = Damage.new(Config)
		d:register("T", 1000); d:register("U", 1000); d:register("A", 100); d:register("C", 100)
		return d
	end
	local function boom(d, atk, tgt, id, t, kind, profile)
		return d:applyDamage({ attackerId = atk, targetId = tgt, attackId = id, amount = 40, kind = kind or "Explosion", explosionProfile = profile or "Timebomb" }, t)
	end
	T.it("0.3초 안의 연속 폭발: 40 / 24 / 12 / 12", function()
		local d = dsetup()
		local got = {}
		for i, t in { 0, 0.1, 0.2, 0.25 } do table.insert(got, boom(d, "A", "T", "e" .. i, t).dealt) end
		T.expect(near(got[1], 40) and near(got[2], 24) and near(got[3], 12) and near(got[4], 12))
	end)
	T.it("0.3초가 지나면 초기화", function()
		local d = dsetup()
		boom(d, "A", "T", "e1", 0)
		boom(d, "A", "T", "e2", 0.1)
		T.expect(near(boom(d, "A", "T", "e3", 0.5).dealt, 40))
	end)
	T.it("공격자별로 독립: 다른 플레이어의 폭발은 같은 감쇠 카운터를 쓰지 않는다", function()
		local d = dsetup()
		boom(d, "A", "T", "a1", 0)
		boom(d, "A", "T", "a2", 0.05)
		T.expect(near(boom(d, "C", "T", "c1", 0.1).dealt, 40))
		T.expect(near(boom(d, "C", "T", "c2", 0.12).dealt, 24))
	end)
	T.it("피격자별로 독립", function()
		local d = dsetup()
		boom(d, "A", "T", "a1", 0)
		T.expect(near(boom(d, "A", "U", "a2", 0.05).dealt, 40))
	end)
	T.it("다른 프로필(기존 A07: PAINTBALL 폭발 등)과 카운터를 공유하지 않고 그 값은 그대로(40/20/10)", function()
		local d = dsetup()
		boom(d, "A", "T", "t1", 0)
		boom(d, "A", "T", "t2", 0.05)
		local plain = {}
		for i, t in { 0.1, 0.2, 0.3 } do
			table.insert(plain, d:applyDamage({ attackerId = "A", targetId = "T", attackId = "p" .. i, amount = 40, kind = "Explosion" }, t).dealt)
		end
		T.expect(near(plain[1], 40) and near(plain[2], 20) and near(plain[3], 10))
	end)
	T.it("폭발이 아닌 종류(빔·직접·투사체 다단 히트)에는 감쇠가 적용되지 않는다", function()
		local d = dsetup()
		for _, kind in { "Beam", "Direct", "Projectile", "Melee" } do
			for i = 1, 5 do
				T.expect(near(boom(d, "A", "T", kind .. i, i * 0.01, kind).dealt, 40), kind)
			end
		end
	end)
	T.it("PAINTBALL Color Break·SWORD 다단 히트는 감쇠 영향 없음(빔 kind)", function()
		local d = dsetup()
		local sum = 0
		for i = 1, 10 do sum += d:applyDamage({ attackerId = "A", targetId = "T", attackId = "cb" .. i, amount = 6, kind = "Beam", explosionProfile = "Timebomb" }, i * 0.01).dealt end
		T.expect(near(sum, 60))
	end)
end)

-- ── LMB Timed Bomb ──────────────────────────────────────────
T.describe("TIMEBOMB LMB — Timed Bomb (20, 약 1초 뒤 폭발, 간격 약 1.2초)", function()
	T.it("던진 뒤 1.0초에 폭발해 착지 지점 근처 적에게 20, 그 전에는 피해 없음", function()
		local c, core, pos, events = setup({ a = "TIMEBOMB", b = "SWORD" })
		pos.b = v(0, 1.5, 12)
		local ok, info = c:handleAttack("a", prim(), 0)
		T.expect(ok and near(info.explodeAt, 1.0))
		run(c, 0, 0.95)
		T.expectEqual(lost(core, "b"), 0)
		run(c, 0.95, 1.1)
		T.expectEqual(lost(core, "b"), 20)
		local ex = ofKind(events, "BombExplode")
		T.expect(#ex == 1 and near(ex[1].time, 1.0) and ex[1].stage == 1 and ex[1].kind == "Timed")
	end)
	T.it("실제 폭발 위치로 판정: 착지 지점에서 먼 적은 맞지 않는다(조준한 곳이 아님)", function()
		local c, core, pos = setup({ a = "TIMEBOMB", b = "SWORD", d = "SWORD" })
		pos.b = v(0, 1.5, 60)
		pos.d = v(40, 1.5, 0)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 1.5)
		T.expectEqual(lost(core, "b"), 0)
		T.expectEqual(lost(core, "d"), 0)
	end)
	T.it("자기 폭발에 체력 피해 없음(폭발 한가운데에 서 있어도)", function()
		local c, core, pos = setup({ a = "TIMEBOMB" })
		c:handleAttack("a", prim(v(0, -1, 0.001)), 0)
		run(c, 0, 1.5)
		T.expectEqual(lost(core, "a"), 0)
	end)
	T.it("벽 뒤의 적은 폭발에 맞지 않는다(차폐)", function()
		local wall = { point = v(0, 0, 12), normal = v(0, 0, -1) }
		local c, core, pos = setup({ a = "TIMEBOMB", b = "SWORD" }, { planes = { floor, wall } })
		pos.b = v(0, 1.5, 14)
		c:handleAttack("a", prim(), 0)
		run(c, 0, 1.5)
		T.expectEqual(lost(core, "b"), 0)
	end)
	T.it("발사 간격 1.2초: 연타 거부, 폭탄 추가 없음", function()
		local c = setup({ a = "TIMEBOMB" })
		T.expect((c:handleAttack("a", prim(), 0)))
		for i = 1, 10 do T.expect(not (c:handleAttack("a", prim(), 0.1 * i))) end
		T.expectEqual(#bombs(c, "a"), 1)
		T.expect((c:handleAttack("a", prim(), 1.2)))
	end)
	T.it("부활 보호: 거부는 유지, 던지기 성공 시 해제 / 사망 중 거부", function()
		local c, core = setup({ a = "TIMEBOMB", k = "SWORD" })
		c:respawn("a", 0)
		T.expect((c:handleAttack("a", prim(), 0.1)))
		T.expect(not c:isProtected("a", 0.2))
		local c2 = setup({ a = "TIMEBOMB" })
		c2:respawn("a", 0)
		c2:handleAttack("a", prim(), 0.1)
		c2:handleAttack("a", prim(), 0.2) -- 쿨타임 거부
		local c3, core3 = setup({ a = "TIMEBOMB", k = "SWORD" })
		core3.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "x", amount = 500 }, 0)
		T.expect(not (c3:handleAttack("a", prim(), 0.1)))
		T.expectEqual(#bombs(c3, "a"), 0)
	end)
	T.it("던진 폭탄은 던진 사람이 죽어도 폭발하고 피해는 소유자에게 귀속(Timed 는 설치물이 아님)", function()
		local c, core, pos, _, _, dmg = setup({ a = "TIMEBOMB", b = "SWORD", k = "SWORD" })
		pos.b = v(0, 1.5, 12)
		c:handleAttack("a", prim(), 0)
		core.damage:applyDamage({ attackerId = "k", targetId = "a", attackId = "kill", amount = 500 }, 0.3)
		run(c, 0.3, 1.5)
		T.expectEqual(lost(core, "b"), 20)
		local found = false
		for _, e in dmg do if e.targetId == "b" and e.attackerId == "a" then found = true end end
		T.expect(found)
	end)
end)

