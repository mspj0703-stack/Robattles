--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local Config = Env.shared("Config")

T.describe("Config: 확정 규칙", function()
	T.it("이동 속도 17/23, 1단 점프", function()
		T.expectEqual(Config.Movement.WalkSpeed, 17)
		T.expectEqual(Config.Movement.RunSpeed, 23)
		T.expectEqual(Config.Movement.JumpCount, 1)
	end)
	T.it("회피 2회·충전 5초·무적 0.15초·공중 허용", function()
		T.expectEqual(Config.Dodge.MaxCharges, 2)
		T.expectEqual(Config.Dodge.RechargeSeconds, 5)
		T.expectEqual(Config.Dodge.InvulnSeconds, 0.15)
		T.expect(Config.Dodge.AllowAirborne == true)
	end)
	T.it("키 설정: Ctrl 달리기 / Shift 회피 / F 궁극기", function()
		T.expectEqual(Config.Input.RunToggleKey, "LeftControl")
		T.expectEqual(Config.Input.DodgeKey, "LeftShift")
		T.expectEqual(Config.Input.UltimateKey, "F")
	end)
	T.it("피격 무적 없음·기본 공격 경직 없음·원거리 조준 보정 없음", function()
		T.expect(Config.Combat.HitInvulnerability == false)
		T.expect(Config.Combat.BasicAttackStagger == false)
		T.expect(Config.Camera.RangedAimAssist == false)
	end)
	T.it("궁극기 게이지 0~100, 자발적 취소 불가", function()
		T.expectEqual(Config.Ultimate.Max, 100)
		T.expect(Config.Ultimate.CancelableByUser == false)
	end)
	T.it("카메라 초기 모드와 전환키는 설정값으로 존재", function()
		T.expect(Config.Camera.InitialMode == "Free" or Config.Camera.InitialMode == "Locked")
		T.expect(type(Config.Camera.ToggleKey) == "string" and #Config.Camera.ToggleKey > 0)
	end)
	T.it("12인 매치", function()
		T.expectEqual(Config.Match.MaxPlayers, 12)
	end)
end)

return true
