--!nonstrict
local T=require(script.Parent.TestRunner)
local Env=require(script.Parent.Env)
local H=require(script.Parent.Helpers)
local Core=Env.server("CombatCore")
local Projectiles=Env.server("ProjectileService")
local Controller=Env.server("CharacterController")
local Scheduler=Env.server("RespawnScheduler")
local Session=Env.server("MatchSession")
local Gate=Env.server("RemoteGate")
local Router=Env.server("ServerRouter")
local SpawnGate=Env.server("CharacterSpawnGate")
local Characters=Env.shared("Data/Characters")
local Templates=Env.shared("Data/ProjectileTemplates")
local Config=Env.shared("Config")
local v=H.v
local function setup()
	local core=Core.new();local positions={};local world=H.fakeWorld({})
	local function targets() local out={};for id,pos in positions do table.insert(out,{id=id,pos=pos,radius=2.5,alive=core.damage:isAlive(id)}) end;return out end
	local ps=Projectiles.new({damage=core.damage,targets=targets,world=world})
	local c=Controller.new({core=core,projectiles=ps,targets=targets,world=world,swordPhase2=true,allowMockUltimate=true,
		getPose=function(id) if positions[id] then return {pos=positions[id],forward=v(0,0,1),airborne=false} end end})
	local scheduler=Scheduler.new();local s=Session.new({core=core,controller=c,projectiles=ps,scheduler=scheduler})
	local gate=Gate.new({cooldown=core.cooldown,selectionAllowed=function(id) return s.flow.players[id]~=nil,"not_registered" end,
		getState=function(id) local p=s.flow.players[id];if not p or not p.ready then return nil end;return {alive=core.damage:isAlive(id),pos=positions[id],serverTime=100,character=Characters[c:getCharacterId(id)]} end})
	local router=Router.new({gate=gate,controller=c,match=s})
	local function add(id,ch)
		positions[id]=v(0,0,id=="b" and 4 or 0);c:addPlayer(id,ch or "SWORD");s:register(id,id)
	end
	local function spawn(id,t)
		s:tick(t);local due=s:due(t);T.expect(table.find(due,id)~=nil,"expected due "..id)
		local ticket=s:captureLoad(id);T.expect(s:spawned(id,ticket,t));scheduler:finishCall(id,ticket.attempt,true,t);return ticket
	end
	return s,core,c,ps,scheduler,add,spawn,router,positions
end
local function active()
	local s,core,c,ps,q,add,spawn,router,pos=setup()
	add("a");s:select("a","SWORD",0);spawn("a",0)
	add("b");s:select("b","SWORD",0);spawn("b",0)
	s:tick(0);s:tick(5);T.expectEqual(s.flow.phase,"ACTIVE")
	return s,core,c,ps,q,add,spawn,router,pos
end
T.describe("MatchSession real combat service integration",function()
	T.it("no initial spawn before explicit validated selection",function()
		local s,core,c,ps,q,add,spawn,router=setup();add("a");s:tick(100);T.expectEqual(#s:due(100),0)
		T.expect(not router:dispatch("a","Attack",{action="Primary",aimOrigin=v(0,0,0),aimDirection=v(0,0,1),clientTime=100},100))
		T.expect(router:dispatch("a","SelectCharacter",{characterId="PAINTBALL"},100));spawn("a",100);T.expectEqual(c:getCharacterId("a"),"PAINTBALL")
	end)
	T.it("selection still enforces schema and registration without avatar",function()
		local s,_,_,_,_,add,_,router=setup();add("a")
		T.expect(not router:dispatch("a","SelectCharacter",{characterId="NOT_A_CHARACTER"},0)) -- SLINGSHOT 은 최신 전투에서 지원 캐릭터
		T.expect(not router:dispatch("ghost","SelectCharacter",{characterId="SWORD"},0))
		T.expect(not s.flow.players.a.selected)
	end)
	T.it("practice swings animate but damage, KO, deaths and all charge stay zero",function()
		local s,core,c,ps,q,add,spawn=setup();add("a");add("b")
		s:select("a","SWORD",0);spawn("a",0);s:select("b","SWORD",0);spawn("b",0)
		local hits=0;core.damage:onDamaged(function() hits+=1 end)
		local ok=c:handleAttack("a",{action="Primary",aimDirection=v(0,0,1)},2);T.expect(ok)
		core.ultimate:addDamage("a",100);core.ultimate:addKill("a");c:update(2,2)
		T.expectEqual(hits,0);T.expectEqual(core.damage:getHealth("b"),Characters.SWORD.maxHealth);T.expectEqual(core.ultimate:getGauge("a"),0)
		for _,r in s.flow:standings() do T.expectEqual(r.kills,0);T.expectEqual(r.deaths,0) end
	end)
	T.it("practice policy runs before parry and counter side effects",function()
		local s,core,c,ps,q,add,spawn=setup();add("a");s:select("a","SWORD",0);spawn("a",0)
		local sideEffect=false;core.damage:addBlocker(function() sideEffect=true end)
		core.damage:applyDamage({attackerId="a",targetId="a",attackId="x",amount=10,allowSelf=true},3)
		T.expect(not sideEffect)
	end)
	T.it("practice ultimate may run without changing gauge; placeholder skills remain unchanged",function()
		local s,core,c,ps,q,add,spawn=setup();add("a");s:select("a","SWORD",0);spawn("a",0)
		T.expect(c:handleUltimate("a",{},3));T.expectEqual(core.ultimate:getGauge("a"),0)
		T.expect(select(2,c:handleSkill("a",{slot=1},3))~="skill_not_implemented") -- 최신 전투에는 placeholder 스킬이 없다
	end)
	T.it("practice fall recovers physical player without emitting scored kill",function()
		local s,core,c,ps,q,add,spawn=setup();add("a");s:select("a","SWORD",0);spawn("a",0)
		local n=0;core.damage:onKilled(function() n+=1 end)
		T.expect(s:environmentDeath("a",3));T.expectEqual(n,0);T.expectEqual(s.flow.players.a.respawnAt,7)
		s:tick(6.99);T.expectEqual(#s:due(6.99),0);spawn("a",7);T.expect(s.flow.players.a.alive)
	end)
	T.it("active kills score once and preserve combat damage/ultimate rules",function()
		local s,core=active();local hit=core.damage:applyDamage({attackerId="a",targetId="b",attackId="kill",amount=200},8)
		T.expect(hit.killed);T.expectEqual(s.flow:snapshot("a",8).player.kills,1);T.expectEqual(s.flow:snapshot("b",8).player.deaths,1)
		T.expectEqual(core.ultimate:getGauge("a"),Config.Ultimate.GainPerKill+Characters.SWORD.maxHealth*Config.Ultimate.GainPerDamage);T.expectEqual(s.flow.players.b.respawnAt,12) -- 킬 + 실제 가한 피해(HP 110)
	end)
	T.it("four-second respawn and two-second shield remain server-owned",function()
		local s,core,c,ps,q,add,spawn=active();core.damage:forceKill("b",8)
		s:tick(11.999);T.expectEqual(#s:due(11.999),0);spawn("b",12)
		T.expect(c:isProtected("b",13.99));T.expect(not c:isProtected("b",14));T.expectEqual(s.flow:participantCount(),2)
	end)
	T.it("character selection while dead applies next respawn and carry cap remains 40",function()
		local s,core,c,ps,q,add,spawn,router=active();core.ultimate:addKill("b");core.ultimate:addKill("b");core.ultimate:addKill("b")
		core.damage:forceKill("b",8)
		T.expect(router:dispatch("b","SelectCharacter",{characterId="PAINTBALL"},9));T.expectEqual(c:getCharacterId("b"),"SWORD")
		spawn("b",12);T.expectEqual(c:getCharacterId("b"),"PAINTBALL");T.expectEqual(core.ultimate:getGauge("b"),40)
	end)
	T.it("round start resets practice combo, reload, HP and gauge",function()
		local s,core,c,ps,q,add,spawn=setup();add("a","PAINTBALL");s:select("a","PAINTBALL",0);spawn("a",0)
		c:handleAttack("a",{action="Primary",aimDirection=v(0,0,1)},1);c:handleReload("a",1.1)
		add("b");s:select("b","SWORD",2);spawn("b",2);s:tick(2);s:tick(7)
		T.expectEqual(c:getAmmo("a"),Characters.PAINTBALL.ammo.magazine);T.expect(not c:isReloading("a",7));T.expectEqual(core.ultimate:getGauge("a"),0);T.expectEqual(core.damage:getHealth("a"),Characters.PAINTBALL.maxHealth)
	end)
	T.it("round boundary cancels placed bombs without detonation",function()
		local s,core,c,ps=active();local ended=0;ps:onEvent(function(e) if e.type=="Explosion" then ended+=1 end end)
		local def=H.clone(Templates.Placed)
		local id,err=ps:spawn({ownerId="a",def=def,origin=v(0,0,0),direction=v(0,0,1)},420)
		T.expect(id,err);T.expectEqual(ps:getActiveCount(),1);s:tick(425);T.expectEqual(ps:getActiveCount(),0);T.expectEqual(ended,0);T.expect(not ps:trigger(id,426))
	end)
	T.it("late in-flight spawn after round end cannot join or overlap a new load",function()
		local s,core,c,ps,q,add=active();add("c");s:select("c","SWORD",424);s:tick(424);local due=s:due(424);T.expect(table.find(due,"c"))
		local token=s:captureLoad("c");s:tick(425);T.expect(not s:validLoad(token));T.expect(q:isInFlight("c"));T.expectEqual(#s:due(425),0)
		T.expect(not s:spawned("c",token,426));q:finishCall("c",token.attempt,true,426);T.expect(not q:isInFlight("c"))
		s:tick(437);s:tick(437.1);local again=s:due(437.1);T.expect(table.find(again,"c"));T.expect(q:getAttempt("c")~=token.attempt)
	end)
	T.it("results prevent new skills, damage and timed charge",function()
		local s,core,c,ps,q,add,spawn,router=active();s:tick(425)
		for _,name in {"Dodge","Reload","Ultimate","SetRun"} do
			local payload=name=="Dodge" and {direction=v(0,0,1)} or name=="SetRun" and {enabled=true} or {}
			T.expect(not router:dispatch("a",name,payload,426))
		end
		local before=core.damage:getHealth("b");T.expect(not core.damage:applyDamage({attackerId="a",targetId="b",attackId="late",amount=100},426).applied)
		local gauge=core.ultimate:getGauge("a");c:update(426,1);T.expectEqual(core.ultimate:getGauge("a"),gauge);T.expectEqual(core.damage:getHealth("b"),before)
	end)
	T.it("join before grace expiry rescues match; late join does not",function()
		local s,core,c,ps,q,add,spawn=active();s:remove("b",10);c:removePlayer("b",10);add("c");s:select("c","SWORD",29);spawn("c",29)
		s:tick(30);T.expectEqual(s.flow.phase,"ACTIVE");T.expectEqual(s.flow.lowPopulationEndsAt,nil)
		local a,_,_,_,sched,add2=active();a:remove("b",10);add2("c");a:select("c","SWORD",29);a:tick(29);a:due(29);local ticket=a:captureLoad("c")
		T.expect(not a:spawned("c",ticket,30));T.expectEqual(a.flow.phase,"RESULTS")
	end)
	T.it("old connection completion ignored after leave and rejoin",function()
		local s,core,c,ps,q,add=setup();add("a");s:select("a","SWORD",0);s:tick(0);s:due(0);local old=s:captureLoad("a")
		s:remove("a",1);c:removePlayer("a",1);add("a");s:select("a","PAINTBALL",2);s:tick(2);s:due(2);local fresh=s:captureLoad("a")
		T.expect(not s:validLoad(old));T.expect(s:validLoad(fresh));T.expect(not q:finishCall("a",old.attempt,true,3));T.expect(q:isInFlight("a"))
	end)
	T.it("spawn gate epochs cannot collide across reconnect",function()
		local gate=SpawnGate.new();local a,b={},{};local old=gate:begin("p",a);gate:remove("p");local fresh=gate:begin("p",b)
		T.expect(fresh~=old);T.expect(gate:isStale("p",old));T.expect(not gate:commit("p",old,a));T.expect(gate:commit("p",fresh,b))
	end)
	T.it("server snapshot exposes match/rank/death/selection without replacing character UI data",function()
		local s,core,c=active();core.damage:forceKill("b",8)
		local raw=c:getHudSnapshot("b",9);raw.ui={version=1,characterState={combo=2}}
		local snap=s:augmentSnapshot("b",raw,9);T.expectEqual(snap.match.phase,"ACTIVE");T.expectEqual(snap.match.player.respawnRemaining,3)
		T.expect(snap.match.player.characterSelectionAllowed);T.expectEqual(snap.ui.characterState.combo,2);T.expectEqual(snap.ui.match.phase,"Playing")
	end)
	T.it("results allow selection but defer first physical spawn until next waiting",function()
		local s,core,c,ps,q,add,spawn,router=active();s:tick(425);add("c")
		T.expect(router:dispatch("c","SelectCharacter",{characterId="PAINTBALL"},426));s:tick(426);T.expectEqual(#s:due(426),0)
		s:tick(437);T.expect(table.find(s:due(437),"c")~=nil)
	end)
	T.it("stale match cast guard cannot spawn effects in next round",function()
		local s,core=active();local n=0;local cb=s.scope:guard(s.scope:capture("a"),function() n+=1 end)
		s:tick(425);cb();s:tick(437);s:tick(442);cb();T.expectEqual(n,0)
	end)
	T.it("throwing ultimate cleanup cannot strand match transition",function()
		local s,core,c=active();core.ultimate:addKill("a");core.ultimate:addKill("a");core.ultimate:addKill("a");core.ultimate:addKill("a");core.ultimate:addKill("a")
		T.expect(c:handleUltimate("a",{},10));core.ultimate:attach("a",function() error("test cleanup") end)
		local ended=false;core.ultimate:attach("a",function() ended=true end);s:tick(425)
		T.expect(ended);T.expectEqual(s.flow.phase,"RESULTS");T.expect(not core.ultimate:isActive("a"))
	end)
	T.it("exhausted spawn attempts do not restart every Heartbeat; selection explicitly retries",function()
		local s,core,c,ps,q,add=setup();add("a");s:select("a","SWORD",0)
		for i=0,4 do s:tick(i);T.expectEqual(#s:due(i),1);q:finishCall("a",q:getAttempt("a"),false,i) end
		T.expect(q:isExhausted("a"));for i=5,100 do s:tick(i);T.expectEqual(#s:due(i),0) end
		T.expect(s:select("a","SWORD",101));s:tick(101);T.expectEqual(#s:due(101),1)
	end)
	T.it("pending dead character selection survives a round boundary until physical respawn",function()
		local s,core,c,ps,q,add,spawn=active();add("c");s:select("c","SWORD",8);spawn("c",8)
		core.damage:forceKill("b",424);s:select("b","PAINTBALL",424.1);s:tick(425);s:tick(437);s:tick(442)
		T.expectEqual(c:getCharacterId("b"),"SWORD");T.expectEqual(core.ultimate:getPendingCharacter("b"),"PAINTBALL")
		spawn("b",442);T.expectEqual(c:getCharacterId("b"),"PAINTBALL")
	end)
	T.it("lethal damage credits once even with synchronous external death reflection",function()
		local s,core=active();core.damage:onDamaged(function(e) if e.killed then s:environmentDeath(e.targetId,e.now) end end)
		core.damage:applyDamage({attackerId="a",targetId="b",attackId="sync",amount=200},8)
		T.expectEqual(s.flow:snapshot("a",8).player.kills,1);T.expectEqual(s.flow:snapshot("b",8).player.deaths,1)
	end)

	T.it("accepted spawn ticket is single-use; later unrequested avatar cannot reuse it",function()
		local s,core,c,ps,q,add,spawn=setup();add("a");s:select("a","SWORD",0);local ticket=spawn("a",0)
		T.expect(ticket.accepted);T.expect(not s:validLoad(ticket));T.expect(not s:spawned("a",ticket,1))
	end)

	T.it("practice physical death cancels ultimate attachments without scored death",function()
		local s,core,c,ps,q,add,spawn=setup();add("a");s:select("a","SWORD",0);spawn("a",0)
		T.expect(c:handleUltimate("a",{},1));local stopped=false;core.ultimate:attach("a",function() stopped=true end)
		s:environmentDeath("a",2);T.expect(stopped);T.expect(not core.ultimate:isActive("a"));T.expectEqual(s.flow:snapshot("a",2).player.deaths,0)
	end)

end)
return true
