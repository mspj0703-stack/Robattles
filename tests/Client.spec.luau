--!nonstrict
local T = require(script.Parent.TestRunner)
local Env = require(script.Parent.Env)
local Config = Env.shared("Config")
local Keybinds = Env.shared("Keybinds")
local Vec = Env.shared("Vec")
local Characters = Env.shared("Data/Characters")
local InputState = Env.client("Logic/InputState")
local CameraModel = Env.client("Logic/CameraModel")
local AimAssist = Env.client("Logic/AimAssist")
local MovementModel = Env.client("Logic/MovementModel")
local HudModel = Env.client("Logic/HudModel")
local FeedbackModel = Env.client("Logic/FeedbackModel")
local Crosshairs = Env.client("Logic/Crosshairs")
local KeybindSettings = Env.client("Logic/KeybindSettings")
local Core = Env.server("CombatCore")
local Controller = Env.server("CharacterController")
local ProjectileService = Env.server("ProjectileService")
local RemoteSpec = Env.shared("RemoteSpec")
local H = require(script.Parent.Helpers)

local function remotes(cmds)
	local r = {}
	for _, c in cmds do
		if c.remote then table.insert(r, c.remote) end
	end
	return r
end

T.describe("입력 매핑 (WASD 제외 액션 키)", function()
	T.it("LMB/RMB는 Attack(Primary/Secondary)로 매핑되고 서버 스키마를 통과", function()
		local s = InputState.new()
		local a = s:press("MouseButton1", 0)[1]
		local b = s:press("MouseButton2", 0)[1]
		T.expect(a.remote == "Attack" and a.action == "Primary")
		T.expect(b.remote == "Attack" and b.action == "Secondary")
	end)
	T.it("숫자 1·2·3 → Skill 슬롯, Shift → Dodge, F → Ultimate", function()
		local s = InputState.new()
		T.expectEqual(s:press("One", 0)[1].slot, 1)
		T.expectEqual(s:press("Two", 0)[1].slot, 2)
		T.expectEqual(s:press("Three", 0)[1].slot, 3)
		T.expect(s:press("LeftShift", 0)[1].remote == "Dodge")
		T.expect(s:press("F", 0)[1].remote == "Ultimate")
	end)
	T.it("R은 탄약 캐릭터에서만 Reload 전송", function()
		local s = InputState.new()
		s:setCharacter("SWORD", false)
		T.expectEqual(#s:press("R", 0), 0)
		s:setCharacter("PAINTBALL", true)
		T.expect(s:press("R", 0)[1].remote == "Reload")
	end)
	T.it("정의되지 않은 키는 무시", function()
		local s = InputState.new()
		T.expectEqual(#s:press("Q", 0), 0)
		T.expectEqual(#s:press("W", 0), 0)
	end)
	T.it("Tab 홀드: 누르면 표시, 떼면 숨김, releaseAll(포커스 상실)도 숨김", function()
		local s = InputState.new()
		T.expect(s:press("Tab", 0)[1].visible == true)
		T.expect(s:release("Tab")[1].visible == false)
		s:press("Tab", 1)
		T.expect(s:releaseAll()[1].visible == false)
		T.expect(not s.scoreboardHeld)
	end)
	T.it("UI(설정창) 열림 중에는 전투 입력 차단", function()
		local s = InputState.new()
		s:setUiBlocking(true)
		T.expectEqual(#s:press("MouseButton1", 0), 0)
		T.expectEqual(#s:press("LeftShift", 0), 0)
	end)
	T.it("이동 벡터는 대각선 정규화", function()
		local s = InputState.new()
		s:press("W", 0) s:press("D", 0)
		local m = s:moveVector()
		T.expect(math.abs(m.x * m.x + m.z * m.z - 1) < 1e-9)
		s:release("W") s:release("D")
		T.expectEqual(s:moveVector().x, 0)
	end)
end)

T.describe("Ctrl 토글 달리기", function()
	T.it("Ctrl을 누를 때마다 토글, SetRun 전송", function()
		local s = InputState.new()
		local c1 = s:press("LeftControl", 0)[1]
		T.expect(c1.remote == "SetRun" and c1.enabled == true and s.running)
		s:release("LeftControl")
		local c2 = s:press("LeftControl", 1)[1]
		T.expect(c2.enabled == false and not s.running)
	end)
	T.it("누르고 있는 동안만이 아니라 뗀 후에도 유지(홀드 아님)", function()
		local s = InputState.new()
		s:press("LeftControl", 0)
		s:release("LeftControl")
		T.expect(s.running)
	end)
	T.it("공격하면 달리기 해제(클라이언트 낙관 반영)", function()
		local s = InputState.new()
		s:press("LeftControl", 0)
		s:press("MouseButton1", 0.1)
		T.expect(not s.running)
	end)
	T.it("서버-클라이언트 불일치: 서버 값이 우선(유예 시간 이후)", function()
		local s = InputState.new()
		s:press("LeftControl", 0)
		-- 서버가 아직 반영 전(false)인 스냅샷 → 유예 중이라 클라이언트 요청 유지
		T.expect(s:reconcileRun(false, 0.3) == true)
		-- 유예 초과 후에도 서버가 false → 서버 값으로 되돌림
		T.expect(s:reconcileRun(false, 1.5) == false)
		T.expect(not s.running)
	end)
	T.it("서버가 달리기를 해제(공격/기절)하면 클라이언트도 해제", function()
		local s = InputState.new()
		s:press("LeftControl", 0)
		s:reconcileRun(true, 0.2) -- 서버 반영 확인
		T.expect(s:reconcileRun(false, 5) == false)
	end)
	T.it("서버 이동속도 스냅샷은 비정상 값을 안전 범위로 제한", function()
		T.expectEqual(MovementModel.clampSpeed(17), 17)
		T.expectEqual(MovementModel.clampSpeed(9999), 23)
		T.expectEqual(MovementModel.clampSpeed(-5), 0)
		T.expectEqual(MovementModel.clampSpeed(0 / 0), 17)
		T.expectEqual(MovementModel.clampSpeed("fast"), 17)
	end)
end)

T.describe("카메라 시점 전환 입력과 재지정", function()
	T.it("기본 시작은 Locked(마우스 고정 전투 시점)", function()
		T.expectEqual(CameraModel.new().mode, "Locked")
		T.expectEqual(InputState.new().mode, "Locked")
	end)
	T.it("V 키로 Locked ↔ Free 전환", function()
		local s = InputState.new()
		local c = s:press("V", 0)[1]
		T.expect(c.localEffect == "CameraMode" and c.mode == "Free")
		T.expectEqual(s:press("V", 1)[1].mode, "Locked")
	end)
	T.it("전환키를 다른 키로 바꾸면 V는 더 이상 동작하지 않고 새 키가 동작", function()
		local ks = KeybindSettings.new()
		T.expect((ks:set("CameraToggle", "G")))
		local s = InputState.new(ks.binds)
		T.expectEqual(#s:press("V", 0), 0)
		T.expectEqual(s:press("G", 0)[1].mode, "Free")
	end)
	T.it("모드별 마우스 동작: Locked=LockCenter, Free=Default(커서 표시)", function()
		local cam = CameraModel.new()
		T.expectEqual(cam:mouseBehavior(false), "LockCenter")
		cam:toggle()
		T.expectEqual(cam:mouseBehavior(false), "Default")
		T.expectEqual(cam:mouseBehavior(true), "LockCurrentPosition")
	end)
	T.it("Free 모드에서 RMB는 회전을 일으키지 않고 항상 보조 공격(입력 충돌 없음)", function()
		local cam = CameraModel.new()
		cam:toggle()
		local s = InputState.new()
		s.mode = "Free"
		local y0 = cam.yaw
		cam:applyMouseDelta(100, 0, false) -- RMB를 누른 상태여도 FreeLook이 아니면 회전 안 함
		T.expectEqual(cam.yaw, y0)
		local c = s:press("MouseButton2", 0)[1]
		T.expect(c.remote == "Attack" and c.action == "Secondary")
		T.expect(not s.freeLookHeld)
	end)
	T.it("Free 모드: FreeLook(MMB) 홀드 중에만 회전", function()
		local cam = CameraModel.new()
		cam:toggle()
		local s = InputState.new()
		s:press("MouseButton3", 0)
		T.expect(s.freeLookHeld)
		cam:applyMouseDelta(40, 0, s.freeLookHeld)
		T.expect(cam.yaw ~= 0)
		s:release("MouseButton3")
		T.expect(not s.freeLookHeld)
	end)
	T.it("Locked 모드는 항상 회전, 피치는 설정 범위로 제한", function()
		local cam = CameraModel.new()
		cam:applyMouseDelta(0, -10000, false)
		T.expectEqual(cam.pitch, Config.Camera.PitchMaxDegrees)
		cam:applyMouseDelta(0, 10000, false)
		T.expectEqual(cam.pitch, Config.Camera.PitchMinDegrees)
	end)
	T.it("비정상 마우스 입력(NaN/무한대)은 무시", function()
		local cam = CameraModel.new()
		local y, p = cam.yaw, cam.pitch
		cam:applyMouseDelta(0 / 0, 5, false)
		cam:applyMouseDelta(math.huge, 5, false)
		T.expectEqual(cam.yaw, y)
		T.expectEqual(cam.pitch, p)
	end)
	T.it("Free 전환은 모드만 바꾼다(설정값 InitialMode와 분리)", function()
		local cam = CameraModel.new()
		cam:toggle()
		T.expectEqual(Config.Camera.InitialMode, "Locked")
		T.expectEqual(cam.mode, "Free")
	end)
end)

T.describe("카메라 벽 충돌", function()
	T.it("장애물이 없으면 설정 거리 유지", function()
		local cam = CameraModel.new()
		local r = cam:compute(Vec.new(0, 5, 0), function() return nil end)
		T.expectEqual(r.distance, Config.Camera.Distance)
	end)
	T.it("벽이 막으면 거리를 줄이고 최소 거리 아래로는 내려가지 않음", function()
		local cam = CameraModel.new()
		local r = cam:compute(Vec.new(0, 5, 0), function() return 0.25 end)
		T.expect(r.distance < Config.Camera.Distance)
		T.expectEqual(r.distance, math.max(Config.Camera.MinDistance, Config.Camera.Distance * 0.25))
		local r2 = cam:compute(Vec.new(0, 5, 0), function() return 0 end)
		T.expectEqual(r2.distance, Config.Camera.MinDistance)
	end)
	T.it("Locked는 어깨 오프셋을 적용하고 Free는 중심 추적", function()
		local cam = CameraModel.new()
		local a = cam:compute(Vec.new(0, 5, 0))
		T.expect(math.abs(a.anchor.X) > 0 or math.abs(a.anchor.Z) > 0)
		cam:toggle()
		local b = cam:compute(Vec.new(0, 5, 0))
		T.expectEqual(b.anchor.X, 0)
	end)
end)

T.describe("조준: 원거리 수동, 근접만 약한 보정", function()
	local origin = Vec.new(0, 1.5, 0)
	local fwd = Vec.new(0, 0, 1)
	T.it("화면 중앙 광선의 도착점을 향해 발사 방향 계산", function()
		local cam = CameraModel.new()
		local c = cam:compute(Vec.new(0, 5, 0))
		local d = cam:aimFrom(origin, c, Vec.new(0, 1.5, 30))
		T.expect(Vec.angleDeg(d, fwd) < 1e-6)
	end)
	T.it("원거리(Projectile/Beam)는 대상이 근처에 있어도 보정하지 않음", function()
		local targets = { { pos = Vec.new(3, 1.5, 6), alive = true } }
		for _, kind in { "Projectile", "Beam", "Hitscan" } do
			local d = AimAssist.adjust(kind, origin, fwd, targets, 30)
			T.expectEqual(d.X, fwd.X)
			T.expectEqual(d.Z, fwd.Z)
		end
	end)
	T.it("근접은 최대 보정각 이내에서만, 범위·사망 대상 제외", function()
		local near = { pos = Vec.new(1, 1.5, 5), alive = true } -- 약 11°
		local d = AimAssist.adjust("Melee", origin, fwd, { near }, 7)
		T.expect(Vec.angleDeg(d, fwd) > 1)
		T.expect(Vec.angleDeg(d, fwd) <= Config.Camera.MeleeAimAssistDegrees + 1e-6)
		local far = { pos = Vec.new(0.2, 1.5, 20), alive = true }
		T.expectEqual(AimAssist.adjust("Melee", origin, fwd, { far }, 7).X, 0)
		local dead = { pos = Vec.new(1, 1.5, 5), alive = false }
		T.expectEqual(AimAssist.adjust("Melee", origin, fwd, { dead }, 7).X, 0)
		local wide = { pos = Vec.new(5, 1.5, 3), alive = true } -- 약 59° → 보정 대상 아님
		T.expectEqual(AimAssist.adjust("Melee", origin, fwd, { wide }, 7).X, 0)
	end)
	T.it("RangedAimAssist 설정은 false로 고정(확정)", function()
		T.expect(Config.Camera.RangedAimAssist == false)
	end)
end)

T.describe("키 설정(재지정)", function()
	T.it("허용된 키로 변경, 이전 키는 해제", function()
		local ks = KeybindSettings.new()
		T.expect((ks:set("Reload", "T")))
		local s = InputState.new(ks.binds)
		s:setCharacter("PAINTBALL", true)
		T.expectEqual(#s:press("R", 0), 0)
		T.expect(s:press("T", 0)[1].remote == "Reload")
	end)
	T.it("이동/점프/취소 예약 키, 중복 키, 알 수 없는 액션, 잘못된 키 이름은 거부하고 기존 값 유지", function()
		local ks = KeybindSettings.new()
		T.expect(not (ks:set("Dodge", "W")))
		T.expect(not (ks:set("Dodge", "F"))) -- Ultimate와 중복
		T.expect(not (ks:set("Nope", "G")))
		T.expect(not (ks:set("Dodge", "L!")))
		T.expect(not (ks:set("Dodge", "")))
		T.expectEqual(ks.binds.Dodge, "LeftShift")
	end)
	T.it("초기화와 저장 데이터 불러오기(잘못된 데이터는 기본값으로 복구)", function()
		local ks = KeybindSettings.new()
		ks:set("CameraToggle", "G")
		ks:reset("CameraToggle")
		T.expectEqual(ks.binds.CameraToggle, "V")
		T.expect(not ks:load({ CameraToggle = "Space" }))
		T.expectEqual(ks.binds.CameraToggle, "V")
		T.expect(ks:load({ CameraToggle = "G" }))
		T.expectEqual(ks.binds.CameraToggle, "G")
	end)
end)

T.describe("회피: 방향·서버 확인 후 이동·공중 회피·충전", function()
	local fwd = Vec.new(0, 0, 1)
	T.it("이동 입력이 있으면 카메라 기준 방향, 없으면 후방", function()
		local look = Vec.new(0, 0, 1)
		local right = Vec.new(-1, 0, 0)
		local d = MovementModel.dodgeDirection({ x = 0, z = 1 }, look, right, fwd)
		T.expect(Vec.angleDeg(d, look) < 1e-6)
		local back = MovementModel.dodgeDirection({ x = 0, z = 0 }, look, right, fwd)
		T.expect(Vec.angleDeg(back, Vec.new(0, 0, -1)) < 1e-6)
		T.expectEqual(back.Y, 0)
	end)
	T.it("회피 이동은 서버가 확인한 이벤트만 수용 (내 ID, 최근, 중복 아님)", function()
		local ev = { type = "Dodge", playerId = 7, time = 10 }
		T.expect(MovementModel.acceptDodgeEvent(ev, 7, 10.1, nil))
		T.expect(not MovementModel.acceptDodgeEvent(ev, 8, 10.1, nil)) -- 남의 이벤트
		T.expect(not MovementModel.acceptDodgeEvent(ev, 7, 12, nil)) -- 오래된 이벤트
		T.expect(not MovementModel.acceptDodgeEvent(ev, 7, 10.1, 10)) -- 중복
		T.expect(not MovementModel.acceptDodgeEvent({ type = "Swing", playerId = 7, time = 10 }, 7, 10.1, nil))
		T.expect(not MovementModel.acceptDodgeEvent("x", 7, 10.1, nil))
	end)
	T.it("회피 이동 속도 = 거리/시간, 지속시간 후 종료", function()
		local v = MovementModel.dodgeVelocity(10, Vec.new(0, 0, 1), 10.1)
		T.expect(math.abs(v.Z - Config.Dodge.Distance / Config.Dodge.Duration) < 1e-9)
		T.expect(MovementModel.dodgeVelocity(10, Vec.new(0, 0, 1), 10 + Config.Dodge.Duration) == nil)
		T.expect(MovementModel.dodgeVelocity(10, Vec.new(0, 0, 1), 9.9) == nil)
	end)
	local function setup()
		local core = Core.new()
		local pos = { p1 = Vec.new(0, 0, 0) }
		local world = H.fakeWorld({})
		local function targets() return { { id = "p1", pos = pos.p1, radius = 2.5, alive = core.damage:isAlive("p1") } } end
		local ps = ProjectileService.new({ damage = core.damage, targets = targets, world = world })
		local c = Controller.new({ core = core, projectiles = ps, targets = targets, world = world,
			getPose = function() return { pos = pos.p1, forward = Vec.new(0, 0, 1), airborne = pos.p1.Y > 5 } end })
		c:addPlayer("p1", "SWORD")
		return c, core, pos
	end
	T.it("공중 회피: 서버가 허용하고 충전 소모", function()
		local c, core, pos = setup()
		pos.p1 = Vec.new(0, 20, 0)
		local ok, info = c:handleDodge("p1", { direction = Vec.new(0, 0, 1) }, 0)
		T.expect(ok and info.invulnUntil > 0)
		T.expectEqual(c:getHudSnapshot("p1", 0.1).dodge.charges, 1)
	end)
	T.it("충전 2회 → 3번째 거부 → 5초 후 1회 충전", function()
		local c = setup()
		local d = Vec.new(0, 0, 1)
		T.expect((c:handleDodge("p1", { direction = d }, 0)))
		T.expect((c:handleDodge("p1", { direction = d }, 0.3)))
		T.expect(not (c:handleDodge("p1", { direction = d }, 0.6)))
		T.expectEqual(c:getHudSnapshot("p1", 0.6).dodge.charges, 0)
		T.expect(not (c:handleDodge("p1", { direction = d }, 4.9)))
		T.expect((c:handleDodge("p1", { direction = d }, 5.1)))
	end)
	T.it("회피 무적 0.15초는 서버가 판정 (클라이언트 주장 불필요)", function()
		local c, core = setup()
		c:handleDodge("p1", { direction = Vec.new(0, 0, 1) }, 0)
		core:addPlayer("e")
		local r1 = core.damage:applyDamage({ attackerId = "e", targetId = "p1", attackId = "a", amount = 10, kind = "Environment" }, 0.1)
		local r2 = core.damage:applyDamage({ attackerId = "e", targetId = "p1", attackId = "b", amount = 10, kind = "Environment" }, 0.2)
		T.expect(not r1.applied)
		T.expect(r2.applied)
	end)
	T.it("클라이언트가 보낸 방향이 비정상(비단위 벡터)이면 서버 스키마가 거부", function()
		T.expect(not (RemoteSpec.validate("Dodge", { direction = { X = 0, Y = 0, Z = 5 } })))
		T.expect(not (RemoteSpec.validate("Dodge", { direction = { X = 0 / 0, Y = 0, Z = 1 } })))
		T.expect((RemoteSpec.validate("Dodge", { direction = { X = 0, Y = 0, Z = 1 } })))
	end)
end)

T.describe("비정상 클라이언트 입력", function()
	T.it("알 수 없는 Attack action·Skill 슬롯·음수 시간·추가 필드·잘못된 타입 모두 거부", function()
		local ok = function(name, p) return (RemoteSpec.validate(name, p)) end
		local o, d = { X = 0, Y = 1, Z = 0 }, { X = 0, Y = 0, Z = 1 }
		T.expect(not ok("Attack", { action = "Tertiary", aimOrigin = o, aimDirection = d, clientTime = 1 }))
		T.expect(not ok("Attack", { action = "Primary", aimOrigin = o, aimDirection = d, clientTime = -1 }))
		T.expect(not ok("Attack", { action = "Primary", aimOrigin = o, aimDirection = d, clientTime = 1, damage = 9999 }))
		T.expect(not ok("Skill", { slot = 4, aimOrigin = o, aimDirection = d, clientTime = 1 }))
		T.expect(not ok("Skill", { slot = "1", aimOrigin = o, aimDirection = d, clientTime = 1 }))
		T.expect(not ok("SetRun", { enabled = "yes" }))
		T.expect(not ok("Reload", "x"))
		T.expect(not ok("Nope", {}))
		T.expect(ok("Attack", { action = "Primary", aimOrigin = o, aimDirection = d, clientTime = 1 }))
	end)
	T.it("연타 입력은 서버 쿨타임이 판정하며 클라이언트 명령 수는 제한 없이 생성되어도 안전", function()
		local s = InputState.new()
		local n = 0
		for i = 1, 200 do n += #s:press("MouseButton1", i * 0.001) end
		T.expectEqual(n, 200) -- 클라이언트는 의사만 전달, 제한은 서버(RemoteGate 레이트 리밋/쿨타임)
	end)
end)

T.describe("HUD 모델과 궁극기 미구현 표시", function()
	local function snap(character)
		local core = Core.new()
		local pos = { p1 = Vec.new(0, 0, 0) }
		local world = H.fakeWorld({})
		local function targets() return { { id = "p1", pos = pos.p1, radius = 2.5, alive = true } } end
		local ps = ProjectileService.new({ damage = core.damage, targets = targets, world = world })
		local c = Controller.new({ core = core, projectiles = ps, targets = targets, world = world,
			getPose = function() return { pos = pos.p1, forward = Vec.new(0, 0, 1) } end })
		c:addPlayer("p1", character)
		return c, core
	end
	T.it("SWORD: 탄약 없음, 보조 공격 쿨타임 표시", function()
		local c = snap("SWORD")
		c:handleAttack("p1", { action = "Secondary", aimDirection = Vec.new(0, 0, 1) }, 0)
		local m = HudModel.build(c:getHudSnapshot("p1", 2), 2)
		T.expect(m.ammo == nil)
		T.expect(math.abs(m.secondary.remaining - 8) < 1e-6)
		T.expect(not m.secondary.ready)
		T.expect(m.healthFrac == 1)
	end)
	T.it("PAINTBALL: 탄약·재장전 진행, 보조 공격 없음", function()
		local c = snap("PAINTBALL")
		c:handleAttack("p1", { action = "Primary", aimDirection = Vec.new(0, 0, 1) }, 0)
		c:handleReload("p1", 0.5)
		local m = HudModel.build(c:getHudSnapshot("p1", 1), 1)
		T.expectEqual(m.ammo.text, "29 / 30")
		T.expect(m.ammo.reloading and m.ammo.reloadFrac > 0)
		T.expect(m.secondary == nil)
	end)
	T.it("궁극기 미구현(PAINTBALL)이면 게이지가 가득이어도 ready=false이고 미구현 문구 표시", function()
		local c, core = snap("PAINTBALL")
		for _ = 1, 5 do core.ultimate:addKill("p1") end
		local m = HudModel.build(c:getHudSnapshot("p1", 0), 0)
		T.expectEqual(m.ultimate.frac, 1)
		T.expect(m.ultimate.ready == false)
		T.expect(m.ultimate.implemented == false)
		T.expect(string.find(m.ultimate.label, "미구현") ~= nil)
	end)
	T.it("숫자 스킬 3칸은 미구현 캐릭터(PAINTBALL)에서 모두 미구현 표시", function()
		local c = snap("PAINTBALL")
		local m = HudModel.build(c:getHudSnapshot("p1", 0), 0)
		for i = 1, 3 do T.expect(not m.skills[i].implemented and m.skills[i].label == "미구현") end
	end)
	T.it("회피 충전 표시 및 비정상 스냅샷은 nil", function()
		local c = snap("SWORD")
		c:handleDodge("p1", { direction = Vec.new(0, 0, 1) }, 0)
		local m = HudModel.build(c:getHudSnapshot("p1", 1), 1)
		T.expectEqual(m.dodge.charges, 1)
		T.expect(math.abs(m.dodge.nextIn - 4) < 1e-6)
		T.expect(HudModel.build(nil, 0) == nil)
		T.expect(HudModel.build("x", 0) == nil)
	end)
	T.it("패링 활성 표시", function()
		local c = snap("SWORD")
		c:handleAttack("p1", { action = "Secondary", aimDirection = Vec.new(0, 0, 1) }, 0)
		T.expect(HudModel.build(c:getHudSnapshot("p1", 0.2), 0.2).parryActive)
		T.expect(not HudModel.build(c:getHudSnapshot("p1", 0.5), 0.5).parryActive)
	end)
end)

T.describe("피드백 이벤트 번역", function()
	T.it("패링 성공: 내가 패링하면 ParrySuccess, 내가 막힌 공격자면 WasParried", function()
		local ev = { type = "ParrySuccess", playerId = "a", attackerId = "b", countered = true }
		local mine = FeedbackModel.translate(ev, "a")
		T.expect(mine[1].kind == "ParrySuccess" and mine[1].mine and mine[1].countered)
		local theirs = FeedbackModel.translate(ev, "b")
		T.expect(theirs[2] and theirs[2].kind == "WasParried")
	end)
	T.it("피해: 피격자에게 DamageTaken, 공격자에게 HitMarker", function()
		local ev = { type = "Damaged", attackerId = "a", targetId = "b", amount = 14 }
		T.expect(FeedbackModel.translate(ev, "b")[1].kind == "DamageTaken")
		T.expect(FeedbackModel.translate(ev, "a")[1].kind == "HitMarker")
		T.expectEqual(#FeedbackModel.translate(ev, "c"), 0)
	end)
	T.it("서버 거부(미구현 궁극기/스킬)는 안내 토스트, 그 외 거부는 조용히 무시", function()
		local t = FeedbackModel.translate({ type = "Rejected", remote = "Ultimate", reason = "ultimate_not_implemented" }, "a")
		T.expect(t[1].kind == "Toast")
		T.expectEqual(#FeedbackModel.translate({ type = "Rejected", remote = "Attack", reason = "on_cooldown" }, "a"), 0)
	end)
	T.it("알 수 없거나 깨진 이벤트는 예외 없이 빈 결과", function()
		T.expectEqual(#FeedbackModel.translate(nil, "a"), 0)
		T.expectEqual(#FeedbackModel.translate("x", "a"), 0)
		T.expectEqual(#FeedbackModel.translate({ type = 5 }, "a"), 0)
		T.expectEqual(#FeedbackModel.translate({ type = "Whatever" }, "a"), 0)
	end)
end)

T.describe("조준선 확장 구조", function()
	T.it("캐릭터별 조준선, 미등록은 기본값, 새 캐릭터 등록 가능, 잘못된 등록 거부", function()
		T.expectEqual(Crosshairs.get("SWORD").style, "Ring")
		T.expectEqual(Crosshairs.get("PAINTBALL").style, "Cross")
		T.expectEqual(Crosshairs.get("UNKNOWN").style, "Dot")
		T.expect(Crosshairs.register("SUPERBALL", { style = "Circle", size = 10 }))
		T.expectEqual(Crosshairs.get("SUPERBALL").style, "Circle")
		T.expect(not Crosshairs.register("X", { size = 1 }))
		T.expect(not Crosshairs.register(5, {}))
	end)
end)
return true
